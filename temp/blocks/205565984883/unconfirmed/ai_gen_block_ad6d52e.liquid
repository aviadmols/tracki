{% doc %}
  @prompt
    create product information section same as broadcast theme
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-info-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-info__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-info__vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_size }}px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-info__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-product-info__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-product-info__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-product-info__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | times: 0.85 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  .ai-product-info__sale-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 4px 12px;
    background-color: {{ block.settings.sale_badge_bg }};
    color: {{ block.settings.sale_badge_color }};
    font-size: 12px;
    border-radius: 4px;
    font-weight: 600;
  }

  .ai-product-info__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .ai-product-info__form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-info__variant-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-product-info__variant-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.label_color }};
    font-weight: 600;
  }

  .ai-product-info__variant-select-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
    font-size: 14px;
    cursor: pointer;
  }

  .ai-product-info__quantity-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-product-info__quantity-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    width: fit-content;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-info__quantity-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border: none;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .ai-product-info__quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  .ai-product-info__quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 44px;
    border: none;
    border-left: 2px solid {{ block.settings.input_border_color }};
    border-right: 2px solid {{ block.settings.input_border_color }};
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-size: 14px;
    -moz-appearance: textfield;
  }

  .ai-product-info__quantity-input-{{ ai_gen_id }}::-webkit-outer-spin-button,
  .ai-product-info__quantity-input-{{ ai_gen_id }}::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .ai-product-info__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-info__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  .ai-product-info__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-info__availability-{{ ai_gen_id }} {
    font-size: 14px;
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: 4px;
  }

  .ai-product-info__availability--in-stock-{{ ai_gen_id }} {
    color: {{ block.settings.in_stock_color }};
    background-color: {{ block.settings.in_stock_bg }};
  }

  .ai-product-info__availability--out-of-stock-{{ ai_gen_id }} {
    color: {{ block.settings.out_of_stock_color }};
    background-color: {{ block.settings.out_of_stock_bg }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-info__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-info__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<product-info-{{ ai_gen_id }} class="ai-product-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-info__container-{{ ai_gen_id }}">
    {% if block.settings.show_vendor and product.vendor != blank %}
      <div class="ai-product-info__vendor-{{ ai_gen_id }}">
        {{ product.vendor }}
      </div>
    {% endif %}

    <h1 class="ai-product-info__title-{{ ai_gen_id }}">
      {{ product.title }}
    </h1>

    <div class="ai-product-info__price-wrapper-{{ ai_gen_id }}">
      <div class="ai-product-info__price-{{ ai_gen_id }}" data-price>
        {{ product.selected_or_first_available_variant.price | money }}
      </div>
      {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
        <div class="ai-product-info__compare-price-{{ ai_gen_id }}" data-compare-price>
          {{ product.selected_or_first_available_variant.compare_at_price | money }}
        </div>
        {% if block.settings.show_sale_badge %}
          <span class="ai-product-info__sale-badge-{{ ai_gen_id }}">
            {{ block.settings.sale_badge_label }}
          </span>
        {% endif %}
      {% endif %}
    </div>

    {% if block.settings.show_description and product.description != blank %}
      <div class="ai-product-info__description-{{ ai_gen_id }}">
        {{ product.description | truncate: block.settings.description_length }}
      </div>
    {% endif %}

    {% form 'product', product, class: 'ai-product-info__form-{{ ai_gen_id }}', data-product-form: '' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="ai-product-info__variant-wrapper-{{ ai_gen_id }}">
            <label class="ai-product-info__variant-label-{{ ai_gen_id }}" for="option-{{ option.position }}-{{ ai_gen_id }}">
              {{ option.name }}
            </label>
            <select
              id="option-{{ option.position }}-{{ ai_gen_id }}"
              class="ai-product-info__variant-select-{{ ai_gen_id }}"
              name="options[{{ option.name | escape }}]"
              data-option-select
              data-option-position="{{ option.position }}"
            >
              {% for value in option.values %}
                <option
                  value="{{ value | escape }}"
                  {% if option.selected_value == value %}selected{% endif %}
                >
                  {{ value }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      {% endunless %}

      {% if block.settings.show_quantity %}
        <div class="ai-product-info__quantity-wrapper-{{ ai_gen_id }}">
          <label class="ai-product-info__variant-label-{{ ai_gen_id }}" for="quantity-{{ ai_gen_id }}">
            Quantity
          </label>
          <div class="ai-product-info__quantity-controls-{{ ai_gen_id }}">
            <button
              type="button"
              class="ai-product-info__quantity-button-{{ ai_gen_id }}"
              data-quantity-minus
              aria-label="Decrease quantity"
            >
              −
            </button>
            <input
              type="number"
              id="quantity-{{ ai_gen_id }}"
              class="ai-product-info__quantity-input-{{ ai_gen_id }}"
              name="quantity"
              value="1"
              min="1"
              data-quantity-input
              aria-label="Quantity"
            >
            <button
              type="button"
              class="ai-product-info__quantity-button-{{ ai_gen_id }}"
              data-quantity-plus
              aria-label="Increase quantity"
            >
              +
            </button>
          </div>
        </div>
      {% else %}
        <input type="hidden" name="quantity" value="1">
      {% endif %}

      <button
        type="submit"
        class="ai-product-info__add-to-cart-{{ ai_gen_id }}"
        data-add-to-cart
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        {% if product.selected_or_first_available_variant.available %}
          {{ block.settings.add_to_cart_text }}
        {% else %}
          {{ block.settings.sold_out_text }}
        {% endif %}
      </button>

      {% if block.settings.show_availability %}
        <div
          class="ai-product-info__availability-{{ ai_gen_id }} {% if product.selected_or_first_available_variant.available %}ai-product-info__availability--in-stock-{{ ai_gen_id }}{% else %}ai-product-info__availability--out-of-stock-{{ ai_gen_id }}{% endif %}"
          data-availability
        >
          {% if product.selected_or_first_available_variant.available %}
            {{ block.settings.in_stock_text }}
          {% else %}
            {{ block.settings.out_of_stock_text }}
          {% endif %}
        </div>
      {% endif %}
    {% endform %}
  </div>
</product-info-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductInfo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.form = this.querySelector('[data-product-form]');
        this.variantIdInput = this.querySelector('[data-variant-id]');
        this.optionSelects = this.querySelectorAll('[data-option-select]');
        this.addToCartButton = this.querySelector('[data-add-to-cart]');
        this.priceElement = this.querySelector('[data-price]');
        this.comparePriceElement = this.querySelector('[data-compare-price]');
        this.availabilityElement = this.querySelector('[data-availability]');
        this.quantityInput = this.querySelector('[data-quantity-input]');
        this.quantityMinusButton = this.querySelector('[data-quantity-minus]');
        this.quantityPlusButton = this.querySelector('[data-quantity-plus]');
      }

      connectedCallback() {
        this.setupVariantSelection();
        this.setupQuantityControls();
      }

      setupVariantSelection() {
        if (!this.optionSelects.length) return;

        this.optionSelects.forEach((select) => {
          select.addEventListener('change', () => {
            this.updateVariant();
          });
        });
      }

      setupQuantityControls() {
        if (!this.quantityInput) return;

        this.quantityMinusButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value) || 1;
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.quantityPlusButton.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value) || 1;
          this.quantityInput.value = currentValue + 1;
        });

        this.quantityInput.addEventListener('change', () => {
          const value = parseInt(this.quantityInput.value) || 1;
          if (value < 1) {
            this.quantityInput.value = 1;
          }
        });
      }

      updateVariant() {
        const selectedOptions = Array.from(this.optionSelects).map((select) => select.value);
        const variant = this.getVariantFromOptions(selectedOptions);

        if (variant) {
          this.updateVariantId(variant.id);
          this.updatePrice(variant);
          this.updateAvailability(variant);
        }
      }

      getVariantFromOptions(selectedOptions) {
        const productData = window.productData{{ ai_gen_id }};
        if (!productData) return null;

        return productData.variants.find((variant) => {
          return selectedOptions.every((option, index) => {
            return variant.options[index] === option;
          });
        });
      }

      updateVariantId(variantId) {
        this.variantIdInput.value = variantId;
      }

      updatePrice(variant) {
        if (!this.priceElement) return;

        const price = this.formatMoney(variant.price);
        this.priceElement.textContent = price;

        if (this.comparePriceElement) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            const comparePrice = this.formatMoney(variant.compare_at_price);
            this.comparePriceElement.textContent = comparePrice;
            this.comparePriceElement.style.display = 'block';
          } else {
            this.comparePriceElement.style.display = 'none';
          }
        }
      }

      updateAvailability(variant) {
        if (!this.addToCartButton) return;

        if (variant.available) {
          this.addToCartButton.disabled = false;
          this.addToCartButton.textContent = '{{ block.settings.add_to_cart_text }}';
          if (this.availabilityElement) {
            this.availabilityElement.textContent = '{{ block.settings.in_stock_text }}';
            this.availabilityElement.className = 'ai-product-info__availability-{{ ai_gen_id }} ai-product-info__availability--in-stock-{{ ai_gen_id }}';
          }
        } else {
          this.addToCartButton.disabled = true;
          this.addToCartButton.textContent = '{{ block.settings.sold_out_text }}';
          if (this.availabilityElement) {
            this.availabilityElement.textContent = '{{ block.settings.out_of_stock_text }}';
            this.availabilityElement.className = 'ai-product-info__availability-{{ ai_gen_id }} ai-product-info__availability--out-of-stock-{{ ai_gen_id }}';
          }
        }
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return '{{ cart.currency.symbol }}' + amount.toFixed(2);
      }
    }

    window.productData{{ ai_gen_id }} = {{ product | json }};
    customElements.define('product-info-{{ ai_gen_id }}', ProductInfo{{ ai_gen_id }});
  })();
</script>

