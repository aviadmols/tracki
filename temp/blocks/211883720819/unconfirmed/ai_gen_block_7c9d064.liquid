                {% comment %} Feature Item 3 {% endcomment %}
                {% if block.settings.title_3 != blank %}
                  <div class="feature-item item-3" style="--pin-x: {{ block.settings.pin_x_3 }}%; --pin-y: {{ block.settings.pin_y_3 }}%; --stagger-delay: 0.5s;">
                    <div class="feature-pin-dot"></div>
                    <div class="feature-content">
                      <h3 class="feature-title">{{ block.settings.title_3 | escape }}</h3>
                      <p class="feature-subtext">{{ block.settings.subtext_3 | escape }}</p>
