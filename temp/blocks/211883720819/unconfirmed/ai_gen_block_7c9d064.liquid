              {% endif %}
              <img src="{{ section.settings.image_desktop | image_url: width: 2000 }}" 
                   alt="{{ section.settings.image_desktop.alt | escape }}" 
                   loading="lazy" 
                   class="hero-banner-image">
            </picture>
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner-placeholder' }}
