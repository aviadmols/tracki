{% doc %}
  @prompt
    <section class="review-section">
      <!-- Section Header -->
      <div class="review-header">
        <h2>What Our Customers Say</h2>
        <p>Read honest feedback from verified buyers who use our products every day.</p>
      </div>
    
      <!-- Review Cards Container (Slider) -->
      <div class="reviews-slider">
        <!-- Card 1 -->
        <div class="review-card">
          <div class="reviewer-name">Sarah Jenkins</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Exceeded my expectations!</div>
          <p class="review-text">The quality of the material is outstanding, and customer support helped me resolve my question within minutes. Highly recommend!</p>
          <div class="review-date">August 12, 2026</div>
        </div>
    
        <!-- Card 2 -->
        <div class="review-card">
          <div class="reviewer-name">David Chen</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Saves me hours every week</div>
          <p class="review-text">Super easy to set up and seamless integration into my daily workflow. I cannot imagine going back to the old way.</p>
          <div class="review-date">August 10, 2026</div>
        </div>
    
        <!-- Card 3 -->
        <div class="review-card">
          <div class="reviewer-name">Emily Rivera</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Best purchase this year</div>
          <p class="review-text">I was skeptical at first, but after using it for a month, it has proven worth every single penny. Beautifully designed.</p>
          <div class="review-date">August 05, 2026</div>
        </div>
    
        <!-- Card 4 -->
        <div class="review-card">
          <div class="reviewer-name">Marcus Vance</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Top tier customer service</div>
          <p class="review-text">Fast shipping, elegant packaging, and the product works flawlessly out of the box. Will definitely be ordering again.</p>
          <div class="review-date">July 28, 2026</div>
        </div>
    
        <!-- Card 5 -->
        <div class="review-card">
          <div class="reviewer-name">Jessica Taylor</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Incredible attention to detail</div>
          <p class="review-text">Every feature feels thought-out and intentionally built. It completely transformed how our team manages projects.</p>
          <div class="review-date">July 22, 2026</div>
        </div>
    
        <!-- Card 6 -->
        <div class="review-card">
          <div class="reviewer-name">Alex Thorne</div>
          <div class="stars">★★★★★</div>
          <div class="review-headline">Simple, reliable, effective</div>
          <p class="review-text">Does exactly what it promises without any bloat or unnecessary complexity. A solid 5-star experience all around.</p>
          <div class="review-date">July 15, 2026</div>
        </div>
      </div>
    </section>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-reviews-header-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
  }

  .ai-reviews-header-{{ ai_gen_id }} p {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-reviews-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 auto;
  }

  .ai-reviews-slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    {% if block.settings.auto_scroll %}
      animation: ai-reviews-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    {% endif %}
  }

  {% if block.settings.auto_scroll %}
    .ai-reviews-slider-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }

    @keyframes ai-reviews-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-100% - {{ block.settings.card_gap }}px));
      }
    }
  {% endif %}

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
  }

  .ai-reviewer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin-bottom: 8px;
  }

  .ai-stars-{{ ai_gen_id }} {
    font-size: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
    margin-bottom: 12px;
    line-height: 1;
  }

  .ai-review-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 600;
    color: {{ block.settings.headline_color }};
    margin-bottom: 10px;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-reviews-header-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-reviews-header-{{ ai_gen_id }} p {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.85 }}px;
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p>{{ block.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="ai-reviews-slider-wrapper-{{ ai_gen_id }}">
    <div class="ai-reviews-slider-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign name_key = 'review_' | append: i | append: '_name'
          assign headline_key = 'review_' | append: i | append: '_headline'
          assign text_key = 'review_' | append: i | append: '_text'
          assign date_key = 'review_' | append: i | append: '_date'
          assign rating_key = 'review_' | append: i | append: '_rating'

          assign reviewer_name = block.settings[name_key]
          assign headline = block.settings[headline_key]
          assign review_text = block.settings[text_key]
          assign review_date = block.settings[date_key]
          assign rating = block.settings[rating_key]
        %}

        <div class="ai-review-card-{{ ai_gen_id }}">
          {% if reviewer_name != blank %}
            <div class="ai-reviewer-name-{{ ai_gen_id }}">{{ reviewer_name }}</div>
          {% endif %}

          <div class="ai-stars-{{ ai_gen_id }}" role="img" aria-label="{{ rating }} out of 5 stars">
            {% for star in (1..rating) %}★{% endfor %}
          </div>

          {% if headline != blank %}
            <div class="ai-review-headline-{{ ai_gen_id }}">{{ headline }}</div>
          {% endif %}

          {% if review_text != blank %}
            <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
          {% endif %}

          {% if review_date != blank %}
            <div class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</div>
          {% endif %}
        </div>
      {% endfor %}

      {% if block.settings.auto_scroll %}
        {% for i in (1..6) %}
          {% liquid
            assign name_key = 'review_' | append: i | append: '_name'
            assign headline_key = 'review_' | append: i | append: '_headline'
            assign text_key = 'review_' | append: i | append: '_text'
            assign date_key = 'review_' | append: i | append: '_date'
            assign rating_key = 'review_' | append: i | append: '_rating'

            assign reviewer_name = block.settings[name_key]
            assign headline = block.settings[headline_key]
            assign review_text = block.settings[text_key]
            assign review_date = block.settings[date_key]
            assign rating = block.settings[rating_key]
          %}

          <div class="ai-review-card-{{ ai_gen_id }}" aria-hidden="true">
            {% if reviewer_name != blank %}
              <div class="ai-reviewer-name-{{ ai_gen_id }}">{{ reviewer_name }}</div>
            {% endif %}

            <div class="ai-stars-{{ ai_gen_id }}">
              {% for star in (1..rating) %}★{% endfor %}
            </div>

            {% if headline != blank %}
              <div class="ai-review-headline-{{ ai_gen_id }}">{{ headline }}</div>
            {% endif %}

            {% if review_text != blank %}
              <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
            {% endif %}

            {% if review_date != blank %}
              <div class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-reviews-slider-{{ ai_gen_id }}');
        if (!this.slider) return;

        const autoScroll = {{ block.settings.auto_scroll | json }};
        if (!autoScroll) {
          this.enableManualScroll();
        }
      }

      enableManualScroll() {
        const wrapper = this.querySelector('.ai-reviews-slider-wrapper-{{ ai_gen_id }}');
        let isDown = false;
        let startX;
        let scrollLeft;

        wrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          wrapper.style.cursor = 'grabbing';
          startX = e.pageX - wrapper.offsetLeft;
          scrollLeft = wrapper.scrollLeft;
        });

        wrapper.addEventListener('mouseleave', () => {
          isDown = false;
          wrapper.style.cursor = 'grab';
        });

        wrapper.addEventListener('mouseup', () => {
          isDown = false;
          wrapper.style.cursor = 'grab';
        });

        wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          wrapper.scrollLeft = scrollLeft - walk;
        });

        wrapper.style.cursor = 'grab';
        wrapper.style.overflowX = 'auto';
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

