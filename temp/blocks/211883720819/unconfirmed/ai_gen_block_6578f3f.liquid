    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 320px;
    opacity: 0;
    transform: translateX(-30px) scale(0.95);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .ai-hero-banner-{{ ai_gen_id }}.is-visible .ai-hero-feature-item-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(0) scale(1);
