{% doc %}
  @prompt
    {% comment %}
      Hero Banner with Dynamic Feature Blocks & Slide-Pop Animations
    {% endcomment %}
    
    <div class="hero-banner-{{ section.id }} hero-banner-wrapper" data-section-id="{{ section.id }}">
      <div class="hero-banner-container position-{{ section.settings.content_position }}">
        
        {% comment %} Hero Background / Product Image {% endcomment %}
        <div class="hero-banner-image-wrapper">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 2000 }}" 
                 alt="{{ section.settings.image.alt | escape }}" 
                 loading="lazy" 
                 class="hero-banner-image">
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner-placeholder' }}
          {% endif %}
        </div>
    
        {% comment %} Dynamic Feature Blocks (Up to 6) {% endcomment %}
        <div class="hero-banner-features align-{{ section.settings.text_alignment }}">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="feature-item feature-item-{{ block.id }}" 
                   style="--pin-x: {{ block.settings.pin_x }}%; --pin-y: {{ block.settings.pin_y }}%; --delay-index: {{ forloop.index0 }};" 
                   {{ block.shopify_attributes }}>
                
                {% if block.settings.show_pin %}
                  <div class="feature-pin-dot"></div>
                  <div class="feature-pin-line"></div>
                {% endif %}
    
                <div class="feature-content">
                  {% if block.settings.title != blank %}
                    <h3 class="feature-title">{{ block.settings.title | escape }}</h3>
                  {% endif %}
                  {% if block.settings.subtext != blank %}
                    <p class="feature-subtext">{{ block.settings.subtext | escape }}</p>
                  {% endif %}
                </div>
    
              </div>
            {% endif %}
          {% endfor %}
        </div>
    
      </div>
    </div>
    
    <style>
      .hero-banner-{{ section.id }} {
        position: relative;
        width: 100%;
        min-height: {{ section.settings.banner_height }}px;
        overflow: hidden;
        background-color: {{ section.settings.bg_color }};
      }
    
      .hero-banner-container {
        position: relative;
        width: 100%;
        height: 100%;
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
      }
    
      /* Flex Layout Position Controls */
      .hero-banner-container.position-flex-start { justify-content: flex-start; }
      .hero-banner-container.position-center { justify-content: center; }
      .hero-banner-container.position-flex-end { justify-content: flex-end; }
    
      .hero-banner-image-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }
    
      .hero-banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    
      .hero-banner-features {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        padding: 40px 20px;
      }
    
      /* Text Alignment Controls */
      .hero-banner-features.align-left .feature-content { text-align: left; }
      .hero-banner-features.align-center .feature-content { text-align: center; }
      .hero-banner-features.align-right .feature-content { text-align: right; }
    
      .feature-item {
        position: absolute;
        top: var(--pin-y);
        left: var(--pin-x);
        display: flex;
        align-items: center;
        gap: 12px;
        max-width: 320px;
        opacity: 0;
        transform: translateX(-30px) scale(0.95);
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }
    
      /* Keyframe Stagger Trigger */
      .hero-banner-{{ section.id }}.is-visible .feature-item {
        opacity: 1;
        transform: translateX(0) scale(1);
        transition-delay: calc(var(--delay-index) * 0.15s);
      }
    
      .feature-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 4px 0;
        color: {{ section.settings.text_color }};
      }
    
      .feature-subtext {
        font-size: 0.9rem;
        margin: 0;
        color: {{ section.settings.text_color }};
        opacity: 0.85;
      }
    
      .feature-pin-dot {
        width: 12px;
        height: 12px;
        background-color: {{ section.settings.accent_color }};
        border-radius: 50%;
        box-shadow: 0 0 10px {{ section.settings.accent_color }};
        flex-shrink: 0;
      }
    </style>
    
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const section = document.querySelector('.hero-banner-{{ section.id }}');
        if (!section) return;
    
        {% if section.settings.enable_animation %}
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                section.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.2 });
    
          observer.observe(section);
        {% else %}
          section.classList.add('is-visible');
        {% endif %}
      });
    </script>
    
