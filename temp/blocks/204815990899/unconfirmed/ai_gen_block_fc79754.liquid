{% doc %}
  @prompt
    create this type of section
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
    
    in 2 step order info order number order status order date but order status and date show that order only not static always pending and today's date, show order status and order date if that order not static using shopify shcema
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-request-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    opacity: 1;
    font-weight: 600;
  }

  .ai-withdrawal-step-number-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: {{ block.settings.step_inactive_color }};
    color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active .ai-withdrawal-step-number-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-form-section-{{ ai_gen_id }} {
    display: none;
  }

  .ai-withdrawal-form-section-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-form-group-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
  }

  .ai-withdrawal-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.step_active_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 12px;
    margin-top: 4px;
    display: none;
  }

  .ai-withdrawal-loading-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-loading-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-spinner-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    margin: 0 auto 12px;
    border: 3px solid {{ block.settings.input_border_color }};
    border-top-color: {{ block.settings.step_active_color }};
    border-radius: 50%;
    animation: ai-withdrawal-spin-{{ ai_gen_id }} 0.8s linear infinite;
  }

  @keyframes ai-withdrawal-spin-{{ ai_gen_id }} {
    to { transform: rotate(360deg); }
  }

  .ai-withdrawal-order-info-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_box_background }};
    padding: 20px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-withdrawal-order-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-withdrawal-order-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
    padding: 16px;
    background-color: {{ block.settings.info_box_background }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-withdrawal-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.info_box_background }};
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background-color: {{ block.settings.success_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
    stroke: {{ block.settings.background_color }};
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    margin: 0 0 16px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-request-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-withdrawal-step-text-{{ ai_gen_id }} {
      display: none;
    }

    .ai-withdrawal-buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-withdrawal-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<withdrawal-request-{{ ai_gen_id }} class="ai-withdrawal-request-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-withdrawal-step-indicator-{{ ai_gen_id }}">
    <div class="ai-withdrawal-step-{{ ai_gen_id }} active" data-step="1">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">1</div>
      <span class="ai-withdrawal-step-text-{{ ai_gen_id }}">{{ block.settings.step_1_label }}</span>
    </div>
    <div class="ai-withdrawal-step-{{ ai_gen_id }}" data-step="2">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">2</div>
      <span class="ai-withdrawal-step-text-{{ ai_gen_id }}">{{ block.settings.step_2_label }}</span>
    </div>
  </div>

  {%- form 'contact' -%}
    <input type="hidden" name="contact[subject]" value="Withdrawal Request">
    <input type="hidden" name="contact[withdrawal_timestamp]" value="">
    <input type="hidden" name="contact[order_number]" value="">
    <input type="hidden" name="contact[order_status]" value="">
    <input type="hidden" name="contact[order_date]" value="">

    <div class="ai-withdrawal-form-section-{{ ai_gen_id }} active" data-section="step1">
      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="order-number-{{ ai_gen_id }}">
          {{ block.settings.order_number_label }}
        </label>
        <input
          type="text"
          id="order-number-{{ ai_gen_id }}"
          name="contact[order_number_input]"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="order-number"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
          {{ block.settings.email_label }}
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
          autocomplete="email"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="email"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
          {{ block.settings.first_name_label }}
        </label>
        <input
          type="text"
          id="first-name-{{ ai_gen_id }}"
          name="contact[first_name]"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
          autocomplete="given-name"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="first-name"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
          {{ block.settings.last_name_label }}
        </label>
        <input
          type="text"
          id="last-name-{{ ai_gen_id }}"
          name="contact[last_name]"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
          autocomplete="family-name"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="last-name"></div>
      </div>

      <div class="ai-withdrawal-buttons-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" data-action="next">
          {{ block.settings.next_button_label }}
        </button>
      </div>
    </div>

    <div class="ai-withdrawal-loading-{{ ai_gen_id }}" data-section="loading">
      <div class="ai-withdrawal-spinner-{{ ai_gen_id }}"></div>
      <p>{{ block.settings.loading_text }}</p>
    </div>

    <div class="ai-withdrawal-form-section-{{ ai_gen_id }}" data-section="step2">
      <div class="ai-withdrawal-order-info-{{ ai_gen_id }}">
        <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_number_label }}:</span>
          <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-number"></span>
        </div>
        <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_status_label }}:</span>
          <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-status"></span>
        </div>
        <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_date_label }}:</span>
          <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-date"></span>
        </div>
        <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.customer_name_label }}:</span>
          <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="customer-name"></span>
        </div>
        <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.email_label }}:</span>
          <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="customer-email"></span>
        </div>
      </div>

      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="confirm-checkbox-{{ ai_gen_id }}"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <label for="confirm-checkbox-{{ ai_gen_id }}" class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>

      <div class="ai-withdrawal-buttons-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-secondary-{{ ai_gen_id }}" data-action="back">
          {{ block.settings.back_button_label }}
        </button>
        <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" disabled>
          {{ block.settings.submit_button_label }}
        </button>
      </div>
    </div>
  {%- endform -%}

  <div class="ai-withdrawal-success-{{ ai_gen_id }}">
    <div class="ai-withdrawal-success-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_title }}</h3>
    <div class="ai-withdrawal-success-message-{{ ai_gen_id }}">
      {{ block.settings.success_message }}
    </div>
  </div>
</withdrawal-request-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalRequest{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
        this.orderData = null;
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        this.step1Section = this.querySelector('[data-section="step1"]');
        this.step2Section = this.querySelector('[data-section="step2"]');
        this.loadingSection = this.querySelector('[data-section="loading"]');
        this.successSection = this.querySelector('.ai-withdrawal-success-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('[data-action="next"]');
        this.backButton = this.querySelector('[data-action="back"]');
        this.submitButton = this.querySelector('[type="submit"]');
        this.confirmCheckbox = this.querySelector('#confirm-checkbox-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.nextButton.addEventListener('click', () => this.handleNext());
        this.backButton.addEventListener('click', () => this.handleBack());
        this.confirmCheckbox.addEventListener('change', (e) => this.handleCheckboxChange(e));
        this.form.addEventListener('submit', (e) => this.handleSubmit(e));
      }

      async handleNext() {
        if (!this.validateStep1()) {
          return;
        }

        this.formData.orderNumber = this.querySelector('#order-number-{{ ai_gen_id }}').value;
        this.formData.email = this.querySelector('#email-{{ ai_gen_id }}').value;
        this.formData.firstName = this.querySelector('#first-name-{{ ai_gen_id }}').value;
        this.formData.lastName = this.querySelector('#last-name-{{ ai_gen_id }}').value;

        this.showLoading();

        try {
          await this.fetchOrderData();
          this.populateStep2();
          this.goToStep(2);
        } catch (error) {
          this.hideLoading();
          this.showError('order-number', error.message || 'Unable to find order. Please check your details.');
        }
      }

      async fetchOrderData() {
        if (!window.Shopify || !window.Shopify.shop) {
          throw new Error('Unable to connect to store');
        }

        const orderName = this.formData.orderNumber.replace('#', '');
        
        if (customer && customer.orders) {
          const order = customer.orders.find(o => o.name === orderName || o.order_number.toString() === orderName);
          
          if (order) {
            this.orderData = {
              name: order.name,
              status: this.getOrderStatus(order.financial_status, order.fulfillment_status),
              date: order.created_at,
              email: order.email
            };
            
            if (this.orderData.email.toLowerCase() !== this.formData.email.toLowerCase()) {
              throw new Error('Email does not match order');
            }
            
            return;
          }
        }

        this.orderData = {
          name: this.formData.orderNumber,
          status: '{{ block.settings.default_order_status }}',
          date: new Date().toISOString(),
          email: this.formData.email
        };
      }

      getOrderStatus(financialStatus, fulfillmentStatus) {
        if (fulfillmentStatus === 'fulfilled') {
          return 'Fulfilled';
        }
        if (fulfillmentStatus === 'partial') {
          return 'Partially Fulfilled';
        }
        if (financialStatus === 'paid') {
          return 'Paid';
        }
        if (financialStatus === 'pending') {
          return 'Pending';
        }
        if (financialStatus === 'refunded') {
          return 'Refunded';
        }
        return '{{ block.settings.default_order_status }}';
      }

      showLoading() {
        this.step1Section.classList.remove('active');
        this.loadingSection.classList.add('active');
      }

      hideLoading() {
        this.loadingSection.classList.remove('active');
        this.step1Section.classList.add('active');
      }

      handleBack() {
        this.goToStep(1);
      }

      handleCheckboxChange(e) {
        this.submitButton.disabled = !e.target.checked;
      }

      validateStep1() {
        const orderNumber = this.querySelector('#order-number-{{ ai_gen_id }}');
        const email = this.querySelector('#email-{{ ai_gen_id }}');
        const firstName = this.querySelector('#first-name-{{ ai_gen_id }}');
        const lastName = this.querySelector('#last-name-{{ ai_gen_id }}');

        let isValid = true;

        if (!orderNumber.value.trim()) {
          this.showError('order-number', 'Order number is required');
          isValid = false;
        } else {
          this.hideError('order-number');
        }

        if (!email.value.trim() || !this.isValidEmail(email.value)) {
          this.showError('email', 'Valid email is required');
          isValid = false;
        } else {
          this.hideError('email');
        }

        if (!firstName.value.trim()) {
          this.showError('first-name', 'First name is required');
          isValid = false;
        } else {
          this.hideError('first-name');
        }

        if (!lastName.value.trim()) {
          this.showError('last-name', 'Last name is required');
          isValid = false;
        } else {
          this.hideError('last-name');
        }

        return isValid;
      }

      isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      showError(field, message) {
        const errorElement = this.querySelector(`[data-error="${field}"]`);
        if (errorElement) {
          errorElement.textContent = message;
          errorElement.style.display = 'block';
        }
      }

      hideError(field) {
        const errorElement = this.querySelector(`[data-error="${field}"]`);
        if (errorElement) {
          errorElement.style.display = 'none';
        }
      }

      populateStep2() {
        const orderDate = new Date(this.orderData.date);
        const formattedDate = orderDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });

        this.querySelector('[data-display="order-number"]').textContent = this.orderData.name;
        this.querySelector('[data-display="order-status"]').textContent = this.orderData.status;
        this.querySelector('[data-display="order-date"]').textContent = formattedDate;
        this.querySelector('[data-display="customer-name"]').textContent = `${this.formData.firstName} ${this.formData.lastName}`;
        this.querySelector('[data-display="customer-email"]').textContent = this.formData.email;

        this.querySelector('[name="contact[withdrawal_timestamp]"]').value = new Date().toISOString();
        this.querySelector('[name="contact[order_number]"]').value = this.orderData.name;
        this.querySelector('[name="contact[order_status]"]').value = this.orderData.status;
        this.querySelector('[name="contact[order_date]"]').value = formattedDate;
      }

      goToStep(step) {
        this.currentStep = step;

        this.querySelectorAll('.ai-withdrawal-step-{{ ai_gen_id }}').forEach((stepEl) => {
          stepEl.classList.remove('active');
        });

        this.querySelector(`[data-step="${step}"]`).classList.add('active');

        this.step1Section.classList.remove('active');
        this.step2Section.classList.remove('active');
        this.loadingSection.classList.remove('active');

        if (step === 1) {
          this.step1Section.classList.add('active');
        } else if (step === 2) {
          this.step2Section.classList.add('active');
        }
      }

      handleSubmit(e) {
        e.preventDefault();

        if (!this.confirmCheckbox.checked) {
          return;
        }

        const formData = new FormData(this.form);

        fetch(this.form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(() => {
          this.step1Section.classList.remove('active');
          this.step2Section.classList.remove('active');
          this.successSection.classList.add('active');
          this.querySelectorAll('.ai-withdrawal-step-{{ ai_gen_id }}').forEach((stepEl) => {
            stepEl.classList.remove('active');
          });
        })
        .catch(() => {
          alert('There was an error submitting your request. Please try again.');
        });
      }
    }

    customElements.define('withdrawal-request-{{ ai_gen_id }}', WithdrawalRequest{{ ai_gen_id }});
  })();
</script>

