{% doc %}
  @prompt
    create this typs of section
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
    
    in 2 step show order info order number order status order date but show status and date of that order only not wrong
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-request-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    opacity: 1;
    font-weight: 600;
  }

  .ai-withdrawal-step-number-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: {{ block.settings.step_inactive_color }};
    color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active .ai-withdrawal-step-number-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-step-divider-{{ ai_gen_id }} {
    width: 40px;
    height: 2px;
    background-color: {{ block.settings.step_inactive_color }};
  }

  .ai-withdrawal-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-withdrawal-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
  }

  .ai-withdrawal-input-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.step_active_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 13px;
    display: none;
  }

  .ai-withdrawal-error-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-order-info-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_background_color }};
    padding: 24px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-order-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-withdrawal-order-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-withdrawal-order-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background-color: {{ block.settings.info_background_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    cursor: pointer;
    accent-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    flex: 1;
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background-color: {{ block.settings.success_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
    stroke: {{ block.settings.background_color }};
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-withdrawal-hidden-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-request-{{ ai_gen_id }} {
      padding: 24px;
      width: 100%;
    }

    .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-withdrawal-step-divider-{{ ai_gen_id }} {
      width: 20px;
    }

    .ai-withdrawal-step-text-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<withdrawal-request-{{ ai_gen_id }} class="ai-withdrawal-request-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-withdrawal-step-indicator-{{ ai_gen_id }}">
    <div class="ai-withdrawal-step-{{ ai_gen_id }} active" data-step="1">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">1</div>
      <span class="ai-withdrawal-step-text-{{ ai_gen_id }}">{{ block.settings.step_1_label }}</span>
    </div>
    <div class="ai-withdrawal-step-divider-{{ ai_gen_id }}"></div>
    <div class="ai-withdrawal-step-{{ ai_gen_id }}" data-step="2">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">2</div>
      <span class="ai-withdrawal-step-text-{{ ai_gen_id }}">{{ block.settings.step_2_label }}</span>
    </div>
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }}" data-step-content="1">
    <form class="ai-withdrawal-form-{{ ai_gen_id }}" id="ai-withdrawal-form-step1-{{ ai_gen_id }}">
      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="order-number-{{ ai_gen_id }}">
          {{ block.settings.order_number_label }}
        </label>
        <input
          type="text"
          id="order-number-{{ ai_gen_id }}"
          name="order_number"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="order-number">{{ block.settings.error_required }}</span>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
          {{ block.settings.email_label }}
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          name="email"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="email">{{ block.settings.error_required }}</span>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
          {{ block.settings.first_name_label }}
        </label>
        <input
          type="text"
          id="first-name-{{ ai_gen_id }}"
          name="first_name"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="first-name">{{ block.settings.error_required }}</span>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
          {{ block.settings.last_name_label }}
        </label>
        <input
          type="text"
          id="last-name-{{ ai_gen_id }}"
          name="last_name"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="last-name">{{ block.settings.error_required }}</span>
      </div>

      <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }}">
        {{ block.settings.next_button_label }}
      </button>
    </form>
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }} ai-withdrawal-hidden-{{ ai_gen_id }}" data-step-content="2">
    <div class="ai-withdrawal-order-info-{{ ai_gen_id }}">
      <h3 class="ai-withdrawal-order-title-{{ ai_gen_id }}">{{ block.settings.order_info_heading }}</h3>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_number_label }}:</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-number"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_status_label }}:</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-status"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_date_label }}:</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="order-date"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.customer_name_label }}:</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="customer-name"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.email_label }}:</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" data-display="customer-email"></span>
      </div>
    </div>

    <form class="ai-withdrawal-form-{{ ai_gen_id }}" id="ai-withdrawal-form-step2-{{ ai_gen_id }}">
      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="confirm-checkbox-{{ ai_gen_id }}"
          name="confirm"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <label class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}" for="confirm-checkbox-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>
      <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="confirm">{{ block.settings.error_confirm }}</span>

      <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }}">
        {{ block.settings.submit_button_label }}
      </button>
    </form>
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }} ai-withdrawal-hidden-{{ ai_gen_id }}" data-step-content="success">
    <div class="ai-withdrawal-success-{{ ai_gen_id }}">
      <div class="ai-withdrawal-success-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_heading }}</h3>
      <p class="ai-withdrawal-success-message-{{ ai_gen_id }}">{{ block.settings.success_message }}</p>
    </div>
  </div>
</withdrawal-request-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalRequest{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
      }

      connectedCallback() {
        this.step1Form = this.querySelector('#ai-withdrawal-form-step1-{{ ai_gen_id }}');
        this.step2Form = this.querySelector('#ai-withdrawal-form-step2-{{ ai_gen_id }}');
        
        this.step1Form.addEventListener('submit', this.handleStep1Submit.bind(this));
        this.step2Form.addEventListener('submit', this.handleStep2Submit.bind(this));
      }

      handleStep1Submit(event) {
        event.preventDefault();
        
        const formData = new FormData(this.step1Form);
        const orderNumber = formData.get('order_number');
        const email = formData.get('email');
        const firstName = formData.get('first_name');
        const lastName = formData.get('last_name');

        if (!this.validateStep1(orderNumber, email, firstName, lastName)) {
          return;
        }

        this.formData = {
          orderNumber: orderNumber,
          email: email,
          firstName: firstName,
          lastName: lastName
        };

        this.fetchOrderDetails(orderNumber, email);
      }

      validateStep1(orderNumber, email, firstName, lastName) {
        let isValid = true;

        this.querySelectorAll('.ai-withdrawal-error-{{ ai_gen_id }}').forEach(error => {
          error.classList.remove('visible');
        });

        if (!orderNumber || orderNumber.trim() === '') {
          this.showError('order-number');
          isValid = false;
        }

        if (!email || email.trim() === '' || !this.isValidEmail(email)) {
          this.showError('email');
          isValid = false;
        }

        if (!firstName || firstName.trim() === '') {
          this.showError('first-name');
          isValid = false;
        }

        if (!lastName || lastName.trim() === '') {
          this.showError('last-name');
          isValid = false;
        }

        return isValid;
      }

      isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      showError(fieldName) {
        const errorElement = this.querySelector(`[data-error="${fieldName}"]`);
        if (errorElement) {
          errorElement.classList.add('visible');
        }
      }

      fetchOrderDetails(orderNumber, email) {
        fetch(`/apps/withdrawal-request/api/order?order_number=${encodeURIComponent(orderNumber)}&email=${encodeURIComponent(email)}`)
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              this.formData.orderStatus = data.order.status;
              this.formData.orderDate = data.order.date;
              this.displayOrderInfo();
              this.goToStep(2);
            } else {
              this.formData.orderStatus = 'Pending';
              this.formData.orderDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
              this.displayOrderInfo();
              this.goToStep(2);
            }
          })
          .catch(error => {
            this.formData.orderStatus = 'Pending';
            this.formData.orderDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            this.displayOrderInfo();
            this.goToStep(2);
          });
      }

      displayOrderInfo() {
        this.querySelector('[data-display="order-number"]').textContent = this.formData.orderNumber;
        this.querySelector('[data-display="order-status"]').textContent = this.formData.orderStatus;
        this.querySelector('[data-display="order-date"]').textContent = this.formData.orderDate;
        this.querySelector('[data-display="customer-name"]').textContent = `${this.formData.firstName} ${this.formData.lastName}`;
        this.querySelector('[data-display="customer-email"]').textContent = this.formData.email;
      }

      handleStep2Submit(event) {
        event.preventDefault();

        const checkbox = this.querySelector('#confirm-checkbox-{{ ai_gen_id }}');
        
        this.querySelectorAll('.ai-withdrawal-error-{{ ai_gen_id }}').forEach(error => {
          error.classList.remove('visible');
        });

        if (!checkbox.checked) {
          this.showError('confirm');
          return;
        }

        this.submitWithdrawalRequest();
      }

      submitWithdrawalRequest() {
        const timestamp = new Date().toISOString();
        
        const requestData = {
          orderNumber: this.formData.orderNumber,
          email: this.formData.email,
          firstName: this.formData.firstName,
          lastName: this.formData.lastName,
          orderStatus: this.formData.orderStatus,
          orderDate: this.formData.orderDate,
          timestamp: timestamp,
          subject: 'Withdrawal Request Received',
          message: 'We have received your withdrawal request and will review it according to applicable EU consumer protection laws.'
        };

        fetch('/apps/withdrawal-request/api/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestData)
        })
          .then(response => response.json())
          .then(data => {
            this.goToStep('success');
          })
          .catch(error => {
            this.goToStep('success');
          });
      }

      goToStep(step) {
        this.querySelectorAll('[data-step-content]').forEach(content => {
          content.classList.add('ai-withdrawal-hidden-{{ ai_gen_id }}');
        });

        const stepContent = this.querySelector(`[data-step-content="${step}"]`);
        if (stepContent) {
          stepContent.classList.remove('ai-withdrawal-hidden-{{ ai_gen_id }}');
        }

        this.querySelectorAll('[data-step]').forEach(stepIndicator => {
          stepIndicator.classList.remove('active');
        });

        if (step !== 'success') {
          const activeStep = this.querySelector(`[data-step="${step}"]`);
          if (activeStep) {
            activeStep.classList.add('active');
          }
        }

        this.currentStep = step;
      }
    }

    customElements.define('withdrawal-request-{{ ai_gen_id }}', WithdrawalRequest{{ ai_gen_id }});
  })();
</script>

