{% doc %}
  @prompt
    Create this type of section
    
    Withdraw from Contract
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 32px;
    text-align: center;
    line-height: 1.6;
  }

  .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .ai-withdrawal-step-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.step_inactive_color }};
    transition: background-color 0.3s ease;
  }

  .ai-withdrawal-step-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-form-group-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.label_color }};
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-withdrawal-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    box-sizing: border-box;
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-input-{{ ai_gen_id }}.error {
    border-color: {{ block.settings.error_color }};
  }

  .ai-withdrawal-error-message-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 12px;
    margin-top: 4px;
    display: none;
  }

  .ai-withdrawal-error-message-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-order-info-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_box_background }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-order-info-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .ai-withdrawal-order-detail-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid {{ block.settings.input_border_color }};
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-order-detail-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-withdrawal-order-detail-label-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-withdrawal-button-group-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 24px;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_color }};
    color: {{ block.settings.button_primary_text_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_color }};
    color: {{ block.settings.button_secondary_text_color }};
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_color }};
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    display: none;
  }

  .ai-withdrawal-success-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background-color: {{ block.settings.success_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
    stroke: #ffffff;
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-form-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-withdrawal-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-withdrawal-button-group-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-withdrawal-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<withdrawal-form-{{ ai_gen_id }} class="ai-withdrawal-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  
  {% if block.settings.description != blank %}
    <div class="ai-withdrawal-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
  {% endif %}

  <div class="ai-withdrawal-step-indicator-{{ ai_gen_id }}">
    <span class="ai-withdrawal-step-dot-{{ ai_gen_id }} active" data-step="1"></span>
    <span class="ai-withdrawal-step-dot-{{ ai_gen_id }}" data-step="2"></span>
  </div>

  <div class="ai-withdrawal-form-content-{{ ai_gen_id }}">
    <div class="ai-withdrawal-step-{{ ai_gen_id }} active" data-step="1">
      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="order-number-{{ ai_gen_id }}">
          Order Number *
        </label>
        <input
          type="text"
          id="order-number-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="e.g., #1001"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-message-{{ ai_gen_id }}" id="order-number-error-{{ ai_gen_id }}">
          Please enter a valid order number
        </div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
          Email Address *
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="your@email.com"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-message-{{ ai_gen_id }}" id="email-error-{{ ai_gen_id }}">
          Please enter a valid email address
        </div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
          First Name *
        </label>
        <input
          type="text"
          id="first-name-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-message-{{ ai_gen_id }}" id="first-name-error-{{ ai_gen_id }}">
          Please enter your first name
        </div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
          Last Name *
        </label>
        <input
          type="text"
          id="last-name-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-message-{{ ai_gen_id }}" id="last-name-error-{{ ai_gen_id }}">
          Please enter your last name
        </div>
      </div>

      <div class="ai-withdrawal-button-group-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" id="next-step-{{ ai_gen_id }}">
          Continue to Review
        </button>
      </div>
    </div>

    <div class="ai-withdrawal-step-{{ ai_gen_id }}" data-step="2">
      <div class="ai-withdrawal-order-info-{{ ai_gen_id }}">
        <h3 class="ai-withdrawal-order-info-title-{{ ai_gen_id }}">Order Information</h3>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Order Number:</span>
          <span id="review-order-number-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Email:</span>
          <span id="review-email-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Name:</span>
          <span id="review-name-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Request Date:</span>
          <span id="review-date-{{ ai_gen_id }}"></span>
        </div>
      </div>

      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="confirmation-checkbox-{{ ai_gen_id }}"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <label for="confirmation-checkbox-{{ ai_gen_id }}" class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>

      <div class="ai-withdrawal-button-group-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-secondary-{{ ai_gen_id }}" id="back-step-{{ ai_gen_id }}">
          Back
        </button>
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" id="submit-withdrawal-{{ ai_gen_id }}" disabled>
          Confirm Withdrawal
        </button>
      </div>
    </div>
  </div>

  <div class="ai-withdrawal-success-{{ ai_gen_id }}">
    <div class="ai-withdrawal-success-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_title }}</h3>
    <p class="ai-withdrawal-success-message-{{ ai_gen_id }}">{{ block.settings.success_message }}</p>
  </div>
</withdrawal-form-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
      }

      connectedCallback() {
        this.nextButton = this.querySelector('#next-step-{{ ai_gen_id }}');
        this.backButton = this.querySelector('#back-step-{{ ai_gen_id }}');
        this.submitButton = this.querySelector('#submit-withdrawal-{{ ai_gen_id }}');
        this.confirmationCheckbox = this.querySelector('#confirmation-checkbox-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.nextButton.addEventListener('click', () => this.handleNextStep());
        this.backButton.addEventListener('click', () => this.handleBackStep());
        this.submitButton.addEventListener('click', () => this.handleSubmit());
        this.confirmationCheckbox.addEventListener('change', (e) => {
          this.submitButton.disabled = !e.target.checked;
        });

        const inputs = this.querySelectorAll('.ai-withdrawal-input-{{ ai_gen_id }}');
        inputs.forEach(input => {
          input.addEventListener('blur', () => this.validateField(input));
          input.addEventListener('input', () => {
            if (input.classList.contains('error')) {
              this.validateField(input);
            }
          });
        });
      }

      validateField(field) {
        const value = field.value.trim();
        const fieldId = field.id;
        let isValid = true;
        let errorMessage = '';

        if (!value) {
          isValid = false;
          errorMessage = 'This field is required';
        } else if (fieldId.includes('email')) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          isValid = emailRegex.test(value);
          errorMessage = 'Please enter a valid email address';
        } else if (fieldId.includes('order-number')) {
          isValid = value.length > 0;
          errorMessage = 'Please enter a valid order number';
        }

        const errorElement = this.querySelector(`#${fieldId}-error-{{ ai_gen_id }}`);
        
        if (!isValid) {
          field.classList.add('error');
          if (errorElement) {
            errorElement.textContent = errorMessage;
            errorElement.classList.add('visible');
          }
        } else {
          field.classList.remove('error');
          if (errorElement) {
            errorElement.classList.remove('visible');
          }
        }

        return isValid;
      }

      validateStep1() {
        const orderNumber = this.querySelector('#order-number-{{ ai_gen_id }}');
        const email = this.querySelector('#email-{{ ai_gen_id }}');
        const firstName = this.querySelector('#first-name-{{ ai_gen_id }}');
        const lastName = this.querySelector('#last-name-{{ ai_gen_id }}');

        const isOrderNumberValid = this.validateField(orderNumber);
        const isEmailValid = this.validateField(email);
        const isFirstNameValid = this.validateField(firstName);
        const isLastNameValid = this.validateField(lastName);

        return isOrderNumberValid && isEmailValid && isFirstNameValid && isLastNameValid;
      }

      handleNextStep() {
        if (this.validateStep1()) {
          this.formData = {
            orderNumber: this.querySelector('#order-number-{{ ai_gen_id }}').value.trim(),
            email: this.querySelector('#email-{{ ai_gen_id }}').value.trim(),
            firstName: this.querySelector('#first-name-{{ ai_gen_id }}').value.trim(),
            lastName: this.querySelector('#last-name-{{ ai_gen_id }}').value.trim(),
            timestamp: new Date().toISOString()
          };

          this.querySelector('#review-order-number-{{ ai_gen_id }}').textContent = this.formData.orderNumber;
          this.querySelector('#review-email-{{ ai_gen_id }}').textContent = this.formData.email;
          this.querySelector('#review-name-{{ ai_gen_id }}').textContent = `${this.formData.firstName} ${this.formData.lastName}`;
          this.querySelector('#review-date-{{ ai_gen_id }}').textContent = new Date().toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          this.goToStep(2);
        }
      }

      handleBackStep() {
        this.goToStep(1);
      }

      goToStep(stepNumber) {
        const steps = this.querySelectorAll('.ai-withdrawal-step-{{ ai_gen_id }}');
        const dots = this.querySelectorAll('.ai-withdrawal-step-dot-{{ ai_gen_id }}');

        steps.forEach(step => step.classList.remove('active'));
        dots.forEach(dot => dot.classList.remove('active'));

        const targetStep = this.querySelector(`.ai-withdrawal-step-{{ ai_gen_id }}[data-step="${stepNumber}"]`);
        const targetDot = this.querySelector(`.ai-withdrawal-step-dot-{{ ai_gen_id }}[data-step="${stepNumber}"]`);

        if (targetStep) targetStep.classList.add('active');
        if (targetDot) targetDot.classList.add('active');

        this.currentStep = stepNumber;
      }

      async handleSubmit() {
        if (!this.confirmationCheckbox.checked) {
          return;
        }

        this.submitButton.disabled = true;
        this.submitButton.textContent = 'Processing...';

        try {
          const response = await fetch('/apps/withdrawal-request', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              order_number: this.formData.orderNumber,
              email: this.formData.email,
              first_name: this.formData.firstName,
              last_name: this.formData.lastName,
              timestamp: this.formData.timestamp,
              subject: 'Withdrawal Request Received',
              message: 'We have received your withdrawal request and will review it according to applicable EU consumer protection laws.'
            })
          });

          this.querySelector('.ai-withdrawal-form-content-{{ ai_gen_id }}').style.display = 'none';
          this.querySelector('.ai-withdrawal-step-indicator-{{ ai_gen_id }}').style.display = 'none';
          this.querySelector('.ai-withdrawal-success-{{ ai_gen_id }}').classList.add('visible');

        } catch (error) {
          console.error('Withdrawal request error:', error);
          alert('There was an error submitting your withdrawal request. Please try again or contact customer service.');
          this.submitButton.disabled = false;
          this.submitButton.textContent = 'Confirm Withdrawal';
        }
      }
    }

    customElements.define('withdrawal-form-{{ ai_gen_id }}', WithdrawalForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Withdrawal request form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Withdraw from Contract"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Submit your withdrawal request according to EU consumer protection laws.</p>"
    },
    {
      "type": "text",
      "id": "confirmation_text",
      "label": "Confirmation text",
      "default": "I confirm that I wish to withdraw from this contract. I understand that this request will be reviewed according to applicable EU consumer protection laws."
    },
    {
      "type": "inline_richtext",
      "id": "success_title",
      "label": "Success title",
      "default": "Withdrawal Request Received"
    },
    {
      "type": "richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "<p>We have received your withdrawal request and will review it according to applicable EU consumer protection laws. You will receive a confirmation email shortly.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#272c32"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#272c32"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#272c32"
    },
    {
      "type": "color",
      "id": "step_active_color",
      "label": "Step indicator active",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_inactive_color",
      "label": "Step indicator inactive",
      "default": "#d2d5d9"
    },
    {
      "type": "header",
      "content": "Input fields"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text",
      "default": "#272c32"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Border",
      "default": "#d2d5d9"
    },
    {
      "type": "color",
      "id": "input_focus_color",
      "label": "Focus outline",
      "default": "#87adf5"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
