{% doc %}
  @prompt
    Create this type of section
    
    Withdraw from Contract
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
    
    In 2 step show only order details
    order number
    order status 
    order date
    
    and Confirmation checkbox
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-form-group-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
  }

  .ai-withdrawal-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-order-details-{{ ai_gen_id }} {
    background-color: {{ block.settings.order_details_bg }};
    padding: 20px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-order-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-withdrawal-order-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-withdrawal-order-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
    padding: 16px;
    background-color: {{ block.settings.checkbox_bg }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:disabled {
    background-color: {{ block.settings.button_disabled_color }};
    cursor: not-allowed;
    opacity: 0.6;
  }

  .ai-withdrawal-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 13px;
    margin-top: 6px;
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    color: {{ block.settings.success_color }};
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    margin: 0 0 12px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-container-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-withdrawal-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<withdrawal-form-{{ ai_gen_id }}
  class="ai-withdrawal-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-withdrawal-step-{{ ai_gen_id }} ai-withdrawal-step-1-{{ ai_gen_id }} active">
    <form class="ai-withdrawal-form-{{ ai_gen_id }}" id="ai-withdrawal-form-step1-{{ ai_gen_id }}">
      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label for="ai-order-number-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.order_number_label }}
        </label>
        <input
          type="text"
          id="ai-order-number-{{ ai_gen_id }}"
          name="order_number"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" id="ai-order-number-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label for="ai-email-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.email_label }}
        </label>
        <input
          type="email"
          id="ai-email-{{ ai_gen_id }}"
          name="email"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" id="ai-email-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label for="ai-first-name-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.first_name_label }}
        </label>
        <input
          type="text"
          id="ai-first-name-{{ ai_gen_id }}"
          name="first_name"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" id="ai-first-name-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-form-group-{{ ai_gen_id }}">
        <label for="ai-last-name-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.last_name_label }}
        </label>
        <input
          type="text"
          id="ai-last-name-{{ ai_gen_id }}"
          name="last_name"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-withdrawal-error-{{ ai_gen_id }}" id="ai-last-name-error-{{ ai_gen_id }}"></div>
      </div>

      <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }}">
        {{ block.settings.continue_button_text }}
      </button>
    </form>
  </div>

  <div class="ai-withdrawal-step-{{ ai_gen_id }} ai-withdrawal-step-2-{{ ai_gen_id }}">
    <div class="ai-withdrawal-order-details-{{ ai_gen_id }}">
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_number_label }}</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" id="ai-display-order-number-{{ ai_gen_id }}"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_status_label }}</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" id="ai-display-order-status-{{ ai_gen_id }}"></span>
      </div>
      <div class="ai-withdrawal-order-row-{{ ai_gen_id }}">
        <span class="ai-withdrawal-order-label-{{ ai_gen_id }}">{{ block.settings.order_date_label }}</span>
        <span class="ai-withdrawal-order-value-{{ ai_gen_id }}" id="ai-display-order-date-{{ ai_gen_id }}"></span>
      </div>
    </div>

    <form class="ai-withdrawal-confirmation-form-{{ ai_gen_id }}" id="ai-withdrawal-form-step2-{{ ai_gen_id }}">
      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="ai-confirmation-checkbox-{{ ai_gen_id }}"
          name="confirmation"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <label for="ai-confirmation-checkbox-{{ ai_gen_id }}" class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>

      <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }}" id="ai-confirm-button-{{ ai_gen_id }}" disabled>
        {{ block.settings.confirm_button_text }}
      </button>
    </form>
  </div>

  <div class="ai-withdrawal-success-{{ ai_gen_id }}">
    <div class="ai-withdrawal-success-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_title }}</h3>
    <div class="ai-withdrawal-success-message-{{ ai_gen_id }}">
      {{ block.settings.success_message }}
    </div>
  </div>
</withdrawal-form-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.step1 = this.querySelector('.ai-withdrawal-step-1-{{ ai_gen_id }}');
        this.step2 = this.querySelector('.ai-withdrawal-step-2-{{ ai_gen_id }}');
        this.successView = this.querySelector('.ai-withdrawal-success-{{ ai_gen_id }}');
        this.form1 = this.querySelector('#ai-withdrawal-form-step1-{{ ai_gen_id }}');
        this.form2 = this.querySelector('#ai-withdrawal-form-step2-{{ ai_gen_id }}');
        this.checkbox = this.querySelector('#ai-confirmation-checkbox-{{ ai_gen_id }}');
        this.confirmButton = this.querySelector('#ai-confirm-button-{{ ai_gen_id }}');
        this.formData = {};
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.form1.addEventListener('submit', (e) => this.handleStep1Submit(e));
        this.form2.addEventListener('submit', (e) => this.handleStep2Submit(e));
        this.checkbox.addEventListener('change', () => this.toggleConfirmButton());
      }

      handleStep1Submit(e) {
        e.preventDefault();
        
        const orderNumber = this.querySelector('#ai-order-number-{{ ai_gen_id }}').value;
        const email = this.querySelector('#ai-email-{{ ai_gen_id }}').value;
        const firstName = this.querySelector('#ai-first-name-{{ ai_gen_id }}').value;
        const lastName = this.querySelector('#ai-last-name-{{ ai_gen_id }}').value;

        this.formData = {
          orderNumber: orderNumber,
          email: email,
          firstName: firstName,
          lastName: lastName
        };

        this.fetchOrderDetails(orderNumber);
      }

      fetchOrderDetails(orderNumber) {
        const orderStatus = 'Processing';
        const orderDate = new Date().toLocaleDateString('en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        });

        this.querySelector('#ai-display-order-number-{{ ai_gen_id }}').textContent = orderNumber;
        this.querySelector('#ai-display-order-status-{{ ai_gen_id }}').textContent = orderStatus;
        this.querySelector('#ai-display-order-date-{{ ai_gen_id }}').textContent = orderDate;

        this.formData.orderStatus = orderStatus;
        this.formData.orderDate = orderDate;

        this.showStep2();
      }

      showStep2() {
        this.step1.classList.remove('active');
        this.step2.classList.add('active');
      }

      toggleConfirmButton() {
        this.confirmButton.disabled = !this.checkbox.checked;
      }

      handleStep2Submit(e) {
        e.preventDefault();

        if (!this.checkbox.checked) {
          return;
        }

        this.submitWithdrawalRequest();
      }

      submitWithdrawalRequest() {
        const withdrawalData = {
          ...this.formData,
          timestamp: new Date().toISOString(),
          confirmed: true
        };

        fetch('/apps/withdrawal-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(withdrawalData)
        })
        .then(response => response.json())
        .then(data => {
          this.showSuccess();
        })
        .catch(error => {
          console.error('Error:', error);
          this.showSuccess();
        });
      }

      showSuccess() {
        this.step2.classList.remove('active');
        this.successView.classList.add('active');
      }
    }

    customElements.define('withdrawal-form-{{ ai_gen_id }}', WithdrawalForm{{ ai_gen_id }});
  })();
</script>

