{% doc %}
  @prompt
    Create this type of section
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
    
    in 2 step show all that order number info 
    and conformation checkbox using order attribute
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-request-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    opacity: 1;
    font-weight: 600;
  }

  .ai-withdrawal-step-number-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: {{ block.settings.step_inactive_color }};
    color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active .ai-withdrawal-step-number-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-step-divider-{{ ai_gen_id }} {
    width: 40px;
    height: 2px;
    background-color: {{ block.settings.step_inactive_color }};
  }

  .ai-withdrawal-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-withdrawal-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
  }

  .ai-withdrawal-input-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.step_active_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 13px;
    display: none;
  }

  .ai-withdrawal-error-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-order-info-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_background_color }};
    padding: 24px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
  }

  .ai-withdrawal-order-info-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .ai-withdrawal-order-detail-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid {{ block.settings.input_border_color }};
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-order-detail-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-withdrawal-order-detail-label-{{ ai_gen_id }} {
    font-weight: 500;
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background-color: {{ block.settings.info_background_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-button-group-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background-color: {{ block.settings.success_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
    stroke: {{ block.settings.background_color }};
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto;
  }

  .ai-withdrawal-hidden-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-request-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-withdrawal-step-indicator-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-withdrawal-step-divider-{{ ai_gen_id }} {
      width: 20px;
    }

    .ai-withdrawal-button-group-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<withdrawal-request-{{ ai_gen_id }} class="ai-withdrawal-request-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-withdrawal-step-indicator-{{ ai_gen_id }}">
    <div class="ai-withdrawal-step-{{ ai_gen_id }} active" data-step="1">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">1</div>
      <span>{{ block.settings.step_1_label }}</span>
    </div>
    <div class="ai-withdrawal-step-divider-{{ ai_gen_id }}"></div>
    <div class="ai-withdrawal-step-{{ ai_gen_id }}" data-step="2">
      <div class="ai-withdrawal-step-number-{{ ai_gen_id }}">2</div>
      <span>{{ block.settings.step_2_label }}</span>
    </div>
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }}" data-step-content="1">
    {%- form 'contact', id: 'ai-withdrawal-form-step1-' | append: ai_gen_id -%}
      <div class="ai-withdrawal-form-{{ ai_gen_id }}">
        <div class="ai-withdrawal-field-{{ ai_gen_id }}">
          <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="order-number-{{ ai_gen_id }}">
            {{ block.settings.order_number_label }} <span style="color: {{ block.settings.error_color }};">*</span>
          </label>
          <input
            type="text"
            id="order-number-{{ ai_gen_id }}"
            name="order_number"
            class="ai-withdrawal-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.order_number_placeholder }}"
            required
          >
          <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="order-number">Please enter a valid order number</span>
        </div>

        <div class="ai-withdrawal-field-{{ ai_gen_id }}">
          <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
            {{ block.settings.email_label }} <span style="color: {{ block.settings.error_color }};">*</span>
          </label>
          <input
            type="email"
            id="email-{{ ai_gen_id }}"
            name="email"
            class="ai-withdrawal-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            required
          >
          <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="email">Please enter a valid email address</span>
        </div>

        <div class="ai-withdrawal-field-{{ ai_gen_id }}">
          <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
            {{ block.settings.first_name_label }} <span style="color: {{ block.settings.error_color }};">*</span>
          </label>
          <input
            type="text"
            id="first-name-{{ ai_gen_id }}"
            name="first_name"
            class="ai-withdrawal-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.first_name_placeholder }}"
            required
          >
          <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="first-name">Please enter your first name</span>
        </div>

        <div class="ai-withdrawal-field-{{ ai_gen_id }}">
          <label class="ai-withdrawal-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
            {{ block.settings.last_name_label }} <span style="color: {{ block.settings.error_color }};">*</span>
          </label>
          <input
            type="text"
            id="last-name-{{ ai_gen_id }}"
            name="last_name"
            class="ai-withdrawal-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.last_name_placeholder }}"
            required
          >
          <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="last-name">Please enter your last name</span>
        </div>

        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }}" data-next-step>
          {{ block.settings.continue_button_label }}
        </button>
      </div>
    {%- endform -%}
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }} ai-withdrawal-hidden-{{ ai_gen_id }}" data-step-content="2">
    {%- form 'contact', id: 'ai-withdrawal-form-step2-' | append: ai_gen_id -%}
      <input type="hidden" name="contact[subject]" value="Withdrawal Request Received">
      <input type="hidden" name="contact[withdrawal_request]" value="true">
      <input type="hidden" name="contact[order_number]" id="hidden-order-number-{{ ai_gen_id }}">
      <input type="hidden" name="contact[email]" id="hidden-email-{{ ai_gen_id }}">
      <input type="hidden" name="contact[first_name]" id="hidden-first-name-{{ ai_gen_id }}">
      <input type="hidden" name="contact[last_name]" id="hidden-last-name-{{ ai_gen_id }}">
      <input type="hidden" name="contact[timestamp]" id="hidden-timestamp-{{ ai_gen_id }}">

      <div class="ai-withdrawal-order-info-{{ ai_gen_id }}">
        <h3 class="ai-withdrawal-order-info-title-{{ ai_gen_id }}">{{ block.settings.order_info_heading }}</h3>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Order Number:</span>
          <span id="display-order-number-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Email:</span>
          <span id="display-email-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Name:</span>
          <span id="display-name-{{ ai_gen_id }}"></span>
        </div>
        <div class="ai-withdrawal-order-detail-{{ ai_gen_id }}">
          <span class="ai-withdrawal-order-detail-label-{{ ai_gen_id }}">Request Date:</span>
          <span id="display-timestamp-{{ ai_gen_id }}"></span>
        </div>
      </div>

      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="confirmation-{{ ai_gen_id }}"
          name="contact[confirmation]"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          value="confirmed"
        >
        <label for="confirmation-{{ ai_gen_id }}" class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>
      <span class="ai-withdrawal-error-{{ ai_gen_id }}" data-error="confirmation">Please confirm to proceed</span>

      <div class="ai-withdrawal-button-group-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-secondary-{{ ai_gen_id }}" data-prev-step>
          {{ block.settings.back_button_label }}
        </button>
        <button type="submit" class="ai-withdrawal-button-{{ ai_gen_id }}" id="submit-button-{{ ai_gen_id }}">
          {{ block.settings.submit_button_label }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <input type="hidden" id="form-success-{{ ai_gen_id }}" value="true">
      {%- endif -%}
    {%- endform -%}
  </div>

  <div class="ai-withdrawal-step-content-{{ ai_gen_id }} ai-withdrawal-hidden-{{ ai_gen_id }}" data-step-content="success">
    <div class="ai-withdrawal-success-{{ ai_gen_id }}">
      <div class="ai-withdrawal-success-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_heading }}</h3>
      <div class="ai-withdrawal-success-message-{{ ai_gen_id }}">
        {{ block.settings.success_message }}
      </div>
    </div>
  </div>
</withdrawal-request-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalRequest{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
      }

      connectedCallback() {
        this.stepContents = this.querySelectorAll('[data-step-content]');
        this.stepIndicators = this.querySelectorAll('[data-step]');
        this.nextButton = this.querySelector('[data-next-step]');
        this.prevButton = this.querySelector('[data-prev-step]');
        this.form1 = this.querySelector('#ai-withdrawal-form-step1-{{ ai_gen_id }}');
        this.form2 = this.querySelector('#ai-withdrawal-form-step2-{{ ai_gen_id }}');
        this.submitButton = this.querySelector('#submit-button-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.checkFormSuccess();
      }

      setupEventListeners() {
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.handleNextStep());
        }

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.handlePrevStep());
        }

        if (this.form2) {
          this.form2.addEventListener('submit', (e) => this.handleSubmit(e));
        }
      }

      checkFormSuccess() {
        const successInput = this.querySelector('#form-success-{{ ai_gen_id }}');
        if (successInput && successInput.value === 'true') {
          this.showStep('success');
        }
      }

      handleNextStep() {
        if (this.validateStep1()) {
          this.collectFormData();
          this.populateStep2();
          this.currentStep = 2;
          this.showStep(2);
        }
      }

      handlePrevStep() {
        this.currentStep = 1;
        this.showStep(1);
      }

      validateStep1() {
        const orderNumber = this.querySelector('#order-number-{{ ai_gen_id }}');
        const email = this.querySelector('#email-{{ ai_gen_id }}');
        const firstName = this.querySelector('#first-name-{{ ai_gen_id }}');
        const lastName = this.querySelector('#last-name-{{ ai_gen_id }}');

        let isValid = true;

        this.querySelectorAll('.ai-withdrawal-error-{{ ai_gen_id }}').forEach(error => {
          error.classList.remove('visible');
        });

        if (!orderNumber.value.trim()) {
          this.showError('order-number');
          isValid = false;
        }

        if (!email.value.trim() || !this.isValidEmail(email.value)) {
          this.showError('email');
          isValid = false;
        }

        if (!firstName.value.trim()) {
          this.showError('first-name');
          isValid = false;
        }

        if (!lastName.value.trim()) {
          this.showError('last-name');
          isValid = false;
        }

        return isValid;
      }

      isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      showError(fieldName) {
        const error = this.querySelector(`[data-error="${fieldName}"]`);
        if (error) {
          error.classList.add('visible');
        }
      }

      collectFormData() {
        this.formData = {
          orderNumber: this.querySelector('#order-number-{{ ai_gen_id }}').value,
          email: this.querySelector('#email-{{ ai_gen_id }}').value,
          firstName: this.querySelector('#first-name-{{ ai_gen_id }}').value,
          lastName: this.querySelector('#last-name-{{ ai_gen_id }}').value,
          timestamp: new Date().toISOString()
        };
      }

      populateStep2() {
        this.querySelector('#hidden-order-number-{{ ai_gen_id }}').value = this.formData.orderNumber;
        this.querySelector('#hidden-email-{{ ai_gen_id }}').value = this.formData.email;
        this.querySelector('#hidden-first-name-{{ ai_gen_id }}').value = this.formData.firstName;
        this.querySelector('#hidden-last-name-{{ ai_gen_id }}').value = this.formData.lastName;
        this.querySelector('#hidden-timestamp-{{ ai_gen_id }}').value = this.formData.timestamp;

        this.querySelector('#display-order-number-{{ ai_gen_id }}').textContent = this.formData.orderNumber;
        this.querySelector('#display-email-{{ ai_gen_id }}').textContent = this.formData.email;
        this.querySelector('#display-name-{{ ai_gen_id }}').textContent = this.formData.firstName + ' ' + this.formData.lastName;
        this.querySelector('#display-timestamp-{{ ai_gen_id }}').textContent = new Date(this.formData.timestamp).toLocaleString();
      }

      handleSubmit(e) {
        const checkbox = this.querySelector('#confirmation-{{ ai_gen_id }}');
        const confirmError = this.querySelector('[data-error="confirmation"]');

        if (!checkbox.checked) {
          e.preventDefault();
          confirmError.classList.add('visible');
          return false;
        } else {
          confirmError.classList.remove('visible');
        }
      }

      showStep(step) {
        this.stepContents.forEach(content => {
          const stepValue = content.getAttribute('data-step-content');
          if (stepValue === step.toString() || stepValue === step) {
            content.classList.remove('ai-withdrawal-hidden-{{ ai_gen_id }}');
          } else {
            content.classList.add('ai-withdrawal-hidden-{{ ai_gen_id }}');
          }
        });

        this.stepIndicators.forEach(indicator => {
          const stepNum = parseInt(indicator.getAttribute('data-step'));
          if (stepNum <= this.currentStep && step !== 'success') {
            indicator.classList.add('active');
          } else {
            indicator.classList.remove('active');
          }
        });
      }
    }

    customElements.define('withdrawal-request-{{ ai_gen_id }}', WithdrawalRequest{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Withdrawal request form",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Withdrawal Request"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Step labels"
    },
    {
      "type": "inline_richtext",
      "id": "step_1_label",
      "label": "Step 1 label",
      "default": "Your details"
    },
    {
      "type": "inline_richtext",
      "id": "step_2_label",
      "label": "Step 2 label",
      "default": "Confirm"
    },
    {
      "type": "header",
      "content": "Step 1 fields"
    },
    {
      "type": "inline_richtext",
      "id": "order_number_label",
      "label": "Order number label",
      "default": "Order Number"
    },
    {
      "type": "inline_richtext",
      "id": "order_number_placeholder",
      "label": "Order number placeholder",
      "default": "Enter your order number"
    },
    {
      "type": "inline_richtext",
      "id": "email_label",
      "label": "Email label",
      "default": "Email Address"
    },
    {
      "type": "inline_richtext",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "inline_richtext",
      "id": "first_name_label",
      "label": "First name label",
      "default": "First Name"
    },
    {
      "type": "inline_richtext",
      "id": "first_name_placeholder",
      "label": "First name placeholder",
      "default": "Enter your first name"
    },
    {
      "type": "inline_richtext",
      "id": "last_name_label",
      "label": "Last name label",
      "default": "Last Name"
    },
    {
      "type": "inline_richtext",
      "id": "last_name_placeholder",
      "label": "Last name placeholder",
      "default": "Enter your last name"
