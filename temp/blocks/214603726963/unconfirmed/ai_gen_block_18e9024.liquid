{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-image-block-{{ ai_gen_id }}__link,
  .ai-image-block-{{ ai_gen_id }}__figure {
    display: block;
    width: 100%;
    margin: 0;
  }

  .ai-image-block-{{ ai_gen_id }}__image,
  .ai-image-block-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-image-block-{{ ai_gen_id }}__image {
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-image-block-{{ ai_gen_id }}__placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    overflow: hidden;
    background: {{ block.settings.placeholder_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-image-block-{{ ai_gen_id }}__placeholder svg {
    height: 100%;
    min-height: 220px;
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-image-block-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: calc(100% - 36px);
    transform: translateX(-50%);
    color: {{ block.settings.placeholder_text_color }};
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  .ai-image-block-{{ ai_gen_id }}__caption {
    margin-top: 12px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    text-align: {{ block.settings.caption_alignment }};
  }

  .ai-image-block-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 4px;
  }
{% endstyle %}

<div class="ai-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_link != blank %}
    <a class="ai-image-block-{{ ai_gen_id }}__link" href="{{ block.settings.image_link }}" aria-label="{{ block.settings.link_label | escape }}">
  {% endif %}

  <figure class="ai-image-block-{{ ai_gen_id }}__figure">
    {% if block.settings.image != blank %}
      <img
        class="ai-image-block-{{ ai_gen_id }}__image"
        src="{{ block.settings.image | image_url: width: 2400 }}"
        alt="{{ block.settings.image.alt | default: block.settings.image_alt | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="{{ block.settings.loading }}"
      >
    {% else %}
      <div class="ai-image-block-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-block-{{ ai_gen_id }}__empty-state">Add an image to this block</div>
      </div>
    {% endif %}

    {% if block.settings.caption != blank %}
      <figcaption class="ai-image-block-{{ ai_gen_id }}__caption">{{ block.settings.caption }}</figcaption>
    {% endif %}
  </figure>

  {% if block.settings.image_link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image block",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "image_alt",
      "label": "Alt text",
      "default": "Product image"
    },
    {
      "type": "select",
      "id": "loading",
      "label": "Loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View more"
    },
    {
      "type": "header",
      "content": "Caption"
    },
    {
      "type": "richtext",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "radio",
      "id": "caption_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#87ADF5"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#18181A"
    },
    {
      "type": "color",
      "id": "placeholder_icon_color",
      "label": "Placeholder icon",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Placeholder text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Image block"
    }
  ],
  "tag": null,
  "class": "image-block"
}
{% endschema %}