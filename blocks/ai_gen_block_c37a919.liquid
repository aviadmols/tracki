{% doc %}
  @prompt
    {%- comment -%}
      Custom Section: Non-Collapsible Product Specs
      Style: Glassmorphic / Glossy Transparent with Rounded Edges
    {%- comment -%}
    
    <div class="product-specs-wrapper page-width">
      <div class="product-specs-container">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-specs-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
    
        <div class="product-specs-rows">
          {%- for block in section.blocks -%}
            <div class="product-specs-row" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <div class="product-specs-label">{{ block.settings.label | escape }}</div>
              {%- endif -%}
              <div class="product-specs-content">
                {{ block.settings.content }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
    
    <style>
      /* Full page padding & wrapper setup */
      .product-specs-wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        width: 100%;
        box-sizing: border-box;
      }
    
      /* Glossy Transparent Glassmorphism Container */
      .product-specs-container {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: {{ section.settings.border_radius }}px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 
          0 8px 32px 0 rgba(0, 0, 0, 0.08),
          inset 0 1px 0 0 rgba(255, 255, 255, 0.6);
        padding: 32px;
        color: {{ section.settings.text_color }};
      }
    
      .product-specs-heading {
        margin-top: 0;
        margin-bottom: 24px;
        font-size: 1.5rem;
        font-weight: 600;
        color: inherit;
      }
    
      /* Row Content Formatting */
      .product-specs-rows {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
    
      .product-specs-row {
        display: flex;
        flex-direction: column;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      }
    
      .product-specs-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
    
      .product-specs-label {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.85;
      }
    
      .product-specs-content {
        font-size: 1rem;
        line-height: 1.5;
      }
    
      .product-specs-content p {
        margin: 0;
      }
    
      /* Desktop side-by-side row layout option */
      @media screen and (min-width: 750px) {
        .product-specs-container {
          padding: 48px;
        }
    
        .product-specs-row {
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-start;
        }
    
        .product-specs-label {
          width: 30%;
          padding-right: 16px;
          margin-bottom: 0;
        }
    
        .product-specs-content {
          width: 70%;
        }
      }
    </style>
    
    {% schema %}
    {
      "name": "Product Specifications",
      "tag": "section",
      "class": "section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Section Heading",
          "default": "Specifications"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#121212"
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Container Corner Radius",
          "default": 16
        },
        {
          "type": "header",
          "content": "Page Padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Top Padding",
          "default": 36
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Bottom Padding",
          "default": 36
        }
      ],
      "blocks": [
        {
          "type": "spec_row",
          "name": "Specification Row",
          "settings": [
            {
              "type": "text",
              "id": "label",
              "label": "Spec Title/Label",
              "default": "Material"
            },
            {
              "type": "richtext",
              "id": "content",
              "label": "Spec Value/Content",
              "default": "<p>100% Organic Cotton</p>"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Product Specifications",
          "blocks": [
            {
              "type": "spec_row",
              "settings": {
                "label": "Material",
                "content": "<p>100% Organic Breathable Cotton</p>"
              }
            },
            {
              "type": "spec_row",
              "settings": {
                "label": "Dimensions",
                "content": "<p>10in x 5in x 2in</p>"
              }
            },
            {
              "type": "spec_row",
              "settings": {
                "label": "Weight",
                "content": "<p>1.2 lbs</p>"
              }
            }
          ]
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-product-specs-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px}.ai-product-specs-{{ ai_gen_id }}__container{padding:32px;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;box-shadow:0 12px 32px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.16);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}.ai-product-specs-{{ ai_gen_id }}__heading{margin:0 0 24px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px;line-height:1.2;font-weight:600}.ai-product-specs-{{ ai_gen_id }}__rows{display:flex;flex-direction:column}.ai-product-specs-{{ ai_gen_id }}__row{display:flex;gap:24px;padding:16px 0;border-bottom:1px solid {{ block.settings.divider_color }}}.ai-product-specs-{{ ai_gen_id }}__row:first-child{padding-top:0}.ai-product-specs-{{ ai_gen_id }}__row:last-child{padding-bottom:0;border-bottom:0}.ai-product-specs-{{ ai_gen_id }}__label{flex:0 0 30%;color:{{ block.settings.label_color }};font-family:{{ block.settings.body_font.family }};font-size:.86em;font-weight:700;letter-spacing:.06em;line-height:1.5;text-transform:uppercase}.ai-product-specs-{{ ai_gen_id }}__content{flex:1;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }};font-size:{{ block.settings.body_size }}px;line-height:1.55}.ai-product-specs-{{ ai_gen_id }}__content p{margin:0}@media(max-width:749px){.ai-product-specs-{{ ai_gen_id }}{width:100%;padding-top:{{ block.settings.mobile_padding_top }}px;padding-bottom:{{ block.settings.mobile_padding_bottom }}px}.ai-product-specs-{{ ai_gen_id }}__container{padding:24px}.ai-product-specs-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-product-specs-{{ ai_gen_id }}__row{display:block}.ai-product-specs-{{ ai_gen_id }}__label{display:block;margin-bottom:4px}}{% endstyle %}
<div class="ai-product-specs-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-product-specs-{{ ai_gen_id }}__container">{% if block.settings.heading != blank %}<h2 class="ai-product-specs-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-product-specs-{{ ai_gen_id }}__rows">{% for i in (1..6) %}{% assign label_key = 'row_' | append: i | append: '_label' %}{% assign content_key = 'row_' | append: i | append: '_content' %}{% assign row_label = block.settings[label_key] %}{% assign row_content = block.settings[content_key] %}{% if row_label != blank or row_content != blank %}<div class="ai-product-specs-{{ ai_gen_id }}__row">{% if row_label != blank %}<div class="ai-product-specs-{{ ai_gen_id }}__label">{{ row_label | escape }}</div>{% endif %}{% if row_content != blank %}<div class="ai-product-specs-{{ ai_gen_id }}__content">{{ row_content }}</div>{% endif %}</div>{% endif %}{% endfor %}</div></div></div>
{% schema %}{"name":"Product specifications","settings":[{"type":"text","id":"heading","label":"Heading","default":"Specifications"},{"type":"text","id":"row_1_label","label":"Row 1 label","default":"Material"},{"type":"richtext","id":"row_1_content","label":"Row 1 content","default":"<p>100% Organic Breathable Cotton</p>"},{"type":"text","id":"row_2_label","label":"Row 2 label","default":"Dimensions"},{"type":"richtext","id":"row_2_content","label":"Row 2 content","default":"<p>10 in x 5 in x 2 in</p>"},{"type":"text","id":"row_3_label","label":"Row 3 label","default":"Weight"},{"type":"richtext","id":"row_3_content","label":"Row 3 content","default":"<p>1.2 lbs</p>"},{"type":"text","id":"row_4_label","label":"Row 4 label"},{"type":"richtext","id":"row_4_content","label":"Row 4 content","default":"<p>Add another specification</p>"},{"type":"text","id":"row_5_label","label":"Row 5 label"},{"type":"richtext","id":"row_5_content","label":"Row 5 content","default":"<p>Add another specification</p>"},{"type":"text","id":"row_6_label","label":"Row 6 label"},{"type":"richtext","id":"row_6_content","label":"Row 6 content","default":"<p>Add another specification</p>"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"mobile_padding_top","label":"Mobile top spacing","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom spacing","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":16},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"jost_n6"},{"type":"font_picker","id":"body_font","label":"Body font","default":"figtree_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":24},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":16,"max":36,"step":2,"unit":"px","default":22},{"type":"range","id":"body_size","label":"Body size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#353638"},{"type":"color","id":"heading_color","label":"Heading","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"color","id":"label_color","label":"Labels","default":"#D8DADD"},{"type":"color","id":"border_color","label":"Border","default":"#737579"},{"type":"color","id":"divider_color","label":"Dividers","default":"#737579"}],"presets":[{"name":"Product specifications"}],"tag":null,"class":"product-specifications-block"}{% endschema %}