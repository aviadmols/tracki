{% doc %}
  @prompt
    {% comment %}
      Hero Banner with 6 Callouts (3 Left / 3 Right) & Staggered Slide-Pop Animations
    {% endcomment %}
    
    <div class="hero-banner-{{ section.id }} hero-banner-wrapper">
      <div class="hero-banner-container">
        
        {% comment %} Left Column Features (3 Blocks) {% endcomment %}
        <div class="hero-column column-left align-{{ section.settings.left_text_align }}">
          {% assign left_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'feature_left' %}
              {% assign left_count = left_count | plus: 1 %}
              <div class="feature-item item-left" style="--stagger-delay: {{ left_count | times: 0.15 }}s;" {{ block.shopify_attributes }}>
                <div class="feature-text-wrapper">
                  {% if block.settings.title != blank %}
                    <h3 class="feature-title">{{ block.settings.title | escape }}</h3>
                  {% endif %}
                  {% if block.settings.subtext != blank %}
                    <p class="feature-subtext">{{ block.settings.subtext | escape }}</p>
                  {% endif %}
                </div>
                <div class="pointer-wrapper">
                  <div class="pointer-line"></div>
                  <div class="pointer-dot"></div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
    
        {% comment %} Center Product Image {% endcomment %}
        <div class="hero-column column-center">
          {% if section.settings.image_desktop != blank %}
            <picture>
              {% if section.settings.image_mobile != blank %}
                <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
              {% endif %}
              <img src="{{ section.settings.image_desktop | image_url: width: 1200 }}" 
                   alt="{{ section.settings.image_desktop.alt | escape }}" 
                   loading="lazy" 
                   class="product-image">
            </picture>
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}
          {% endif %}
        </div>
    
        {% comment %} Right Column Features (3 Blocks) {% endcomment %}
        <div class="hero-column column-right align-{{ section.settings.right_text_align }}">
          {% assign right_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'feature_right' %}
              {% assign right_count = right_count | plus: 1 %}
              <div class="feature-item item-right" style="--stagger-delay: {{ right_count | times: 0.15 }}s;" {{ block.shopify_attributes }}>
                <div class="pointer-wrapper">
                  <div class="pointer-dot"></div>
                  <div class="pointer-line"></div>
                </div>
                <div class="feature-text-wrapper">
                  {% if block.settings.title != blank %}
                    <h3 class="feature-title">{{ block.settings.title | escape }}</h3>
                  {% endif %}
                  {% if block.settings.subtext != blank %}
                    <p class="feature-subtext">{{ block.settings.subtext | escape }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
    
      </div>
    </div>
    
    <style>
      .hero-banner-{{ section.id }} {
        width: 100%;
        min-height: {{ section.settings.banner_height }}px;
        background-color: {{ section.settings.bg_color }};
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        overflow: hidden;
      }
    
      .hero-banner-{{ section.id }} .hero-banner-container {
        width: 100%;
        max-width: 1400px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 40px;
        align-items: center;
      }
    
      .hero-column {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 48px;
      }
    
      /* Alignment Utility */
      .align-left .feature-text-wrapper { text-align: left; }
      .align-center .feature-text-wrapper { text-align: center; }
      .align-right .feature-text-wrapper { text-align: right; }
    
      .feature-item {
        display: flex;
        align-items: center;
        gap: 16px;
        opacity: 0;
      }
    
      .item-left {
        transform: translateX(-40px) scale(0.95);
      }
    
      .item-right {
        transform: translateX(40px) scale(0.95);
      }
    
      /* Slide-Pop Animation Trigger */
      .hero-banner-{{ section.id }}.is-visible .feature-item {
        animation: slidePop 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        animation-delay: var(--stagger-delay);
      }
    
      @keyframes slidePop {
        0% {
          opacity: 0;
          transform: translateY(20px) scale(0.9);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
    
      .feature-text-wrapper {
        flex: 1;
      }
    
      .feature-title {
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1.2;
        margin: 0 0 6px 0;
        color: {{ section.settings.text_color }};
      }
    
      .feature-subtext {
        font-size: 0.9rem;
        line-height: 1.4;
        margin: 0;
        color: {{ section.settings.text_color }};
        opacity: 0.8;
      }
    
      /* Pointer Line & Glowing Dot */
      .poin
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
