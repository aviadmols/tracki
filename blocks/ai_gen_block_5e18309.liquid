    text-align: left; 
  }
  
  .align-center-{{ ai_gen_id }} .feature-text-wrapper-{{ ai_gen_id }} { 
    text-align: center; 
  }
  
  .align-right-{{ ai_gen_id }} .feature-text-wrapper-{{ ai_gen_id }} { 
    text-align: right; 
  }

  .feature-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    opacity: 0;
  }

  .item-left-{{ ai_gen_id }} {
    transform: translateX(-40px) scale(0.95);
  }

  .item-right-{{ ai_gen_id }} {
    transform: translateX(40px) scale(0.95);
  }

  .hero-banner-{{ ai_gen_id }}.is-visible .feature-item-{{ ai_gen_id }} {
    animation: slidePop-{{ ai_gen_id }} 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    animation-delay: var(--stagger-delay);
  }

  @keyframes slidePop-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateY(20px) scale(0.9);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .feature-text-wrapper-{{ ai_gen_id }} {
    flex: 1;
  }

  .feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 6px 0;
    color: {{ block.settings.text_color }};
  }

  .feature-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    line-height: 1.4;
    margin: 0;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .pointer-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .pointer-line-{{ ai_gen_id }} {
    width: {{ block.settings.pointer_line_width }}px;
    height: 2px;
    background: linear-gradient(
      to right,
      {{ block.settings.pointer_color }},
      transparent
    );
  }

  .item-right-{{ ai_gen_id }} .pointer-line-{{ ai_gen_id }} {
    background: linear-gradient(
      to left,
      {{ block.settings.pointer_color }},
      transparent
    );
  }

  .pointer-dot-{{ ai_gen_id }} {
    width: {{ block.settings.pointer_dot_size }}px;
    height: {{ block.settings.pointer_dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.pointer_color }};
    box-shadow: 0 0 {{ block.settings.pointer_glow_size }}px {{ block.settings.pointer_color }};
    animation: pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes pulse-{{ ai_gen_id }} {
    0%, 100% {
      box-shadow: 0 0 {{ block.settings.pointer_glow_size }}px {{ block.settings.pointer_color }};
      transform: scale(1);
    }
    50% {
      box-shadow: 0 0 {{ block.settings.pointer_glow_size | times: 1.5 }}px {{ block.settings.pointer_color }};
      transform: scale(1.1);
    }
  }

  .column-center-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_max_width }}px;
    width: 100%;
    height: auto;
    display: block;
  }

  .product-placeholder-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_max_width }}px;
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .hero-banner-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .hero-column-{{ ai_gen_id }} {
      gap: 24px;
    }

    .feature-item-{{ ai_gen_id }} {
      justify-content: center;
    }

    .feature-text-wrapper-{{ ai_gen_id }} {
      text-align: center;
    }

    .column-center-{{ ai_gen_id }} {
      order: -1;
    }
  }
{% endstyle %}

