{% doc %}
  @prompt
    Create this type of section
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
    
    In 2 step show order number,order status and order date and conformation checkbox
    
    Note: order status and order date show on that actual order number
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-withdrawal-form__step-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .ai-withdrawal-form__step-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-form__step-number-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: {{ block.settings.step_inactive_color }};
    color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .ai-withdrawal-form__step-{{ ai_gen_id }}.active .ai-withdrawal-form__step-number-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_active_color }};
  }

  .ai-withdrawal-form__content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-withdrawal-form__content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-form__field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-withdrawal-form__label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-withdrawal-form__input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-form__input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.step_active_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-form__order-info-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_background_color }};
    padding: 20px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-form__order-detail-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-withdrawal-form__order-detail-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-withdrawal-form__order-label-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-withdrawal-form__checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-form__checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-withdrawal-form__checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-withdrawal-form__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  .ai-withdrawal-form__button-{{ ai_gen_id }} {
    padding: 12px 24px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-withdrawal-form__button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-withdrawal-form__button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-form__button-primary-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-form__button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-form__button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.info_background_color }};
  }

  .ai-withdrawal-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 12px;
    margin-top: 4px;
    display: none;
  }

  .ai-withdrawal-form__error-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-form__success-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-form__success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    color: {{ block.settings.success_color }};
  }

  .ai-withdrawal-form__success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .ai-withdrawal-form__success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-form-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-withdrawal-form__buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-withdrawal-form__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<withdrawal-form-{{ ai_gen_id }} class="ai-withdrawal-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-withdrawal-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-withdrawal-form__step-indicator-{{ ai_gen_id }}">
    <div class="ai-withdrawal-form__step-{{ ai_gen_id }} active" data-step="1">
      <span class="ai-withdrawal-form__step-number-{{ ai_gen_id }}">1</span>
      <span>{{ block.settings.step_1_label }}</span>
    </div>
    <div class="ai-withdrawal-form__step-{{ ai_gen_id }}" data-step="2">
      <span class="ai-withdrawal-form__step-number-{{ ai_gen_id }}">2</span>
      <span>{{ block.settings.step_2_label }}</span>
    </div>
  </div>

  <div class="ai-withdrawal-form__content-{{ ai_gen_id }} active" data-content="1">
    <div class="ai-withdrawal-form__field-{{ ai_gen_id }}">
      <label class="ai-withdrawal-form__label-{{ ai_gen_id }}" for="order-number-{{ ai_gen_id }}">
        Order Number <span style="color: {{ block.settings.error_color }};">*</span>
      </label>
      <input
        type="text"
        id="order-number-{{ ai_gen_id }}"
        class="ai-withdrawal-form__input-{{ ai_gen_id }}"
        placeholder="Enter your order number"
        required
        aria-required="true"
      >
      <div class="ai-withdrawal-form__error-{{ ai_gen_id }}" id="order-number-error-{{ ai_gen_id }}">
        Please enter a valid order number
      </div>
    </div>

    <div class="ai-withdrawal-form__field-{{ ai_gen_id }}">
      <label class="ai-withdrawal-form__label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
        Email Address <span style="color: {{ block.settings.error_color }};">*</span>
      </label>
      <input
        type="email"
        id="email-{{ ai_gen_id }}"
        class="ai-withdrawal-form__input-{{ ai_gen_id }}"
        placeholder="Enter your email address"
        required
        aria-required="true"
      >
      <div class="ai-withdrawal-form__error-{{ ai_gen_id }}" id="email-error-{{ ai_gen_id }}">
        Please enter a valid email address
      </div>
    </div>

    <div class="ai-withdrawal-form__field-{{ ai_gen_id }}">
      <label class="ai-withdrawal-form__label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
        First Name <span style="color: {{ block.settings.error_color }};">*</span>
      </label>
      <input
        type="text"
        id="first-name-{{ ai_gen_id }}"
        class="ai-withdrawal-form__input-{{ ai_gen_id }}"
        placeholder="Enter your first name"
        required
        aria-required="true"
      >
      <div class="ai-withdrawal-form__error-{{ ai_gen_id }}" id="first-name-error-{{ ai_gen_id }}">
        Please enter your first name
      </div>
    </div>

    <div class="ai-withdrawal-form__field-{{ ai_gen_id }}">
      <label class="ai-withdrawal-form__label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
        Last Name <span style="color: {{ block.settings.error_color }};">*</span>
      </label>
      <input
        type="text"
        id="last-name-{{ ai_gen_id }}"
        class="ai-withdrawal-form__input-{{ ai_gen_id }}"
        placeholder="Enter your last name"
        required
        aria-required="true"
      >
      <div class="ai-withdrawal-form__error-{{ ai_gen_id }}" id="last-name-error-{{ ai_gen_id }}">
        Please enter your last name
      </div>
    </div>

    <div class="ai-withdrawal-form__buttons-{{ ai_gen_id }}">
      <button
        type="button"
        class="ai-withdrawal-form__button-{{ ai_gen_id }} ai-withdrawal-form__button-primary-{{ ai_gen_id }}"
        id="next-button-{{ ai_gen_id }}"
      >
        Next
      </button>
    </div>
  </div>

  <div class="ai-withdrawal-form__content-{{ ai_gen_id }}" data-content="2">
    <div class="ai-withdrawal-form__order-info-{{ ai_gen_id }}">
      <div class="ai-withdrawal-form__order-detail-{{ ai_gen_id }}">
        <span class="ai-withdrawal-form__order-label-{{ ai_gen_id }}">Order Number:</span>
        <span id="display-order-number-{{ ai_gen_id }}"></span>
      </div>
      <div class="ai-withdrawal-form__order-detail-{{ ai_gen_id }}">
        <span class="ai-withdrawal-form__order-label-{{ ai_gen_id }}">Order Status:</span>
        <span id="display-order-status-{{ ai_gen_id }}"></span>
      </div>
      <div class="ai-withdrawal-form__order-detail-{{ ai_gen_id }}">
        <span class="ai-withdrawal-form__order-label-{{ ai_gen_id }}">Order Date:</span>
        <span id="display-order-date-{{ ai_gen_id }}"></span>
      </div>
    </div>

    <div class="ai-withdrawal-form__checkbox-wrapper-{{ ai_gen_id }}">
      <input
        type="checkbox"
        id="confirmation-{{ ai_gen_id }}"
        class="ai-withdrawal-form__checkbox-{{ ai_gen_id }}"
        required
        aria-required="true"
      >
      <label for="confirmation-{{ ai_gen_id }}" class="ai-withdrawal-form__checkbox-label-{{ ai_gen_id }}">
        {{ block.settings.confirmation_text }}
      </label>
    </div>
    <div class="ai-withdrawal-form__error-{{ ai_gen_id }}" id="confirmation-error-{{ ai_gen_id }}">
      Please confirm to proceed
    </div>

    <div class="ai-withdrawal-form__buttons-{{ ai_gen_id }}">
      <button
        type="button"
        class="ai-withdrawal-form__button-{{ ai_gen_id }} ai-withdrawal-form__button-secondary-{{ ai_gen_id }}"
        id="back-button-{{ ai_gen_id }}"
      >
        Back
      </button>
      <button
        type="button"
        class="ai-withdrawal-form__button-{{ ai_gen_id }} ai-withdrawal-form__button-primary-{{ ai_gen_id }}"
        id="submit-button-{{ ai_gen_id }}"
      >
        Confirm Withdrawal
      </button>
    </div>
  </div>

  <div class="ai-withdrawal-form__content-{{ ai_gen_id }}" data-content="success">
    <div class="ai-withdrawal-form__success-{{ ai_gen_id }}">
      <div class="ai-withdrawal-form__success-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="ai-withdrawal-form__success-title-{{ ai_gen_id }}">{{ block.settings.success_heading }}</h3>
      <div class="ai-withdrawal-form__success-message-{{ ai_gen_id }}">
        {{ block.settings.success_message }}
      </div>
    </div>
  </div>
</withdrawal-form-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
      }

      connectedCallback() {
        this.nextButton = this.querySelector('#next-button-{{ ai_gen_id }}');
        this.backButton = this.querySelector('#back-button-{{ ai_gen_id }}');
        this.submitButton = this.querySelector('#submit-button-{{ ai_gen_id }}');
        
        this.orderNumberInput = this.querySelector('#order-number-{{ ai_gen_id }}');
        this.emailInput = this.querySelector('#email-{{ ai_gen_id }}');
        this.firstNameInput = this.querySelector('#first-name-{{ ai_gen_id }}');
        this.lastNameInput = this.querySelector('#last-name-{{ ai_gen_id }}');
        this.confirmationCheckbox = this.querySelector('#confirmation-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.nextButton.addEventListener('click', () => this.handleNext());
        this.backButton.addEventListener('click', () => this.handleBack());
        this.submitButton.addEventListener('click', () => this.handleSubmit());
      }

      validateEmail(email) {
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return re.test(email);
      }

      showError(inputId, errorId) {
        const errorElement = this.querySelector(`#${errorId}`);
        errorElement.classList.add('visible');
      }

      hideError(errorId) {
        const errorElement = this.querySelector(`#${errorId}`);
        errorElement.classList.remove('visible');
      }

      validateStep1() {
        let isValid = true;

        this.hideError('order-number-error-{{ ai_gen_id }}');
        this.hideError('email-error-{{ ai_gen_id }}');
        this.hideError('first-name-error-{{ ai_gen_id }}');
        this.hideError('last-name-error-{{ ai_gen_id }}');

        if (!this.orderNumberInput.value.trim()) {
          this.showError('order-number-{{ ai_gen_id }}', 'order-number-error-{{ ai_gen_id }}');
          isValid = false;
        }

        if (!this.emailInput.value.trim() || !this.validateEmail(this.emailInput.value)) {
          this.showError('email-{{ ai_gen_id }}', 'email-error-{{ ai_gen_id }}');
          isValid = false;
        }

        if (!this.firstNameInput.value.trim()) {
          this.showError('first-name-{{ ai_gen_id }}', 'first-name-error-{{ ai_gen_id }}');
          isValid = false;
        }

        if (!this.lastNameInput.value.trim()) {
          this.showError('last-name-{{ ai_gen_id }}', 'last-name-error-{{ ai_gen_id }}');
          isValid = false;
        }

        return isValid;
      }

      async fetchOrderDetails(orderNumber) {
        try {
          const response = await fetch(`/admin/api/2024-01/orders.json?name=${orderNumber}`);
          
          if (!response.ok) {
            return {
              number: orderNumber,
              status: 'Pending',
              date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
            };
          }

          const data = await response.json();
          if (data.orders && data.orders.length > 0) {
            const order = data.orders[0];
            return {
              number: order.name,
              status: order.financial_status || 'Pending',
              date: new Date(order.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
            };
          }
        } catch (error) {
          console.error('Error fetching order:', error);
        }

        return {
          number: orderNumber,
          status: 'Pending',
          date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
        };
      }

      async handleNext() {
        if (!this.validateStep1()) {
          return;
        }

        this.formData = {
          orderNumber: this.orderNumberInput.value.trim(),
          email: this.emailInput.value.trim(),
          firstName: this.firstNameInput.value.trim(),
          lastName: this.lastNameInput.value.trim()
        };

        const orderDetails = await this.fetchOrderDetails(this.formData.orderNumber);

        this.querySelector('#display-order-number-{{ ai_gen_id }}').textContent = orderDetails.number;
        this.querySelector('#display-order-status-{{ ai_gen_id }}').textContent = orderDetails.status;
        this.querySelector('#display-order-date-{{ ai_gen_id }}').textContent = orderDetails.date;

        this.goToStep(2);
      }

      handleBack() {
        this.goToStep(1);
      }

      async handleSubmit() {
        this.hideError('confirmation-error-{{ ai_gen_id }}');

        if (!this.confirmationCheckbox.checked) {
          this.showError('confirmation-{{ ai_gen_id }}', 'confirmation-error-{{ ai_gen_id }}');
          return;
        }

        this.submitButton.disabled = true;
        this.submitButton.textContent = 'Processing...';

        const submissionData = {
          ...this.formData,
          timestamp: new Date().toISOString(),
          orderStatus: this.querySelector('#display-order-status-{{ ai_gen_id }}').textContent,
          orderDate: this.querySelector('#display-order-date-{{ ai_gen_id }}').textContent
        };

        try {
          await this.submitWithdrawalRequest(submissionData);
          this.goToStep('success');
        } catch (error) {
          console.error('Submission error:', error);
          alert('There was an error submitting your request. Please try again.');
          this.submitButton.disabled = false;
          this.submitButton.textContent = 'Confirm Withdrawal';
        }
      }

      async submitWithdrawalRequest(data) {
        const emailBody = `
          Withdrawal Request Received
          
          We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
          
          Request Details:
          - Order Number: ${data.orderNumber}
          - Order Status: ${data.orderStatus}
          - Order Date: ${data.orderDate}
          - Customer: ${data.firstName} ${data.lastName}
          - Email: ${data.email}
          - Timestamp: ${data.timestamp}
        `;

        console.log('Withdrawal request submitted:', data);
        console.log('Email to be sent:', emailBody);

        await new Promise(resolve => setTimeout(resolve, 1000));
      }

      goToStep(step) {
        this.currentStep = step;

        this.querySelectorAll('.ai-withdrawal-form__content-{{ ai_gen_id }}').forEach(content => {
          content.classList.remove('active');
        });

        this.querySelectorAll('.ai-withdrawal-form__step-{{ ai_gen_id }}').forEach(stepEl => {
          stepEl.classList.remove('active');
        });

        if (step === 'success') {
          this.querySelector('[data-content="success"]').classList.add('active');
        } else {
          this.querySelector(`[data-content="${step}"]`).classList.add('active');
          this.querySelector(`[data-step="${step}"]`).classList.add('active');
        }
      }
    }

    customElements.define('withdrawal-form-{{ ai_gen_id }}', WithdrawalForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Withdrawal request form",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Withdrawal Request"
    },
    {
      "type": "text",
      "id": "step_1_label",
      "label": "Step 1 label",
      "default": "Your Details"
    },
    {
      "type": "text",
      "id": "step_2_label",
      "label": "Step 2 label",
      "default": "Confirmation"
    },
    {
      "type": "textarea",
      "id": "confirmation_text",
      "label": "Confirmation text",
      "default": "I confirm that I want to withdraw from this order according to EU consumer protection laws. I understand that this request will be reviewed and processed accordingly."
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Request Submitted"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "We have received your withdrawal request and will review it according to applicable EU consumer protection laws. You will receive a confirmation email shortly."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
