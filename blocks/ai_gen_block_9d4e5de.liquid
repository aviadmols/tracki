{% doc %}
  @prompt
    Create this type of section
    
    What the client is asking for
    
    Online stores must provide a Withdrawal Button (sometimes called a Cancellation Button) that allows EU consumers to exercise their statutory 14-day withdrawal right digitally. The process must be as easy as placing the order.
    
    Main requirements
    Clearly visible withdrawal button
    Available on the website.
    Easy to find.
    Not hidden inside account pages or terms pages.
    Two-step process
    Customer clicks "Withdraw from Contract" (or equivalent wording).
    Customer enters required information and confirms withdrawal.
    Final confirmation button such as "Confirm Withdrawal".
    No login required
    Users should be able to submit the withdrawal request without creating or accessing an account.
    Immediate confirmation
    System should automatically send confirmation that the withdrawal request was received.
    For Tracki.com (Shopify) I would propose
    Frontend
    
    Add a footer link and dedicated page:
    
    Withdraw from Contract
    
    When clicked:
    
    Step 1
    
    Order Number
    Email Address
    First Name
    Last Name
    
    Step 2
    
    Show order information
    Confirmation checkbox
    "Confirm Withdrawal" button
    Backend
    
    When submitted:
    
    Create a ticket in customer service system
    Send confirmation email
    Store timestamp
    Store customer details
    Store order reference
    Email
    
    Subject:
    
    Withdrawal Request Received
    
    Body:
    
    We have received your withdrawal request and will review it according to applicable EU consumer protection laws.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-withdrawal-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-withdrawal-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
  }

  .ai-withdrawal-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 32px;
    line-height: 1.6;
  }

  .ai-withdrawal-step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-withdrawal-step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-withdrawal-field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-withdrawal-label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-withdrawal-required-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  .ai-withdrawal-input-{{ ai_gen_id }},
  .ai-withdrawal-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-input-{{ ai_gen_id }}:focus,
  .ai-withdrawal-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  .ai-withdrawal-textarea-{{ ai_gen_id }} {
    min-height: 100px;
    resize: vertical;
  }

  .ai-withdrawal-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 13px;
    margin-top: 6px;
    display: none;
  }

  .ai-withdrawal-error-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-order-summary-{{ ai_gen_id }} {
    background-color: {{ block.settings.summary_background_color }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-summary-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .ai-withdrawal-summary-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-withdrawal-summary-label-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ai-withdrawal-checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-withdrawal-checkbox-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-withdrawal-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-withdrawal-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-withdrawal-button-primary-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_border_color }};
  }

  .ai-withdrawal-success-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-withdrawal-success-{{ ai_gen_id }}.visible {
    display: block;
  }

  .ai-withdrawal-success-icon-{{ ai_gen_id }} {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    color: {{ block.settings.success_color }};
  }

  .ai-withdrawal-success-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .ai-withdrawal-success-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-withdrawal-info-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.info_background_color }};
    border-left: 4px solid {{ block.settings.info_border_color }};
    padding: 16px;
    margin-bottom: 24px;
    border-radius: 4px;
  }

  .ai-withdrawal-info-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-withdrawal-form-{{ ai_gen_id }} {
      padding: 24px;
      width: 100%;
    }

    .ai-withdrawal-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-withdrawal-buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-withdrawal-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<withdrawal-form-{{ ai_gen_id }}
  class="ai-withdrawal-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-withdrawal-content-{{ ai_gen_id }}">
    <h2 class="ai-withdrawal-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-withdrawal-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>

    <div class="ai-withdrawal-info-box-{{ ai_gen_id }}">
      <p class="ai-withdrawal-info-text-{{ ai_gen_id }}">{{ block.settings.info_message }}</p>
    </div>

    <div class="ai-withdrawal-step-{{ ai_gen_id }} ai-withdrawal-step-1-{{ ai_gen_id }} active">
      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label for="order-number-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.order_number_label }} <span class="ai-withdrawal-required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="order-number-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.order_number_placeholder }}"
          required
          aria-required="true"
          aria-describedby="order-number-error-{{ ai_gen_id }}"
        >
        <div id="order-number-error-{{ ai_gen_id }}" class="ai-withdrawal-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label for="email-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.email_label }} <span class="ai-withdrawal-required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.email_placeholder }}"
          required
          aria-required="true"
          aria-describedby="email-error-{{ ai_gen_id }}"
        >
        <div id="email-error-{{ ai_gen_id }}" class="ai-withdrawal-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label for="first-name-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.first_name_label }} <span class="ai-withdrawal-required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="first-name-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.first_name_placeholder }}"
          required
          aria-required="true"
          aria-describedby="first-name-error-{{ ai_gen_id }}"
        >
        <div id="first-name-error-{{ ai_gen_id }}" class="ai-withdrawal-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label for="last-name-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.last_name_label }} <span class="ai-withdrawal-required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="last-name-{{ ai_gen_id }}"
          class="ai-withdrawal-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.last_name_placeholder }}"
          required
          aria-required="true"
          aria-describedby="last-name-error-{{ ai_gen_id }}"
        >
        <div id="last-name-error-{{ ai_gen_id }}" class="ai-withdrawal-error-{{ ai_gen_id }}"></div>
      </div>

      <div class="ai-withdrawal-field-{{ ai_gen_id }}">
        <label for="reason-{{ ai_gen_id }}" class="ai-withdrawal-label-{{ ai_gen_id }}">
          {{ block.settings.reason_label }}
        </label>
        <textarea
          id="reason-{{ ai_gen_id }}"
          class="ai-withdrawal-textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.reason_placeholder }}"
        ></textarea>
      </div>

      <div class="ai-withdrawal-buttons-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" data-action="next">
          {{ block.settings.continue_button_text }}
        </button>
      </div>
    </div>

    <div class="ai-withdrawal-step-{{ ai_gen_id }} ai-withdrawal-step-2-{{ ai_gen_id }}">
      <div class="ai-withdrawal-order-summary-{{ ai_gen_id }}">
        <h3 class="ai-withdrawal-summary-title-{{ ai_gen_id }}">{{ block.settings.summary_heading }}</h3>
        <div class="ai-withdrawal-summary-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-summary-label-{{ ai_gen_id }}">{{ block.settings.order_number_label }}:</span>
          <span class="ai-withdrawal-summary-value-{{ ai_gen_id }}" data-field="order-number"></span>
        </div>
        <div class="ai-withdrawal-summary-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-summary-label-{{ ai_gen_id }}">{{ block.settings.email_label }}:</span>
          <span class="ai-withdrawal-summary-value-{{ ai_gen_id }}" data-field="email"></span>
        </div>
        <div class="ai-withdrawal-summary-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-summary-label-{{ ai_gen_id }}">{{ block.settings.first_name_label }}:</span>
          <span class="ai-withdrawal-summary-value-{{ ai_gen_id }}" data-field="first-name"></span>
        </div>
        <div class="ai-withdrawal-summary-row-{{ ai_gen_id }}">
          <span class="ai-withdrawal-summary-label-{{ ai_gen_id }}">{{ block.settings.last_name_label }}:</span>
          <span class="ai-withdrawal-summary-value-{{ ai_gen_id }}" data-field="last-name"></span>
        </div>
      </div>

      <div class="ai-withdrawal-checkbox-wrapper-{{ ai_gen_id }}">
        <input
          type="checkbox"
          id="confirm-checkbox-{{ ai_gen_id }}"
          class="ai-withdrawal-checkbox-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <label for="confirm-checkbox-{{ ai_gen_id }}" class="ai-withdrawal-checkbox-label-{{ ai_gen_id }}">
          {{ block.settings.confirmation_text }}
        </label>
      </div>

      <div class="ai-withdrawal-buttons-{{ ai_gen_id }}">
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-secondary-{{ ai_gen_id }}" data-action="back">
          {{ block.settings.back_button_text }}
        </button>
        <button type="button" class="ai-withdrawal-button-{{ ai_gen_id }} ai-withdrawal-button-primary-{{ ai_gen_id }}" data-action="submit" disabled>
          {{ block.settings.submit_button_text }}
        </button>
      </div>
    </div>

    <div class="ai-withdrawal-success-{{ ai_gen_id }}">
      <svg class="ai-withdrawal-success-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="ai-withdrawal-success-title-{{ ai_gen_id }}">{{ block.settings.success_heading }}</h3>
      <p class="ai-withdrawal-success-message-{{ ai_gen_id }}">{{ block.settings.success_message }}</p>
    </div>
  </div>
</withdrawal-form-{{ ai_gen_id }}>

<script>
  (function() {
    class WithdrawalForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.formData = {};
      }

      connectedCallback() {
        this.step1 = this.querySelector('.ai-withdrawal-step-1-{{ ai_gen_id }}');
        this.step2 = this.querySelector('.ai-withdrawal-step-2-{{ ai_gen_id }}');
        this.successView = this.querySelector('.ai-withdrawal-success-{{ ai_gen_id }}');
        this.confirmCheckbox = this.querySelector('#confirm-checkbox-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        const buttons = this.querySelectorAll('[data-action]');
        buttons.forEach(button => {
          button.addEventListener('click', (e) => this.handleButtonClick(e));
        });

        this.confirmCheckbox.addEventListener('change', () => {
          const submitButton = this.querySelector('[data-action="submit"]');
          submitButton.disabled = !this.confirmCheckbox.checked;
        });

        const inputs = this.querySelectorAll('.ai-withdrawal-input-{{ ai_gen_id }}, .ai-withdrawal-textarea-{{ ai_gen_id }}');
        inputs.forEach(input => {
          input.addEventListener('blur', () => this.validateField(input));
          input.addEventListener('input', () => this.clearError(input));
        });
      }

      handleButtonClick(e) {
        const action = e.target.dataset.action;

        if (action === 'next') {
          this.goToStep2();
        } else if (action === 'back') {
          this.goToStep1();
        } else if (action === 'submit') {
          this.submitForm();
        }
      }

      validateField(field) {
        const errorElement = this.querySelector(`#${field.id}-error-{{ ai_gen_id }}`);
        let isValid = true;
        let errorMessage = '';

        if (field.hasAttribute('required') && !field.value.trim()) {
          isValid = false;
          errorMessage = 'This field is required';
        } else if (field.type === 'email' && field.value.trim()) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(field.value)) {
            isValid = false;
            errorMessage = 'Please enter a valid email address';
          }
        }

        if (!isValid) {
          errorElement.textContent = errorMessage;
          errorElement.classList.add('visible');
          field.setAttribute('aria-invalid', 'true');
        } else {
          errorElement.textContent = '';
          errorElement.classList.remove('visible');
          field.removeAttribute('aria-invalid');
        }

        return isValid;
      }

      clearError(field) {
        const errorElement = this.querySelector(`#${field.id}-error-{{ ai_gen_id }}`);
        errorElement.textContent = '';
        errorElement.classList.remove('visible');
        field.removeAttribute('aria-invalid');
      }

      validateStep1() {
        const orderNumber = this.querySelector('#order-number-{{ ai_gen_id }}');
        const email = this.querySelector('#email-{{ ai_gen_id }}');
        const firstName = this.querySelector('#first-name-{{ ai_gen_id }}');
        const lastName = this.querySelector('#last-name-{{ ai_gen_id }}');

        const isOrderNumberValid = this.validateField(orderNumber);
        const isEmailValid = this.validateField(email);
        const isFirstNameValid = this.validateField(firstName);
        const isLastNameValid = this.validateField(lastName);

        return isOrderNumberValid && isEmailValid && isFirstNameValid && isLastNameValid;
      }

      goToStep2() {
        if (!this.validateStep1()) {
          return;
        }

        this.formData = {
          orderNumber: this.querySelector('#order-number-{{ ai_gen_id }}').value,
          email: this.querySelector('#email-{{ ai_gen_id }}').value,
          firstName: this.querySelector('#first-name-{{ ai_gen_id }}').value,
          lastName: this.querySelector('#last-name-{{ ai_gen_id }}').value,
          reason: this.querySelector('#reason-{{ ai_gen_id }}').value
        };

        this.querySelector('[data-field="order-number"]').textContent = this.formData.orderNumber;
        this.querySelector('[data-field="email"]').textContent = this.formData.email;
        this.querySelector('[data-field="first-name"]').textContent = this.formData.firstName;
        this.querySelector('[data-field="last-name"]').textContent = this.formData.lastName;

        this.step1.classList.remove('active');
        this.step2.classList.add('active');
        this.currentStep = 2;

        this.scrollToTop();
      }

      goToStep1() {
        this.step2.classList.remove('active');
        this.step1.classList.add('active');
        this.currentStep = 1;
        this.confirmCheckbox.checked = false;
        this.querySelector('[data-action="submit"]').disabled = true;

        this.scrollToTop();
      }

      async submitForm() {
        if (!this.confirmCheckbox.checked) {
          return;
        }

        const submitButton = this.querySelector('[data-action="submit"]');
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';

        try {
          const response = await fetch('/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
              'form_type': 'contact',
              'utf8': '✓',
              'contact[subject]': 'Withdrawal Request - Order ' + this.formData.orderNumber,
              'contact[email]': this.formData.email,
              'contact[name]': this.formData.firstName + ' ' + this.formData.lastName,
              'contact[order_number]': this.formData.orderNumber,
              'contact[first_name]': this.formData.firstName,
              'contact[last_name]': this.formData.lastName,
              'contact[reason]': this.formData.reason || 'No reason provided',
              'contact[withdrawal_timestamp]': new Date().toISOString()
            })
          });

          this.step2.classList.remove('active');
          this.successView.classList.add('visible');
          this.scrollToTop();

        } catch (error) {
          alert('There was an error submitting your withdrawal request. Please try again or contact customer service.');
          submitButton.disabled = false;
          submitButton.textContent = '{{ block.settings.submit_button_text }}';
        }
      }

      scrollToTop() {
        this.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    customElements.define('withdrawal-form-{{ ai_gen_id }}', WithdrawalForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Withdrawal request form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Withdraw from Contract"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>You have the right to withdraw from this contract within 14 days without giving any reason. To exercise your right of withdrawal, please complete this form.</p>"
    },
    {
      "type": "richtext",
      "id": "info_message",
      "label": "Info message",
      "default": "<p>According to EU consumer protection laws, you have 14 days from receipt of goods to withdraw from your purchase. No login required.</p>"
    },
    {
      "type": "header",
