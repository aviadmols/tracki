    "product-details": {
      "type": "product-details",
      "blocks": {
        "collapsible_tab_nCP388": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Key Highlights at a Glance:",
            "content": "<p><strong>Unrivaled Battery Life:</strong> Up to 6 weeks (1.5 months) of continuous operation on a single rechargeable USB-C charge.</p><p><strong>Built to Survive:</strong> IP68 100% waterproof rating and operating temperature range from -20°C to +60°C.</p><p><strong>Precision Live Updates:</strong> Refresh rates as fast as every 5 seconds with accuracy within 5 meters.</p><p><strong>Global Roaming Out of the Box:</strong> Pre-configured with an embedded SIM for seamless worldwide 4G Cat 1 tracking.</p><p><strong>Ready to Mount:</strong> Includes clip and high-strength magnet attachments right in the box.</p>",
            "page": ""
          }
        },
        "60eeb066-dd65-49d7-b86e-8ef785719e6b": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specifications",
            "content": "<p><strong>Dimensions</strong>: 60 mm x 37 mm x 20 mm</p><p><strong>Weight</strong>: 55 g</p><p><strong>Network Compatibility: </strong>4G LTE Cellular + Wi-Fi Positioning</p><p><strong>Battery Type: </strong>Rechargeable Li-ion 3.8V, 1950mAh (7.41Wh)</p><p><strong>GNSS: </strong>GPS, Galileo, Beidou, GLONASS, QZSS and SBAS</p><p><strong>Alert Types: </strong>Geofence, Speeding, Movement, SOS Button, Low Battery</p><p><strong>Waterproof</strong>: IP68</p>",
            "page": ""
          }
        },
        "product-details-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Real-Time Global Tracking",
            "content": "<p>Leverages 4G LTE, Wi-Fi, and GPS technologies to deliver accurate location updates worldwide across all major mobile networks.</p>",
            "page": ""
          }
        },
        "product-details-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Rugged & Harsh-Environment Ready",
            "content": "<p>Engineered to handle <em>mud, dust, moisture, and rough outdoor conditions</em>—making it ideal for off-road vehicles, construction machinery, trailers, and exposed equipment.</p>",
            "page": ""
          }
        },
        "product-details-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Extended Battery Performance",
            "content": "<p>Built-in high-capacity <strong>1950mAh rechargeable lithium-ion battery</strong> provides significantly longer operation between charges compared to standard micro-trackers.</p>",
            "page": ""
          }
        }
      },
