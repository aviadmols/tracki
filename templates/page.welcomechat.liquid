{% layout 'theme.blank' %}

<style>
  .woot-widget-holder {
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      max-height: 100vh !important;
      min-height: 100vh !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      margin: 0 !important;
    }

    /* Hide the launcher bubble entirely */
    .woot-widget-bubble,
    .woot-widget-bubble.woot-elements--right,
    .woot--close {
      display: none !important;
    }

    /* Kill any positioning offsets Chatwoot adds around the holder */
    .woot-elements--right,
    .woot-elements--left {
      right: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
    }
  </style>
<div style="min-height: 100vh; display: flex; justify-content: center; align-items: center">
  <img
    width="45%"
    src="https://cdn.shopify.com/s/files/1/0075/3677/1145/files/tracki_logo_blank.png?v=1709173792"
    alt="logo-blank-page"
  >
    

<script>
    // 1) Configure the widget BEFORE it loads.
    window.chatwootSettings = {
      hideMessageBubble: true,  // never show the launcher bubble
      showPopoutButton: false,
      position: 'right',
      type: 'standard',
      launcherTitle: 'Chat with us'
    };

    // 2) Load the Chatwoot SDK.
    (function (d, t) {
      var BASE_URL = "https://app.chatwoot.com";      // <-- your base URL
      var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
      g.src = BASE_URL + "/packs/js/sdk.js";
      g.defer = true;
      g.async = true;
      s.parentNode.insertBefore(g, s);
      g.onload = function () {
        window.chatwootSDK.run({
          websiteToken: 'vxBMnyqc8qAikeAhYmLRzdPA',          // <-- your token
          baseUrl: BASE_URL
        });
      };
    })(document, "script");

    // 3) When the widget is ready, open it automatically.
    window.addEventListener('chatwoot:ready', function () {
      window.$chatwoot.toggleBubbleVisibility('hide'); // belt-and-suspenders
      window.$chatwoot.toggle('open');                 // auto-open the chat
    });
  </script>
</div>