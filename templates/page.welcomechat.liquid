{% layout 'theme.blank' %}
<style id="cw-fullscreen-css">
  .woot-widget-holder {
   min-height: 100vh; display: flex; justify-content: center; align-items: center
  }
  .woot-widget-bubble { display: none !important; }
  /* Optionally hide the rest of the page behind the chat */
  body.cw-fullscreen > *:not(script):not(.woot-widget-holder) { visibility: hidden; }
</style>

<div style="min-height: 100vh; display: flex; justify-content: center; align-items: center">
  <img
    width="45%"
    src="https://cdn.shopify.com/s/files/1/0075/3677/1145/files/tracki_logo_blank.png?v=1709173792"
    alt="logo-blank-page"
  >
    
</div>
<script>
    // 1) Configure the widget BEFORE it loads.
    window.chatwootSettings = {
      hideMessageBubble: true,  // never show the launcher bubble
      showPopoutButton: false,
      position: 'right',
      type: 'standard',
      launcherTitle: 'Chat with us'
    };

    // 2) Load the Chatwoot SDK.
    (function (d, t) {
      var BASE_URL = "https://app.chatwoot.com";      // <-- your base URL
      var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
      g.src = BASE_URL + "/packs/js/sdk.js";
      g.defer = true;
      g.async = true;
      s.parentNode.insertBefore(g, s);
      g.onload = function () {
        window.chatwootSDK.run({
          websiteToken: 'vxBMnyqc8qAikeAhYmLRzdPA',          // <-- your token
          baseUrl: BASE_URL
        });
      };
    })(document, "script");

    // 3) When the widget is ready, open it automatically.
 
  </script>


<script>
  const wantFullscreen = new URLSearchParams(location.search).get('chat') === 'fullscreen';

  window.addEventListener('chatwoot:ready', function () {
    if (!wantFullscreen) return;
    document.body.classList.add('cw-fullscreen');
    window.$chatwoot.toggleBubbleVisibility('hide');
    window.$chatwoot.toggle('open');
  });
</script>
