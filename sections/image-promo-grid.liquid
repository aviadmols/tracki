<section id="promo-grid-{{ section.id }}" class="promo-grid-wrapper">
  <div class="promo-grid-container">
    {% for block in section.blocks %}
      <div class="promo-card" {{ block.shopify_attributes }}>

        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              class: 'promo-image'
          }}
        {% endif %}

        <div class="promo-overlay">

          {% if block.settings.heading != blank %}
            <h2 class="promo-title">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="promo-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="promo-button"
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
#promo-grid-{{ section.id }}{
  background: #ffffff;
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
}

#promo-grid-{{ section.id }} .promo-grid-container{
  max-width: 1024px;
  margin: 0 auto;
  padding: 18px;
  background: #ffffff;
}

#promo-grid-{{ section.id }} .promo-card{
  position:relative;
  overflow:hidden;
  height:580px;
}

#promo-grid-{{ section.id }} .promo-image{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
}

#promo-grid-{{ section.id }} .promo-card:before{
  content:"";
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.12);
  z-index:1;
}

#promo-grid-{{ section.id }} .promo-overlay{
  position:absolute;
  inset:0;
  z-index:2;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  text-align:center;

  padding-left:50px;
  padding-right:50px;
}

#promo-grid-{{ section.id }} .promo-title{
  margin:0;

  color:#fff;

  font-size:17px;
  font-weight:700;
  line-height:23px;

  text-transform:uppercase;
  letter-spacing:0;
}

#promo-grid-{{ section.id }} .promo-description{
  margin-top:22px;
  margin-bottom:28px;

  max-width:390px;

  color:#fff;

  font-size:15px;
  line-height:23px;
  font-weight:400;
}

#promo-grid-{{ section.id }} .promo-button{
  width:109px;
  height:35px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#fff;
  color:#000;

  border-radius:999px;

  text-decoration:none;

  font-size:13px;
  font-weight:500;

  letter-spacing:.3px;
  text-transform:uppercase;

  transition:all .3s ease;
}

#promo-grid-{{ section.id }} .promo-button:hover{
  background:#f5f5f5;
}

@media screen and (max-width: 990px){

  #promo-grid-{{ section.id }} .promo-grid-container{
    max-width:100%;
    padding:0 20px;
  }

  #promo-grid-{{ section.id }} .promo-card{
    height:500px;
  }
}

@media screen and (max-width: 749px){

  #promo-grid-{{ section.id }} .promo-grid-container{
    grid-template-columns:1fr;
    gap:16px;
  }

  #promo-grid-{{ section.id }} .promo-card{
    height:450px;
  }

  #promo-grid-{{ section.id }} .promo-title{
    font-size:16px;
  }

  #promo-grid-{{ section.id }} .promo-description{
    font-size:14px;
    line-height:22px;
  }
}
</style>

{% schema %}
{
  "name": "Image Promo Grid",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo Card",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "PIECES TO KEEP FOREVER"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Thoughtfully designed jewelry to wear everyday"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Promo Grid",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}