<section
  id="image-promo-grid-{{ section.id }}"
  class="image-promo-grid"
>
  <div class="promo-grid">
    {% for block in section.blocks %}
      <div class="promo-card" {{ block.shopify_attributes }}>
        
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              class: 'promo-image'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'promo-image placeholder-svg' }}
        {% endif %}

        <div class="promo-overlay">

          {% if block.settings.heading != blank %}
            <h2
              class="promo-title"
              style="
                font-size:{{ block.settings.heading_size }}px;
                line-height:{{ block.settings.heading_size | times: 1.3 }}px;
              "
            >
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div
              class="promo-description"
              style="
                font-size:{{ block.settings.text_size }}px;
                line-height:{{ block.settings.text_size | plus: 8 }}px;
              "
            >
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="promo-btn"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
#image-promo-grid-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

#image-promo-grid-{{ section.id }} .promo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

#image-promo-grid-{{ section.id }} .promo-card {
  position: relative;
  overflow: hidden;
  height: 584px;
}

#image-promo-grid-{{ section.id }} .promo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#image-promo-grid-{{ section.id }} .promo-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.12);
  z-index: 1;
}

#image-promo-grid-{{ section.id }} .promo-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  text-align: center;
  padding: 0 40px;
}

#image-promo-grid-{{ section.id }} .promo-title {
  margin: 0;
  color: #fff;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
}

#image-promo-grid-{{ section.id }} .promo-description {
  color: #fff;
  margin-top: 18px;
  margin-bottom: 28px;
  max-width: 420px;
}

#image-promo-grid-{{ section.id }} .promo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 110px;
  height: 36px;

  padding: 0 24px;

  background: #fff;
  color: #000;

  border-radius: 50px;

  text-decoration: none;

  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .5px;

  transition: all .25s ease;
}

#image-promo-grid-{{ section.id }} .promo-btn:hover {
  background: #f5f5f5;
  transform: translateY(-2px);
}

@media screen and (max-width: 989px) {
  #image-promo-grid-{{ section.id }} .promo-grid {
    gap: 20px;
  }

  #image-promo-grid-{{ section.id }} .promo-card {
    height: 500px;
  }
}

@media screen and (max-width: 749px) {
  #image-promo-grid-{{ section.id }} .promo-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  #image-promo-grid-{{ section.id }} .promo-card {
    height: 450px;
  }

  #image-promo-grid-{{ section.id }} .promo-overlay {
    padding: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Image Promo Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "PIECES TO KEEP FOREVER"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading Size",
          "min": 14,
          "max": 50,
          "step": 1,
          "default": 18
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Thoughtfully designed jewelry to wear everyday"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Description Size",
          "min": 12,
          "max": 30,
          "step": 1,
          "default": 15
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Promo Grid",
      "blocks": [
        {
          "type": "promo"
        },
        {
          "type": "promo"
        }
      ]
    }
  ]
}
{% endschema %}