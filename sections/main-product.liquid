/* PRODUCT PAGE – WHITE BACKGROUND + BLACK TEXT */

body.innerpages.template-product,
.innerpages.template-product .header-wrapper > .header:before,
.innerpages.template-product .guarantees,
.innerpages.template-product .rich-text.section--padding,
.innerpages.template-product .product,
.innerpages.template-product .product__info-wrapper,
.innerpages.template-product .product__info-container,
.innerpages.template-product .accordion,
.innerpages.template-product .accordion__content,
.innerpages.template-product .page-width,
.innerpages.template-product section,
.innerpages.template-product .banner,
.innerpages.template-product .banner__content,
.innerpages.template-product .banner__box,
.innerpages.template-product .map-wrapper {
    background: #FFFFFF !important;
}

/* ALL TEXT → BLACK */
body.innerpages.template-product,
.innerpages.template-product h1,
.innerpages.template-product h2,
.innerpages.template-product h3,
.innerpages.template-product h4,
.innerpages.template-product h5,
.innerpages.template-product h6,
.innerpages.template-product p,
.innerpages.template-product span,
.innerpages.template-product div,
.innerpages.template-product a,
.innerpages.template-product li,
.innerpages.template-product label,
.innerpages.template-product summary,
.innerpages.template-product .price,
.innerpages.template-product .product__heading,
.innerpages.template-product .accordion__title,
.innerpages.template-product .product__description,
.innerpages.template-product .product__text {
    color: #000000 !important;
}

/* KEEP GREEN BUTTON */
.product-form__submit.button{
    background:#56CA68 !important;
    border-color:#56CA68 !important;
    color:#000000 !important;
}

/* SHARE ICON */
.innerpages.template-product svg{
    color:#000000 !important;
}

/* LINKS */
.innerpages.template-product a:hover{
    color:#000000 !important;
}