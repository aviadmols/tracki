<div class="accordion-wrapper">
  <div class="custom-accordion">
    {% for block in section.blocks %}
      <div class="accordion-item" {{ block.shopify_attributes }}>
        <button class="accordion-header" type="button">
          <span>{{ block.settings.heading }}</span>
          <span class="accordion-icon">^</span>
        </button>

        <div class="accordion-content">
          {{ block.settings.content }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.accordion-wrapper {
  background: #ffffff;
  padding-top: 75px;
  padding-bottom: 80px;
}

.custom-accordion {
  max-width: 1000px;
  margin: 0 auto;
  width: 100%;
}

.accordion-item {
  border-top: 1px solid #d9d9d9;
}

.accordion-item:last-child {
  border-bottom: 1px solid #d9d9d9;
}

.accordion-header {
  width: 100%;
  padding: 32px 0;
  background: transparent;
  border: none;
  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: #000;
  font-size: 15px;
  font-weight: 700;
  text-transform: uppercase;
  text-align: left;
  line-height: 1.2;
}

.accordion-icon {
  font-size: 18px;
  color: #000;
  transition: transform 0.3s ease;
}

.accordion-content {
  display: none;
  padding: 0 0 30px;
  color: #000;
  font-size: 14px;
  line-height: 1.7;
}

.accordion-item.active .accordion-content {
  display: block;
}

.accordion-item.active .accordion-icon {
  transform: rotate(180deg);
}

@media screen and (max-width: 1024px) {
  .custom-accordion {
    padding: 0 30px;
  }
}

@media screen and (max-width: 749px) {
  .accordion-wrapper {
    padding-top: 50px;
    padding-bottom: 50px;
  }

  .custom-accordion {
    padding: 0 20px;
  }

  .accordion-header {
    font-size: 14px;
    padding: 24px 0;
  }

  .accordion-content {
    font-size: 13px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const headers = document.querySelectorAll('.accordion-header');

  headers.forEach(function(header) {
    header.addEventListener('click', function() {
      const item = this.parentElement;

      item.classList.toggle('active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Custom Accordion",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "CARE INSTRUCTIONS"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Accordion",
      "blocks": [
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}