<div class="custom-accordion">
  {% for block in section.blocks %}
    <div class="accordion-item" {{ block.shopify_attributes }}>
      <button class="accordion-header">
        <span>{{ block.settings.heading }}</span>
        <span class="accordion-icon">⌄</span>
      </button>

      <div class="accordion-content">
        {{ block.settings.content }}
      </div>
    </div>
  {% endfor %}
</div>

<style>
.accordion-wrapper {
  background: #ffffff;
  padding-top: 75px;
  padding-bottom: 80px;
}

.custom-accordion {
  max-width: 1000px;
  margin: 0 auto;
  background: #fff;
}

.accordion-item {
  border-top: 1px solid #d8d8d8;
}

.accordion-item:last-child {
  border-bottom: 1px solid #d8d8d8;
}

.accordion-header {
  width: 100%;
  background: transparent;
  border: 0;
  padding: 28px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;

  color: #000;
  font-size: 15px;
  font-weight: 700;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0;
}

.accordion-icon {
  color: #000;
  font-size: 16px;
  line-height: 1;
  transition: transform .3s ease;
}

.accordion-content {
  display: none;
  padding: 0 0 28px;
  color: #000;
  font-size: 14px;
  line-height: 1.7;
}

.accordion-item.active .accordion-content {
  display: block;
}

.accordion-item.active .accordion-icon {
  transform: rotate(180deg);
}

@media (max-width: 749px) {
  .accordion-wrapper {
    padding-top: 50px;
    padding-bottom: 50px;
  }

  .custom-accordion {
    padding: 0 20px;
  }

  .accordion-header {
    font-size: 14px;
    padding: 24px 0;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.accordion-header').forEach(button => {
    button.addEventListener('click', function() {
      const item = this.parentElement;

      item.classList.toggle('active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Product Accordion",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "CARE INSTRUCTIONS"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Accordion",
      "blocks": [
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}