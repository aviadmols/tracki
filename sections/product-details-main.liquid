<style>
    .custom-product {
  max-width: 1400px;
  margin: 0 auto;
  padding: 24px 32px;
  background: #fff;
  color: #000;
}

.custom-product__grid {
  display: grid;
  grid-template-columns: 58% 42%;
  gap: 32px;
}

/* Gallery */

.custom-product__gallery img {
  width: 100%;
  display: block;
}

.gallery-item {
  margin-bottom: 20px;
  background: #f5f5f5;
}

/* Product Info */

.custom-product__info {
  position: sticky;
  top: 20px;
  align-self: start;
  background: #fff;
}

.preorder-badge {
  background: #7c6a58;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 5px 10px;
  display: inline-block;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.product-title {
  font-size: 24px;
  font-weight: 600;
  margin: 0 0 8px;
  text-transform: uppercase;
  line-height: 1.3;
  color: #000;
}

.product-price {
  font-size: 14px;
  color: #000;
  margin-bottom: 15px;
}

.inventory-warning {
  margin-bottom: 20px;
  color: #666;
  font-size: 13px;
  padding-bottom: 15px;
  border-bottom: 1px solid #d9d9d9;
}

/* Variants */

.variant-wrapper {
  padding: 15px 0;
  border-bottom: 1px solid #d9d9d9;
}

.swatches {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.swatches label {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid #cfcfcf;
  cursor: pointer;
  padding: 0;
  display: block;
}

/* Countdown */

.countdown-box {
  background: #ead7ca;
  padding: 18px;
  margin: 20px 0;
  text-align: center;
  border: none;
}

.countdown-box p {
  margin: 0;
  color: #000;
  font-size: 13px;
}

/* Accordion */

details {
  border-top: 1px solid #d9d9d9;
  padding: 0;
}

details:last-child {
  border-bottom: 1px solid #d9d9d9;
}

summary {
  cursor: pointer;
  padding: 15px 0;
  font-size: 13px;
  color: #000;
  list-style: none;
}

summary::-webkit-details-marker {
  display: none;
}

/* Feature List */

.feature-list {
  list-style: none;
  padding: 20px 0;
  margin: 0;
  border-bottom: 1px solid #d9d9d9;
}

.feature-list li {
  margin-bottom: 12px;
  font-size: 13px;
  color: #000;
}

/* Quantity + Cart */

.purchase-row {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-top: 20px;
}

.purchase-row input {
  width: 70px;
  height: 50px;
  text-align: center;
  border: 1px solid #000;
  border-radius: 25px;
  background: #fff;
  color: #000;
  font-size: 14px;
}

.add-cart-btn {
  flex: 1;
  height: 50px;
  border: none;
  border-radius: 999px;
  background: #000;
  color: #fff;
  cursor: pointer;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* Mobile */

@media (max-width: 768px) {
  .custom-product {
    padding: 15px;
  }

  .custom-product__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .custom-product__info {
    position: relative;
    top: 0;
  }

  .purchase-row {
    flex-direction: column;
  }

  .purchase-row input,
  .add-cart-btn {
    width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "Product Details Main",
  "settings": [
    {
      "type": "text",
      "id": "preorder_text",
      "label": "Preorder Badge",
      "default": "Pre-order"
    },
    {
      "type": "textarea",
      "id": "details_text",
      "label": "Details Content"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Free 30 Days Returns"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "Free shipping over $100"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "1 year warranty"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Feature 4",
      "default": "14k Solid Gold"
    }
  ],
  "presets": [
    {
      "name": "Product Details Main"
    }
  ]
}
{% endschema %}