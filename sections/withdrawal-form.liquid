<div id="withdrawal-form">

  <div id="step1">
    <h2>Withdraw from Contract</h2>

    <input type="text" id="order_number" placeholder="Order Number" required>
    <input type="email" id="email" placeholder="Email Address" required>
    <input type="text" id="first_name" placeholder="First Name" required>
    <input type="text" id="last_name" placeholder="Last Name" required>

    <button type="button" id="continue-btn">
      Continue
    </button>
  </div>

  <div id="step2" style="display:none;">
    <h2>Review Request</h2>

    <div id="review-info"></div>

    {% form 'contact' %}

      <input type="hidden" name="contact[Request Type]" value="EU Withdrawal Request">

      <input type="hidden" name="contact[Order Number]" id="contact_order_number">

      <input type="hidden" name="contact[First Name]" id="contact_first_name">

      <input type="hidden" name="contact[Last Name]" id="contact_last_name">

      <input type="hidden" name="contact[email]" id="contact_email">

      <input type="hidden"
             name="contact[Submitted At]"
             value="{{ 'now' | date: '%Y-%m-%d %H:%M:%S' }}">

      <label>
        <input type="checkbox" required>
        I confirm that I wish to withdraw from this contract.
      </label>

      <br><br>

      <button type="submit">
        Confirm Withdrawal
      </button>

    {% endform %}
  </div>

</div>