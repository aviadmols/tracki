{% for block in section.blocks %}
  {% case block.type %}
    {% when '@app' %}
      {% render block %}
  {% endcase %}
{% endfor %}
<style>
  .widerruf-form-card{
    background: rgba(8,15,28,0.92);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    backdrop-filter: blur(20px);
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
}

/* Header */
.widerruf-form-card__title{
    color:#fff;
    font-size:42px;
    font-weight:700;
    letter-spacing:-1px;
}

/* Step Navigation */
.widerruf-form-steps{
    display:flex;
    justify-content:space-between;
    margin:30px 0;
}

.widerruf-form-step-pill{
    background:transparent;
    border:1px solid rgba(255,255,255,.15);
    color:#bfc7d5;
    border-radius:50px;
    padding:14px 24px;
    font-weight:600;
}

.widerruf-form-step-pill[aria-current="step"]{
    background:#67d84f;
    color:#08111c;
    border-color:#67d84f;
}

/* Labels */
.widerruf-form__label{
    color:#fff;
    font-size:18px;
    font-weight:600;
    margin-bottom:10px;
}

/* Inputs */
.widerruf-form__input{
    background:rgba(255,255,255,.03);
    border:1px solid rgba(255,255,255,.12);
    border-radius:16px;
    height:64px;
    color:#fff;
    padding:0 20px;
    transition:.3s;
}

.widerruf-form__input::placeholder{
    color:#8e97a8;
}

.widerruf-form__input:focus{
    outline:none;
    border-color:#67d84f;
    box-shadow:0 0 0 4px rgba(103,216,79,.12);
}

/* Description */
.widerruf-form-step-intro{
    background:rgba(255,255,255,.03);
    border:1px solid rgba(255,255,255,.08);
    border-radius:20px;
    padding:25px;
    margin-bottom:25px;
}

.widerruf-form-step-intro__title{
    color:#fff;
    font-size:28px;
    font-weight:700;
}

.widerruf-form-step-intro__text{
    color:#aeb8c9;
}

/* Hints */
.widerruf-form__hint{
    color:#8e97a8;
    font-size:14px;
}

/* Continue Button */
.widerruf-primary-button{
    background:#67d84f !important;
    color:#08111c !important;
    border:none;
    border-radius:16px;
    min-width:220px;
    height:60px;
    font-size:18px;
    font-weight:700;
    transition:.3s;
}

.widerruf-primary-button:hover{
    transform:translateY(-2px);
    background:#78e85f !important;
}

/* Branding */
.widerruf-form-branding{
    border-top:1px solid rgba(255,255,255,.08);
    margin-top:35px;
    padding-top:25px;
}

.widerruf-form-branding__text{
    color:#c8d0dd;
}

/* Required Star */
.widerruf-required{
    color:#67d84f;
}
</style>
{% schema %}
{
  "name": "Withdrawal Form",
  "settings": [
    ],
  "blocks": [
  {
    "type": "@app"
  }
],
  "presets": [
    {
      "name": "Withdrawal Form"
    }
  ]
}
{% endschema %}