<div id="withdrawal-form">

  <div class="withdrawal-progress">
    <div class="withdrawal-progress__step active" id="progress-step-1">
      1. Customer Details
    </div>
    <div class="withdrawal-progress__step" id="progress-step-2">
      2. Review & Confirm
    </div>
  </div>

  {% form 'contact' %}

    {% if form.posted_successfully? %}
      <div class="withdraw-success">
        <h3>Withdrawal Request Submitted</h3>
        <p>
          Thank you. Your withdrawal request has been submitted successfully.
        </p>
        <p>
          A confirmation email will be sent to your email address and our support team will review your request.
        </p>
      </div>
    {% endif %}

    {% if form.errors %}
      <div class="withdraw-error">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div id="step1">

      <h2>Withdraw from Contract</h2>

      <input
        type="text"
        id="order_number"
        placeholder="Order Number"
        required
      >

      <input
        type="email"
        id="email"
        placeholder="Email Address"
        required
      >

      <input
        type="text"
        id="first_name"
        placeholder="First Name"
        required
      >

      <input
        type="text"
        id="last_name"
        placeholder="Last Name"
        required
      >

      <button type="button" id="continue-btn">
        Continue
      </button>

    </div>

    <div id="step2" style="display:none;">

      <h2>Review Request</h2>

      <div id="review-info">
        <div class="order-review">

          <p>
            <strong>Order Number:</strong>
            <span id="review-order-number"></span>
          </p>

          <p>
            <strong>Email:</strong>
            <span id="review-email"></span>
          </p>

          <p>
            <strong>First Name:</strong>
            <span id="review-first-name"></span>
          </p>

          <p>
            <strong>Last Name:</strong>
            <span id="review-last-name"></span>
          </p>

        </div>
      </div>

      <input
        type="hidden"
        name="contact[Request Type]"
        value="EU Withdrawal Request"
      >

      <input
        type="hidden"
        name="contact[Order Number]"
        id="contact_order_number"
      >

      <input
        type="hidden"
        name="contact[First Name]"
        id="contact_first_name"
      >

      <input
        type="hidden"
        name="contact[Last Name]"
        id="contact_last_name"
      >

      <input
        type="hidden"
        name="contact[email]"
        id="contact_email"
      >

      <input
        type="hidden"
        name="contact[Submitted At]"
        value="{{ 'now' | date: '%Y-%m-%d %H:%M:%S' }}"
      >

      <label class="withdraw-checkbox">
        <input type="checkbox" required>
        <span>
          I confirm that I wish to withdraw from this contract.
        </span>
      </label>

      <div class="withdraw-actions">

        <button
          type="button"
          id="back-btn"
          class="btn-secondary"
        >
          Back
        </button>

        <button type="submit">
          Confirm Withdrawal
        </button>

      </div>

    </div>

  {% endform %}

</div>

<style>
#withdrawal-form {
  max-width: 750px;
  margin: 50px auto;
  padding: 40px;
  background: #fff;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
}

.withdrawal-progress {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
}

.withdrawal-progress__step {
  flex: 1;
  text-align: center;
  padding: 12px;
  border-radius: 8px;
  background: #f3f3f3;
  font-weight: 600;
}

.withdrawal-progress__step.active {
  background: #000;
  color: #fff;
}

#withdrawal-form h2 {
  margin-bottom: 25px;
}

#withdrawal-form input[type="text"],
#withdrawal-form input[type="email"] {
  width: 100%;
  height: 50px;
  padding: 0 15px;
  margin-bottom: 15px;
  border: 1px solid #ddd;
  border-radius: 8px;
}

#withdrawal-form button {
  width: 100%;
  height: 50px;
  border: 0;
  border-radius: 8px;
  background: #000;
  color: #fff;
  cursor: pointer;
  font-weight: 600;
}

#withdrawal-form button:hover {
  opacity: .9;
}

.order-review {
  background: #f8f8f8;
  border: 1px solid #e5e5e5;
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
}

.order-review p {
  margin: 0 0 15px;
}

.withdraw-checkbox {
  display: flex;
  gap: 10px;
  margin-bottom: 25px;
}

.withdraw-actions {
  display: flex;
  gap: 15px;
}

.btn-secondary {
  background: #e5e5e5 !important;
  color: #000 !important;
}

.withdraw-success {
  padding: 16px;
  margin-bottom: 20px;
  background: #e8f8ec;
  border: 1px solid #7bc67e;
  border-radius: 8px;
}

.withdraw-error {
  padding: 16px;
  margin-bottom: 20px;
  background: #fff1f1;
  border: 1px solid #ff6b6b;
  border-radius: 8px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {

  const continueBtn = document.getElementById('continue-btn');
  const backBtn = document.getElementById('back-btn');

  continueBtn.addEventListener('click', function() {

    const orderNumber = document.getElementById('order_number').value.trim();
    const email = document.getElementById('email').value.trim();
    const firstName = document.getElementById('first_name').value.trim();
    const lastName = document.getElementById('last_name').value.trim();

    if (!orderNumber || !email || !firstName || !lastName) {
      alert('Please complete all required fields.');
      return;
    }

    document.getElementById('review-order-number').textContent = orderNumber;
    document.getElementById('review-email').textContent = email;
    document.getElementById('review-first-name').textContent = firstName;
    document.getElementById('review-last-name').textContent = lastName;

    document.getElementById('contact_order_number').value = orderNumber;
    document.getElementById('contact_email').value = email;
    document.getElementById('contact_first_name').value = firstName;
    document.getElementById('contact_last_name').value = lastName;

    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';

    document.getElementById('progress-step-2').classList.add('active');
  });

  backBtn.addEventListener('click', function() {

    document.getElementById('step2').style.display = 'none';
    document.getElementById('step1').style.display = 'block';

    document.getElementById('progress-step-2').classList.remove('active');
  });

});
</script>