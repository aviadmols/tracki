{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .contact-form .field__input{
    border: 1px solid var(--Bgr-dark, #394045);
  }
  .contact-form .field__input::-webkit-input-placeholder { /* Chrome/Opera/Safari */
color: #7E878D;
}
.contact-form .field__input::-moz-placeholder { /* Firefox 19+ */
color: #7E878D;
}
.contact-form .field__input:-ms-input-placeholder { /* IE 10+ */
color: #7E878D;
}
.contact-form .field__input:-moz-placeholder { /* Firefox 18- */
color: #7E878D;
}
.contact-form .contact__button .button{
  background: var(--Bgr-dark, #394045);
  border: var(--Bgr-dark, #394045);
  color: var(--Text-Dark, #25282A);
  font-size: 14px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  letter-spacing: 2.1px;
  text-transform: uppercase;
}
.contact-form .rte p
 {
    color: var(--Text-Grey, #7E878D);
    font-size: 16px;
    font-style: normal;
    font-weight: 450;
    line-height: normal;
    text-decoration: none; /* optional: remove underline from links */
}
.contact-form .rte a{
  color: var(--Text-Grey, #7E878D);
  font-size: 16px;
  font-style: normal;
  font-weight: 450;
  line-height: normal;
  text-decoration-line: underline;
  text-decoration-style: solid;
  text-decoration-skip-ink: auto;
  text-decoration-thickness: auto;
  text-underline-offset: auto;
  text-underline-position: from-font;
}
.contact__list > li:first-child a.link {
  color: #f3f1f0 !important;
}
/* Default border is your existing style */
.contact-form .field__input {
  border: 1px solid var(--Bgr-dark, #394045);
  transition: border-color 0.3s ease; /* smooth transition */
}

/* When user types something */
.contact-form .field__input.filled {
  border-color: #f3f1f0; /* Active border color */
}
.contact-form .contact__button .button.enabled {
    background: var(--Green-light, #76C773);
    color: var(--Text-Dark, #25282A);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 2.1px;
    text-transform: uppercase;
    min-width: 378px;
    padding: 16px 20px;
    margin: 0;
    display: inline-block;
    text-align: center;
    transition: all .3s;
    text-decoration: none;
    min-height: unset;
}
/* Optional: focus state for better UX */
/* .contact-form .field__input:focus {
  border-color: #f3f1f0;
  outline: none; /* remove default focus outline */
} */
.contact__subheading {
  color: var(--Text-Grey, #7E878D);
  font-size: 16px;
  font-weight: 450;
  line-height: 1.5;
  max-width: 640px;
  margin: 12px 0 0;
}
/* selectors need one extra class to outrank section-contact-form.css, which loads after this block */
.contact .contact__list--with-call {
  row-gap: 2.8rem;
}
/* the card is too tall to sit in the 2-across grid the stylesheet uses under 750px */
.contact .contact__list--with-call > li {
  flex: 0 0 100%;
}
/* thin rule between the plain contact blocks - the call card brings its own border */
.contact__list--with-call > li + li:not(.contact__call) {
  border-top: 1px solid rgba(243, 241, 240, 0.14);
  padding-top: 2.8rem;
}
.contact__list .contact__rows {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 0;
}
.contact__list .contact__row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.contact__list .contact__row-icon {
  display: flex;
  flex: none;
  color: var(--Green-light, #76C773);
}
.contact__list .contact__row-icon svg {
  width: 20px;
  height: 20px;
}
.contact__list .contact__call {
  border-radius: 16px;
  border: 1px solid rgba(118, 199, 115, 0.55);
  background: rgba(118, 199, 115, 0.06);
  box-shadow: 0 0 24px rgba(118, 199, 115, 0.28);
  padding: 24px;
}
.contact__list .contact__call-head {
  display: flex;
  align-items: center;
  gap: 16px;
}
.contact__list .contact__call-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(118, 199, 115, 0.16);
  color: var(--Green-light, #76C773);
}
.contact__list .contact__call-badge svg {
  width: 36px;
  height: 36px;
}
.contact__list .contact__call-head .h3 {
  margin-bottom: 6px;
}
.contact__list .contact__call-text {
  color: #C4CCC8;
  font-size: 16px;
  font-weight: 450;
  line-height: 1.4;
  margin: 0;
}
.contact__list .contact__call-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  margin-top: 20px;
  padding: 14px 24px;
  border-radius: 999px;
  background: var(--Green-light, #76C773);
  box-shadow: 0 2px 12px rgba(118, 199, 115, 0.45);
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.3;
  text-decoration: none;
  transition: all .3s;
}
.contact__list .contact__call-btn:hover {
  background: #5FB35C;
  color: #fff;
}
.contact__list .contact__call-btn svg {
  width: 20px;
  height: 20px;
  flex: none;
}
.contact__list .contact__call-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  color: var(--Text-Grey, #7E878D);
  font-size: 15px;
  font-weight: 450;
  line-height: 1.2;
}
.contact__list .contact__call-note svg {
  width: 15px;
  height: 15px;
  flex: none;
}
{%- endstyle -%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- assign custom_fields = section.blocks | where: "type", "custom_field" -%}
{%- assign call_blocks = section.blocks | where: "type", "click-to-call" -%}
<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="contact page-width{% unless section.blocks.size > 0 and section.blocks.size > custom_fields.size %} page-width--inner{% endunless %}">
    {%- if section.blocks.size > 0 and section.blocks.size > custom_fields.size -%}
      <div class="flex-grid">
        <div class="flex-grid__item flex-grid__item--two-third">
    {%- endif -%}

      <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %}">
        <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        {%- if section.settings.subheading != blank -%}
          <p class="contact__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      
      <form-state>
        {%- assign form_id = 'ContactForm-' | append: section.id -%}
        {%- assign return_url = section.settings.return_url | default: 'back' | append: '' -%}
        {%- form 'contact', id: form_id, return_to: return_url -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {% render 'icon', icon: 'success' %}
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input id="{{ form_id }}-name" class="field__input" autocomplete="name" type="text" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}"/>
              <label class="visually-hidden" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
            </div>
            <div class="field field--with-error">
              <input
                id="{{ form_id }}-email"
                autocomplete="email"
                type="email"
                id="ContactForm-email-{{ section.id }}"
                class="field__input required{% if form.errors contains 'email' %} invalid{% endif %}"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error-{{ section.id }}"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
                required="required"
              />
              <label class="visually-hidden" for="{{ form_id }}-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
              {%- if form.errors contains 'email' -%}
                <small id="ContactForm-email-error-{{ section.id }}">
                  <span class="form__message errors">
                    {% render 'icon', icon: 'error' %}
                    {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                  </span>
                </small>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.show_phone -%}
            <div class="field">
              {% comment %} <input id="{{ form_id }}-phone" type="tel" class="field__input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="{{ 'templates.contact.form.phone' | t }}"/> {% endcomment %}
              {%- if section.settings.show_phone -%}
                <div class="field">
                  <input 
                    id="{{ form_id }}-phone" 
                    type="tel" 
                    class="field__input" 
                    autocomplete="tel" 
                    name="contact[{{ 'templates.contact.form.phone' | t }}]" 
                    pattern="^\+?[0-9\s\-]*$" 
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" 
                    placeholder="{{ 'templates.contact.form.phone' | t }}"
                  />
                  <label class="visually-hidden" for="{{ form_id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
                </div>
              {%- endif -%}
              <label class="visually-hidden" for="{{ form_id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
            </div>
          {%- endif -%}

          {%- if custom_fields.size > 0 -%}
            {%- for block in custom_fields -%}
              <div class="field contact-form__input" {{ block.shopify_attributes }}>
                {%- if block.settings.type == 'checkbox' -%}
                  <label for="line-item-{{ section.id }}-{{ block.id }}" class="form__facet-checkbox">
                    <input type="hidden" name="contact[{{ block.settings.label | escape }}]" value="{{ block.settings.unchecked_value | escape }}" />
                    <input id="line-item-{{ section.id }}-{{ block.id }}" type="checkbox" name="contact[{{ block.settings.label | escape }}]" value="{{ block.settings.checked_value | escape }}"{% if block.settings.required %} required{% endif %} />
                    {% render 'icon', icon: 'checkmark' %}
                    {{ block.settings.label | escape }}
                  </label>
                {%- else -%}
                  <label class="form__label{% if block.settings.type == 'text' or block.settings.type == 'textarea' or block.settings.type == 'select' %} visually-hidden{% endif %}" for="line-item-{{ section.id }}-{{ block.id }}">{{ block.settings.label | escape }}</label>
                  {%- case block.settings.type -%}
                    {%- when 'text' -%}
                      <input class="field__input" id="line-item-{{ section.id }}-{{ block.id }}" type="text" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %} placeholder="{{ block.settings.label | escape }}" />
                    {%- when 'textarea' -%}
                      <textarea class="text-area field__input" id="line-item-{{ section.id }}-{{ block.id }}" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %} placeholder="{{ block.settings.label | escape }}"></textarea>
                    {%- when 'radio' -%}
                      {%- assign options = block.settings.radio_options | split: ',' -%}
                      {%- if options.size > 1 -%}
                        <fieldset class="contact-form__input">
                          {%- for option in options -%}
                            <label class="form__facet-radio" for="line-item-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}">
                              <input id="line-item-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}" type="radio" name="contact[{{ block.settings.label | escape }}]" value="{{ option | strip | escape }}"{% if block.settings.required %} required{% endif %} />
                              <span class="icon"></span>
                              {{ option | strip | escape }}
                            </label>
                          {%- endfor -%}
                        </fieldset>
                      {%- endif -%}
                    {%- when 'select' -%}
                      {%- assign options = block.settings.select_options | split: ',' -%}
                      {%- if options.size > 1 -%}
                        <select-wrapper class="select">
                          <select class="select__select" id="line-item-{{ section.id }}-{{ block.id }}" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %}>
                            <option value="" disabled selected hidden>{{ block.settings.label | escape }}</option>
                            <optgroup label="{{ block.settings.label | escape }}">
                              {%- for option in options -%}
                                <option value="{{ option | strip | escape }}">
                                  {{ option | strip | escape }}
                                </option>
                              {%- endfor -%}
                            </optgroup>
                          </select>
                          {% render 'icon', icon: 'caret' %}
                        </select-wrapper>
                      {%- endif -%}
                  {%- endcase-%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="field">
            <textarea
              id="{{ form_id }}-body"
              rows="10"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
            >
              {{- form.body -}}
            </textarea>
            <label class="visually-hidden" for="{{ form_id }}-body">{{ 'templates.contact.form.comment' | t }}</label>
          </div>
          <div class="contact__button">
            <button type="submit" class="button">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>

          {% comment %}
            Remove the following three lines of code to remove the note
            about being protected by Google's reCAPTCHA service.
            By removing it, the small reCAPTCHA widget will appear in the
            bottom right corner of the page.
          {% endcomment %}
          <div class="rte">
            {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
          </div>
        {%- endform -%}
      </form-state>

    {%- if section.blocks.size > 0 and section.blocks.size > custom_fields.size -%}
        </div>
        <div class="flex-grid__item flex-grid__item--one-third">
          <ul class="contact__list list-unstyled{% if call_blocks.size > 0 %} contact__list--with-call{% endif %}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'click-to-call' -%}
                <li class="contact__call" {{ block.shopify_attributes }}>
                  <div class="contact__call-head">
                    <span class="contact__call-badge">
                      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <g transform="translate(-2.2 7.3) scale(1.35)" fill="currentColor" stroke="none">
                          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.53.57 1 1 0 011 1v3.5a1 1 0 01-1 1A19.95 19.95 0 012 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.53 1 1 0 01-.21 1.11l-2.2 2.2z"/>
                        </g>
                        <g stroke-width="1.7">
                          <circle cx="23" cy="16.5" r="6"/>
                          <path d="M17 16.5h12"/>
                          <path d="M23 10.5c2.1 1.8 3.4 3.4 3.4 6s-1.3 4.2-3.4 6c-2.1-1.8-3.4-3.4-3.4-6s1.3-4.2 3.4-6z"/>
                        </g>
                        <g stroke-width="2.4">
                          <path d="M25.5 7.3A9.5 9.5 0 0 1 31.6 12.5"/>
                          <path d="M26.4 3.9A13 13 0 0 1 34.8 11"/>
                        </g>
                      </svg>
                    </span>
                    <div class="contact__call-copy">
                      <p class="h3">{{ block.settings.heading | escape }}</p>
                      {%- if block.settings.text != blank -%}
                        <p class="contact__call-text">{{ block.settings.text | escape }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                  {%- if block.settings.btn_text != blank -%}
                    <a class="contact__call-btn" href="{{ block.settings.btn_link | default: '#' }}">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.53.57 1 1 0 011 1v3.5a1 1 0 01-1 1A19.95 19.95 0 012 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.53 1 1 0 01-.21 1.11l-2.2 2.2z"/>
                      </svg>
                      {{ block.settings.btn_text | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.note != blank -%}
                    <span class="contact__call-note">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <rect x="4" y="10" width="16" height="11" rx="2.5"/>
                        <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                      </svg>
                      {{ block.settings.note | escape }}
                    </span>
                  {%- endif -%}
                </li>
              {%- elsif block.type == 'contact' -%}
                <li {{ block.shopify_attributes }}>
                  <p class="h3">{{ block.settings.heading | escape }}</p>
                  {%- capture contact_rows -%}{{ block.settings.text }}~^~{{ block.settings.link }}~|~{{ block.settings.text2 }}~^~{{ block.settings.link2 }}~|~{{ block.settings.text3 }}~^~{{ block.settings.link3 }}~|~{{ block.settings.text4 }}~^~{{ block.settings.link4 }}~|~{{ block.settings.text5 }}~^~{{ block.settings.link5 }}{%- endcapture -%}
                  {%- assign contact_rows = contact_rows | split: '~|~' -%}
                  <ul class="contact__rows list-unstyled">
                    {%- for contact_row in contact_rows -%}
                      {%- assign row_parts = contact_row | split: '~^~' -%}
                      {%- assign row_text = row_parts[0] | strip -%}
                      {%- assign row_link = row_parts[1] | strip -%}
                      {%- if row_text != blank -%}
                        <li class="contact__row">
                          {%- if row_link contains 'mailto:' -%}
                            <span class="contact__row-icon">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <rect x="2.5" y="5" width="19" height="14" rx="1.5"/>
                                <path d="M2.5 6.5 12 13.5l9.5-7"/>
                              </svg>
                            </span>
                          {%- elsif row_link contains 'tel:' -%}
                            <span class="contact__row-icon">
                              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.53.57 1 1 0 011 1v3.5a1 1 0 01-1 1A19.95 19.95 0 012 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.53 1 1 0 01-.21 1.11l-2.2 2.2z"/>
                              </svg>
                            </span>
                          {%- endif -%}
                          {%- if row_link != blank -%}
                            <a class="link" href="{{ row_link }}">{{ row_text | escape }}</a>
                          {%- else -%}
                            <span>{{ row_text | escape }}</span>
                          {%- endif -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </li>
              {%- elsif block.type == 'media' -%}
                <li {{ block.shopify_attributes }}>
                  <p class="h3">{{ block.settings.heading | escape }}</p>
                  <ul class="list-unstyled list-social" role="list">
                    {%- render 'social-icons' -%}
                  </ul>
                </li>
              {%- endif -%}
            {%- endfor -%}
            
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {

  const inputs = document.querySelectorAll(".contact-form .field__input");

  function checkInput() {
    inputs.forEach(input => {
      if (input.value.trim() !== "") {
        input.classList.add("filled");
      } else {
        input.classList.remove("filled");
      }
    });
  }

  inputs.forEach(input => {
    input.addEventListener("input", checkInput);
  });

});
document.addEventListener("DOMContentLoaded", function () {

  const inputs = document.querySelectorAll(".contact-form .field__input");
  const button = document.querySelector(".contact-form .contact__button .button");

  function checkForm() {
    let allFilled = true;

    inputs.forEach(input => {
      if (input.value.trim() !== "") {
        input.classList.add("filled"); // change border color
      } else {
        input.classList.remove("filled");
        allFilled = false;
      }
    });

    // Enable button if all fields are filled
    if (button) {
      if (allFilled) {
        button.classList.add("enabled");
        button.removeAttribute("disabled");
      } else {
        button.classList.remove("enabled");
        button.setAttribute("disabled", "true");
      }
    }
  }

  // Listen for input in all fields
  inputs.forEach(input => {
    input.addEventListener("input", checkForm);
  });

  // Initial check in case form is prefilled
  checkForm();

});
</script>
{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "url",
      "id": "return_url",
      "label": "t:sections.all.form.return_url.label",
      "info": "t:sections.all.form.return_url.info"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "default": true,
      "label": "t:sections.contact-form.settings.show_phone.label"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": false,
      "label": "t:sections.all.show_divider.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Get in touch",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
