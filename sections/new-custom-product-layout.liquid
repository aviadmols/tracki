<section class="broadcast-product">
  <div class="broadcast-wrapper">

    <!-- Product Images -->
    <div class="product-gallery">
      {% for image in product.images %}
        <div class="gallery-item">
          <img
            src="{{ image | image_url: width: 1200 }}"
            alt="{{ image.alt | escape }}">
        </div>
      {% endfor %}
    </div>

    <!-- Product Information -->
    <div class="product-sidebar">

      {% if section.settings.badge != blank %}
        <div class="product-badge">
          {{ section.settings.badge }}
        </div>
      {% endif %}

      <h1 class="product-title">
        {{ product.title }}
      </h1>

      <div class="product-price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < section.settings.inventory_limit %}
        <div class="inventory">
          <span class="inventory-dot"></span>
          {{ section.settings.inventory_text }}
        </div>
      {% endif %}

      <!-- Variant Options -->
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="option-block">

            <div class="option-title">
              {{ option.name }}
            </div>

            <div class="option-values">
              {% for value in option.values %}
                <button type="button" class="swatch">
                  {{ value }}
                </button>
              {% endfor %}
            </div>

          </div>
        {% endfor %}
      {% endunless %}

      <!-- Sale Banner -->
      {% if section.settings.sale_text != blank %}
        <div class="sale-box">
          <div class="sale-title">
            {{ section.settings.sale_text }}
          </div>

          <div class="countdown">
            <div>
              <strong>08</strong>
              <span>Days</span>
            </div>

            <div>
              <strong>10</strong>
              <span>Hours</span>
            </div>

            <div>
              <strong>10</strong>
              <span>Minutes</span>
            </div>

            <div>
              <strong>36</strong>
              <span>Seconds</span>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- Accordion -->

      <div class="accordion">

        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.heading }}
              </summary>

              <div class="accordion-content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}

      </div>

      <!-- Features -->

      <div class="features">

        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature-item" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}

      </div>

      <!-- Size Guide -->

      {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %}

      <!-- Add To Cart -->

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="purchase-row">

          <div class="qty-box">
            <button type="button" class="qty-minus">−</button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1">

            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="add-cart">
            {{ section.settings.button_text }}
            —
            {{ product.price | money }}
          </button>

        </div>

      {% endform %}

      <!-- Complete The Look -->

      {% if section.settings.complete_product != blank %}

        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete-look">

          <h4>
            {{ section.settings.complete_heading }}
          </h4>

          <div class="look-card">

            <img
              src="{{ cp.featured_image | image_url: width: 200 }}"
              alt="{{ cp.title }}">

            <div>
              <div class="look-title">
                {{ cp.title }}
              </div>

              <div class="look-price">
                {{ cp.price | money }}
              </div>
            </div>

          </div>

        </div>

      {% endif %}

      <!-- Styling Help -->

      {% if section.settings.help_text != blank %}
        <div class="styling-help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>

  </div>
</section>

<style>
    .broadcast-wrapper {
    max-width: 1180px;
    margin: auto;
    padding: 20px;
    display: grid;
    grid-template-columns: 620px 360px;
    gap: 30px;
    justify-content: center;
}

.product-gallery {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gallery-item img {
    width: 100%;
    display: block;
    background: #f5f3f1;
}

.product-sidebar {
    position: sticky;
    top: 20px;
    align-self: start;
}

.product-badge {
    display: inline-block;
    background: #726458;
    color: #fff;
    font-size: 10px;
    padding: 5px 8px;
    margin-bottom: 10px;
}

.product-title {
    font-size: 18px;
    text-transform: uppercase;
    margin: 0 0 8px;
}

.product-price {
    font-size: 13px;
    margin-bottom: 15px;
}

.inventory {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ddd;
    font-size: 12px;
    color: #777;
}

.inventory-dot {
    width: 10px;
    height: 10px;
    border: 1px solid #d0a847;
    border-radius: 50%;
}

.option-block {
    margin: 20px 0;
}

.option-title {
    font-size: 12px;
    margin-bottom: 10px;
}

.color-swatches {
    display: flex;
    gap: 8px;
}

.swatch {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid #ccc;
    background: gold;
}

.option-value {
    font-size: 11px;
    margin-top: 8px;
    color: #777;
}

.sale-box {
    background: #e7d5c7;
    text-align: center;
    padding: 20px;
    margin-bottom: 20px;
}

.sale-title {
    font-size: 12px;
    margin-bottom: 10px;
}

.countdown {
    display: flex;
    justify-content: center;
    gap: 20px;
}

.countdown strong {
    display: block;
    font-size: 22px;
}

.countdown span {
    font-size: 10px;
}

.accordion {
    border-top: 1px solid #ddd;
}

.accordion details {
    border-bottom: 1px solid #ddd;
}

.accordion summary {
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
}

.accordion summary::-webkit-details-marker {
    display: none;
}

.accordion summary::after {
    content: "+";
    float: right;
}

.accordion-content {
    padding-bottom: 15px;
    font-size: 13px;
    color: #666;
}

.features {
    padding: 20px 0;
}

.feature-item {
    margin-bottom: 10px;
    font-size: 13px;
    color: #666;
}

.size-guide {
    padding-bottom: 20px;
    border-bottom: 1px solid #ddd;
}

.purchase-row {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.qty-box {
    width: 62px;
    height: 40px;
    border: 1px solid #ddd;
    border-radius: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
}

.qty-box input {
    width: 20px;
    border: none;
    text-align: center;
}

.qty-box button {
    border: none;
    background: transparent;
    cursor: pointer;
}

.add-cart {
    flex: 1;
    border: none;
    border-radius: 24px;
    background: #000;
    color: #fff;
    height: 40px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.complete-look {
    margin-top: 25px;
    border-top: 1px solid #ddd;
    padding-top: 20px;
}

.complete-look h4 {
    font-size: 12px;
    margin-bottom: 15px;
}

.look-card {
    display: flex;
    gap: 12px;
    background: #f5f3f1;
    padding: 15px;
}

.look-card img {
    width: 70px;
}

.look-title {
    font-size: 13px;
}

.look-price {
    font-size: 12px;
    color: #777;
    margin-top: 5px;
}

.styling-help {
    margin-top: 25px;
    border-top: 1px solid #ddd;
    padding-top: 20px;
}

.styling-help strong {
    font-size: 13px;
}

.styling-help p {
    font-size: 12px;
    color: #666;
}

@media (max-width: 991px) {
    .broadcast-wrapper {
        grid-template-columns: 1fr;
    }

    .product-sidebar {
        position: static;
    }

    .purchase-row {
        flex-direction: column;
    }

    .qty-box {
        width: 100%;
        justify-content: center;
        gap: 20px;
    }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const minus = document.querySelector(".qty-minus");
  const plus = document.querySelector(".qty-plus");
  const input = document.querySelector(".qty-box input");

  if (minus && plus && input) {

    minus.addEventListener("click", function () {
      if (parseInt(input.value) > 1) {
        input.value = parseInt(input.value) - 1;
      }
    });

    plus.addEventListener("click", function () {
      input.value = parseInt(input.value) + 1;
    });

  }
});
</script>

{% schema %}
{
  "name": "New Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "PRE ORDER"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Low stock available"
    },
    {
      "type": "range",
      "id": "inventory_limit",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Inventory Limit"
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Sale Text",
      "default": "Our seasonal sale ends soon"
    },
    {
      "type": "richtext",
      "id": "size_guide",
      "label": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Pre Order"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_heading",
      "label": "Complete Look Heading",
      "default": "Complete The Look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Custom Product Layout"
    }
  ]
}
{% endschema %}