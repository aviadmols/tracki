<div class="custom-image-banner">
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag:
      loading: 'lazy',
      class: 'banner-image'
    }}
  {% endif %}

  <div class="banner-overlay">
    <div class="banner-content">
      <h2>{{ section.settings.heading }}</h2>
      <div class="banner-text">
        {{ section.settings.text }}
      </div>
    </div>
  </div>
</div>

<style>
.custom-image-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.banner-image {
  display: block;
  width: 100%;
  height: 650px;
  object-fit: cover;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20px;
}

.banner-content {
  max-width: 700px;
  color: #f3f1f0;
}

.banner-content h2 {
  margin: 0 0 20px;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.1;
  text-transform: uppercase;
  color: #f3f1f0;
}

.banner-text {
  font-size: 16px;
  line-height: 1.5;
  color: #f3f1f0;
}

.banner-text p {
  margin: 0;
}

@media screen and (max-width: 1024px) {
  .banner-image {
    height: 500px;
  }

  .banner-content h2 {
    font-size: 42px;
  }

  .banner-text {
    font-size: 20px;
  }
}

@media screen and (max-width: 749px) {
  .banner-image {
    height: 400px;
  }

  .banner-content h2 {
    font-size: 30px;
  }

  .banner-text {
    font-size: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Image Banner Overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECYCLED MATERIALS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>We partner with high quality jewellers who only use recycled gold, AAA-grade gemstones, and ethically sourced diamonds.</p>"
    }
  ],
  "presets": [
    {
      "name": "Image Banner Overlay"
    }
  ]
}
{% endschema %}