<div class="announcement-marquee" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="announcement-track">
    {% for i in (1..10) %}
      {% for block in section.blocks %}
        <span class="announcement-item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {% else %}
            {{ block.settings.text }}
          {% endif %}
          <span class="separator">•</span>
        </span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<style>
.announcement-marquee {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  padding: 14px 0;
}

.announcement-track {
  display: flex;
  align-items: center;
  width: max-content;
  animation: marquee {{ section.settings.speed }}s linear infinite;
}

.announcement-item {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 16px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.announcement-item a {
  color: inherit;
  text-decoration: none;
}

.separator {
  margin: 0 30px;
}
/* Desktop */
@media screen and (min-width: 1200px) {
  .announcement-item {
    font-size: 16px;
  }

  .separator {
    margin: 0 30px;
  }
}

/* Tablet */
@media screen and (max-width: 991px) {
  .announcement-marquee {
    padding: 12px 0;
  }

  .announcement-item {
    font-size: 14px;
    letter-spacing: 0.3px;
  }

  .separator {
    margin: 0 20px;
  }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .announcement-marquee {
    padding: 10px 0;
  }

  .announcement-item {
    font-size: 12px;
    letter-spacing: 0.2px;
  }

  .separator {
    margin: 0 15px;
  }
}

/* Small Mobile */
@media screen and (max-width: 480px) {
  .announcement-item {
    font-size: 11px;
  }

  .separator {
    margin: 0 12px;
  }
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-10%);
  }
}
</style>

{% schema %}
{
  "name": "Announcement Marquee",
  "tag": "section",
  "class": "announcement-marquee-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING ON ORDERS OVER $200"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Marquee",
      "blocks": [
        {
          "type": "announcement"
        },
        {
          "type": "announcement"
        },
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}