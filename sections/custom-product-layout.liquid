<section class="custom-product">

  <div class="custom-product__grid">

    <!-- LEFT IMAGES -->
    <div class="custom-product__media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1400 }}"
          class="main-image"
        >
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1400 }}"
          class="sub-image"
        >
      {% endif %}
    </div>

    <!-- RIGHT INFO -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">{{ section.settings.badge }}</div>
      {% endif %}

      <h1 class="title">{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
  <div class="inventory">
    <span class="dot"></span>
    {{ section.settings.inventory_text }}
  </div>
{% endif %}

      <!-- VARIANTS -->
      {% unless product.has_only_default_variant %}
        <div class="variants">
          {% for option in product.options_with_values %}
            <div class="option-group">
              <label>{{ option.name }}</label>

              <div class="swatches">
                {% for value in option.values %}
                  <button
                    class="swatch"
                    type="button"
                    data-value="{{ value }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- ACCORDION -->
      <div class="accordion">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>{{ block.settings.title }}</summary>
              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      <!-- FEATURES -->
      <div class="features">
        {% for block in section.blocks %}
           {% if block.type == 'feature' %}
    <div class="feature">
      {% if block.settings.icon %}
        <img
          src="{{ block.settings.icon | image_url: width: 40 }}"
          alt=""
          class="feature-icon"
          width="18"
          height="18"
        >
      {% endif %}

      <span>{{ block.settings.text }}</span>
    </div>
  {% endif %}
        {% endfor %}
      </div>

      <!-- SIZE GUIDE -->
      {% comment %} {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %} {% endcomment %}

      <!-- ADD TO CART -->
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button" class="qty-minus">-</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }} — {{ product.price | money }}
          </button>

        </div>
      {% endform %}

      <!-- COMPLETE LOOK -->
{% if section.settings.complete_products != blank %}

<div class="complete">
  <h3>{{ section.settings.complete_title }}</h3>

  <div class="complete-slider" id="complete-slider">

    {% for cp in section.settings.complete_products %}
      <a href="{{ cp.url }}" class="complete-card">

        <img
          src="{{ cp.featured_image | image_url: width: 200 }}"
          alt="{{ cp.title }}"
        >

        <div class="complete-info">
          <p>{{ cp.title }}</p>
          <span>{{ cp.price | money }}</span>
        </div>

      </a>
    {% endfor %}

  </div>

  <div class="complete-dots">
    {% for cp in section.settings.complete_products %}
      <span class="{% if forloop.first %}active{% endif %}"></span>
    {% endfor %}
  </div>

</div>

{% endif %}
      <!-- HELP -->
      {% if section.settings.help_text != blank %}
        <div class="help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>
  </div>
</section>
<style>
   .custom-product {
  background: #f3f1f0;
  color: #25282a;
}

/* GRID */
.custom-product__grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
  background: #f3f1f0;
}

/* IMAGES */
.custom-product__media {
  background: #f3f1f0;
}

.main-image,
.sub-image {
  width: 100%;
  display: block;
  background: #f3f1f0;
}

/* BADGE */
.badge {
  display: inline-block;
  padding: 4px 10px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid #25282a;
  color: #25282a;
  background: transparent;
  margin-bottom: 12px;
}

/* TITLE */
.title {
  font-size: 28px;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: #25282a;
  margin-bottom: 10px;
}

/* PRICE */
.price {
  font-size: 18px;
  font-weight: 400;
  color: #25282a;
  margin-bottom: 18px;
}

/* INVENTORY */
.inventory {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #25282a;
  margin-bottom: 25px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1px solid #c9a24a;
}

/* VARIANTS */
.option-group label {
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #555;
}

.swatches {
  display: flex;
  gap: 10px;
  margin-top: 8px;
}

.swatch {
  border: 1px solid #ddd;
  background: #f3f1f0;
  color: #25282a;
  padding: 6px 14px;
  font-size: 13px;
  cursor: pointer;
  transition: 0.2s;
}

.swatch:hover {
  border-color: #25282a;
}

/* ACCORDION */
.accordion details {
  {% comment %} border-top: 1px solid #eee; {% endcomment %}
  padding: 14px 0;
  color: #25282a;
}

.accordion summary {
  cursor: pointer;
  font-size: 13px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #25282a;
}

.accordion .content {
  padding-top: 10px;
  font-size: 13px;
  color: #555;
  line-height: 1.6;
}

/* FEATURES */
.features {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  color: #555;
}
.feature {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feature-icon {
  width: 18px;
  height: 18px;
  object-fit: contain;
  flex-shrink: 0;
}
/* SIZE GUIDE */
.size-guide {
  margin-top: 18px;
  font-size: 13px;
  color: #25282a;
  border-bottom: 1px solid #eee;
  padding-bottom: 15px;
}

/* BUY ROW */
.buy-row {
  display: flex;
  gap: 12px;
  margin-top: 25px;
}

/* QTY */
.qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid #ddd;
  width: 120px;
  padding: 8px 10px;
  background: #f3f1f0;
}

.qty input {
  width: 40px;
  border: none;
  text-align: center;
  font-size: 14px;
  background: transparent;
}

.qty button {
  border: none;
  background: transparent;
  font-size: 16px;
  cursor: pointer;
  color: #25282a;
}

/* ADD TO CART */
.atc-btn {
  flex: 1;
  background: #25282a;
  color: #fff;
  border: none;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 14px;
  cursor: pointer;
  transition: 0.3s;
}

.atc-btn:hover {
  background: #25282a;
}

.complete {
  margin-top: 30px;
  border-top: 1px solid #eee;
  padding-top: 20px;
}

.complete h3 {
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin-bottom: 15px;
  color: #25282a;
}

.complete-slider {
  display: flex;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

.complete-card {
  flex: 0 0 100%;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 15px;
  background: #f5f3ef;
  padding: 14px;
  box-sizing: border-box;
  text-decoration: none;
  color: inherit;
}

.complete-card:hover {
  color: inherit;
  text-decoration: none;
}

.complete-card img {
  width: 70px;
  height: 70px;
  object-fit: cover;
}

.complete-info {
  flex: 1;
}

.complete-info p {
  margin: 0;
  font-size: 16px;
  color: #25282a;
}

.complete-info span {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  color: #666;
}

.complete-icon {
  width: 30px;
  height: 30px;
  border: 1px solid #ddd;
  border-radius: 50%;
  background: #f3f1f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.complete-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 15px;
}

.complete-dots span {
  width: 7px;
  height: 7px;
  background: #ccc;
  border-radius: 50%;
  cursor: pointer;
}

.complete-dots span.active {
  background: #25282a;
}

/* HELP */
.help {
  margin-top: 25px;
  font-size: 13px;
  color: #666;
  border-top: 1px solid #eee;
  padding-top: 20px;
}

/* MOBILE */
/* =========================
   TABLET (991px)
========================= */
@media screen and (max-width: 991px) {

  .custom-product__grid {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 40px 20px;
  }

  .title {
    font-size: 24px;
  }

  .price {
    font-size: 16px;
  }

  .buy-row {
    flex-direction: column;
  }

  .qty {
    width: 100%;
  }

  .atc-btn {
    width: 100%;
  }

  .complete-card {
    padding: 12px;
  }
}


/* =========================
   MOBILE (767px)
========================= */
@media screen and (max-width: 767px) {

  .custom-product__grid {
    padding: 30px 15px;
    gap: 30px;
  }

  .badge {
    font-size: 10px;
    padding: 4px 8px;
  }

  .title {
    font-size: 22px;
    line-height: 1.3;
  }

  .price {
    font-size: 16px;
    margin-bottom: 15px;
  }

  .inventory {
    font-size: 12px;
    margin-bottom: 20px;
  }

  .option-group label {
    font-size: 11px;
  }

  .swatches {
    flex-wrap: wrap;
    gap: 8px;
  }

  .swatch {
    padding: 8px 12px;
    font-size: 12px;
  }

  .accordion summary {
    font-size: 12px;
  }

  .accordion .content,
  .features,
  .help,
  .size-guide {
    font-size: 12px;
  }

  .feature-icon {
    width: 16px;
    height: 16px;
  }

  .buy-row {
    flex-direction: column;
    gap: 10px;
  }

  .qty {
    width: 100%;
    height: 48px;
  }

  .atc-btn {
    width: 100%;
    padding: 14px;
    font-size: 12px;
  }

  .complete-card {
    gap: 12px;
    padding: 12px;
  }

  .complete-card img {
    width: 60px;
    height: 60px;
  }

  .complete-info p {
    font-size: 13px;
  }

  .complete-info span {
    font-size: 12px;
  }

  .complete-icon {
    width: 26px;
    height: 26px;
    font-size: 16px;
  }
}


/* =========================
   SMALL MOBILE (480px)
========================= */
@media screen and (max-width: 480px) {

  .custom-product__grid {
    padding: 20px 12px;
  }

  .title {
    font-size: 20px;
  }

  .price {
    font-size: 15px;
  }

  .complete-card {
    padding: 10px;
  }

  .complete-card img {
    width: 55px;
    height: 55px;
  }

  .complete-info p {
    font-size: 12px;
  }

  .complete-info span {
    font-size: 11px;
  }

  .complete-dots {
    margin-top: 12px;
  }

  .complete-dots span {
    width: 6px;
    height: 6px;
  }
}
</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
document.addEventListener('DOMContentLoaded', function () {

  const slider = document.getElementById('complete-slider');

  if (!slider) return;

  const dots = document.querySelectorAll('.complete-dots span');

  function goToSlide(index) {
    slider.scrollTo({
      left: slider.offsetWidth * index,
      behavior: 'smooth'
    });

    dots.forEach(function(dot) {
      dot.classList.remove('active');
    });

    dots[index].classList.add('active');
  }

  dots.forEach(function(dot, index) {
    dot.addEventListener('click', function() {
      goToSlide(index);
    });
  });

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product_list",
      "id": "complete_products",
      "label": "Complete Look Products"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}