
<section class="custom-product">

  <div class="custom-product__grid">

    <!-- LEFT SIDE -->
    <div class="custom-product__media">

      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1600 }}"
          alt="{{ product.title }}"
          class="main-image">
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1600 }}"
          alt="{{ product.title }}"
          class="sub-image">
      {% endif %}

    </div>

    <!-- RIGHT SIDE -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">
          {{ section.settings.badge }}
        </div>
      {% endif %}

      <h1 class="title">
        {{ product.title }}
      </h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
        <div class="inventory">
          <span class="dot"></span>
          {{ section.settings.inventory_text }}
        </div>
      {% endif %}

      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="option-group">

            <div class="option-header">
              <span>{{ option.name }}</span>
              <span>{{ option.selected_value }}</span>
            </div>

            {% if option.name == 'Color' %}
  <div class="swatches">
    {% for value in option.values %}
      <button
        type="button"
        class="swatch"
        title="{{ value }}">
      </button>
    {% endfor %}
  </div>
{% endif %}

          </div>
        {% endfor %}
      {% endunless %}

      <div class="sale-box">

        <p>Our seasonal sale ends soon</p>

        <div class="timer">

          <div>
            <strong>07</strong>
            <span>Days</span>
          </div>

          <div>
            <strong>11</strong>
            <span>Hours</span>
          </div>

          <div>
            <strong>03</strong>
            <span>Minutes</span>
          </div>

          <div>
            <strong>32</strong>
            <span>Seconds</span>
          </div>

        </div>

      </div>

      <div class="accordion">

        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>
                {{ block.settings.title }}
              </summary>

              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}

      </div>

      <div class="features">

        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature">
              ✓ {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}

      </div>

      {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %}

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button">−</button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1">

            <button type="button">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }}
            —
            {{ product.price | money }}
          </button>

        </div>

      {% endform %}

      {% if section.settings.complete_product != blank %}

        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete">

          <h3>
            {{ section.settings.complete_title }}
          </h3>

          <div class="complete-card">

            <img
              src="{{ cp.featured_image | image_url: width: 200 }}"
              alt="{{ cp.title }}">

            <div>
              <p>{{ cp.title }}</p>
              <span>{{ cp.price | money }}</span>
            </div>

          </div>

        </div>

      {% endif %}

      {% if section.settings.help_text != blank %}
        <div class="help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>

  </div>

</section>

<style>
   
.custom-product {
    background: #fff !important;
    color: #111;
    padding: 40px 0;
}

.custom-product__grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 58% 42%;
    gap: 80px;
    background: #fff;
}

/* LEFT IMAGES */

.custom-product__media {
    background: #fff;
}

.main-image,
.sub-image {
    width: 100%;
    display: block;
    background: #fff;
}

.main-image {
    margin-bottom: 20px;
}

/* RIGHT COLUMN */

.custom-product__info {
    background: #fff;
    max-width: 500px;
    width: 100%;
}

/* BADGE */

.badge {
    display: inline-block;
    background: #5c554d;
    color: #fff;
    padding: 5px 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: 15px;
}

/* TITLE */

.title {
    font-size: 26px;
    line-height: 1.3;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #111;
}

/* PRICE */

.price {
    font-size: 15px;
    color: #777;
    margin-bottom: 20px;
}

/* INVENTORY */

.inventory {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e5e5;
    font-size: 13px;
    color: #666;
}

.dot {
    width: 8px;
    height: 8px;
    background: #d28d65;
    border-radius: 50%;
}

/* VARIANTS */

.option-group {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.option-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 13px;
    color: #555;
}

.swatches {
    display: flex;
    gap: 12px;
}

.swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #d1ab49;
    background: #d1ab49;
    padding: 0;
    cursor: pointer;
}

.swatch:nth-child(2) {
    background: #d9d9d9;
    border-color: #d9d9d9;
}

/* COUNTDOWN */

.sale-box {
    background: #fff;
    border: 1px solid #e5e5e5;
    padding: 20px;
    margin: 25px 0;
    text-align: center;
}

.sale-box p {
    margin: 0 0 15px;
    font-size: 13px;
    color: #444;
}

.timer {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.timer strong {
    display: block;
    font-size: 22px;
    font-weight: 500;
    color: #111;
}

.timer span {
    font-size: 11px;
    color: #777;
}

/* ACCORDION */

.accordion details {
    border-bottom: 1px solid #e5e5e5;
    padding: 15px 0;
}

.accordion summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    font-size: 13px;
    text-transform: uppercase;
}

.accordion summary::-webkit-details-marker {
    display: none;
}

.accordion summary::after {
    content: "+";
    position: absolute;
    right: 0;
}

.accordion details[open] summary::after {
    content: "-";
}

.content {
    padding-top: 10px;
    color: #666;
    line-height: 1.6;
    font-size: 13px;
}

/* FEATURES */

.features {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.feature {
    margin-bottom: 12px;
    font-size: 13px;
    color: #555;
}

/* SIZE GUIDE */

.size-guide {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
    font-size: 13px;
    color: #111;
}

/* BUY ROW */

.buy-row {
    display: flex;
    gap: 12px;
    margin-top: 25px;
}

/* QUANTITY */

.qty {
    width: 100px;
    height: 50px;
    border: 1px solid #d9d9d9;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: #fff;
}

.qty button {
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    color: #111;
}

.qty input {
    width: 30px;
    border: none;
    background: transparent;
    text-align: center;
    font-size: 14px;
    box-shadow: none;
}

/* BUTTON */

.atc-btn {
    flex: 1;
    height: 50px;
    border: none;
    border-radius: 30px;
    background: #000;
    color: #fff;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    cursor: pointer;
}

.atc-btn:hover {
    background: #222;
}

/* COMPLETE LOOK */

.complete {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
}

.complete h3 {
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 15px;
}

.complete-card {
    display: flex;
    gap: 15px;
    align-items: center;
    background: #fff;
    border: 1px solid #e5e5e5;
    padding: 15px;
}

.complete-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
}

.complete-card p {
    margin: 0 0 5px;
    font-size: 13px;
    color: #111;
}

.complete-card span {
    color: #777;
    font-size: 12px;
}

/* DOTS */

.slider-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 15px;
}

.slider-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ccc;
}

.slider-dots .active {
    background: #111;
}

/* HELP */

.help {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
    font-size: 13px;
    color: #666;
}

/* MOBILE */

@media screen and (max-width: 768px) {

    .custom-product {
        padding: 20px 0;
    }

    .custom-product__grid {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 0 15px;
    }

    .custom-product__info {
        max-width: 100%;
    }

    .buy-row {
        flex-direction: column;
    }

    .qty {
        width: 100%;
    }

    .timer {
        gap: 15px;
    }

    .timer strong {
        font-size: 18px;
    }

    .title {
        font-size: 22px;
    }
}
</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}