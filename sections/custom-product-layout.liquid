<section class="custom-product">
  <div class="custom-product__grid">

    <!-- LEFT IMAGES -->
    <div class="custom-product__media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1400 }}"
          alt="{{ product.title }}"
          class="main-image">
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1400 }}"
          alt="{{ product.title }}"
          class="sub-image">
      {% endif %}
    </div>

    <!-- RIGHT COLUMN -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <span class="badge">
          {{ section.settings.badge }}
        </span>
      {% endif %}

      <h1 class="title">{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
        <div class="inventory">
          <span class="dot"></span>
          {{ section.settings.inventory_text }}
        </div>
      {% endif %}

      <!-- VARIANTS -->
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="option-group">
            <label>{{ option.name }}</label>

            <div class="swatches">
              {% for value in option.values %}
                <button class="swatch" type="button">
                </button>
              {% endfor %}
            </div>

            <span class="variant-name">
              {{ option.selected_value }}
            </span>
          </div>
        {% endfor %}
      {% endunless %}

      <!-- TIMER -->
      <div class="offer-box">
        <p>Our seasonal sale ends soon</p>

        <div class="timer">
          <div>
            <strong>08</strong>
            <span>Days</span>
          </div>

          <div>
            <strong>10</strong>
            <span>Hours</span>
          </div>

          <div>
            <strong>10</strong>
            <span>Minutes</span>
          </div>

          <div>
            <strong>36</strong>
            <span>Seconds</span>
          </div>
        </div>
      </div>

      <!-- ACCORDION -->
      <div class="accordion">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>{{ block.settings.title }}</summary>

              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      <!-- FEATURES -->
      <div class="features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature">
              ✓ {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- SIZE GUIDE -->
      <div class="size-guide">
        {{ section.settings.size_guide }}
      </div>

      <!-- ADD TO CART -->
      {% form 'product', product %}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button" class="qty-minus">−</button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1">

            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }}
            -
            {{ product.price | money }}
          </button>

        </div>
      {% endform %}

      <!-- COMPLETE LOOK -->
      {% if section.settings.complete_product != blank %}
        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete">
          <h3>{{ section.settings.complete_title }}</h3>

          <div class="complete-card">
            <img
              src="{{ cp.featured_image | image_url: width: 150 }}"
              alt="{{ cp.title }}">

            <div class="complete-content">
              <p>{{ cp.title }}</p>
              <span>{{ cp.price | money }}</span>
            </div>
          </div>

          <div class="slider-dots">
            <span></span>
            <span class="active"></span>
            <span></span>
          </div>
        </div>
      {% endif %}

      <div class="help">
        <strong>Need styling help?</strong>
        <p>Book an appointment with our virtual stylist Chat now</p>
      </div>

    </div>
  </div>
</section>
<style>
   .custom-product {
  background: #fff;
}

.custom-product__grid {
  max-width: 1180px;
  margin: auto;
  padding: 24px;
  display: grid;
  grid-template-columns: 58% 42%;
  gap: 24px;
}

.custom-product__info {
  position: sticky;
  top: 20px;
}

/* Images */

.custom-product__media img {
  width: 100%;
  display: block;
  background: #f4f2f1;
}

.main-image {
  margin-bottom: 12px;
}

/* Badge */

.badge {
  background: #74685d;
  color: #fff;
  font-size: 10px;
  padding: 5px 10px;
  text-transform: uppercase;
  display: inline-block;
  margin-bottom: 12px;
}

/* Title */

.title {
  font-size: 20px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.price {
  font-size: 14px;
  margin-bottom: 15px;
}

/* Inventory */

.inventory {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #666;
  padding-bottom: 20px;
  border-bottom: 1px solid #ddd;
}

.dot {
  width: 10px;
  height: 10px;
  border: 1px solid #d3a93f;
  border-radius: 50%;
}

/* Options */

.option-group {
  margin: 20px 0;
}

.option-group label {
  display: block;
  font-size: 12px;
  margin-bottom: 10px;
}

.swatches {
  display: flex;
  gap: 10px;
}

.swatch {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1px solid #ccc;
  background: #d1ae44;
}

.swatch:last-child {
  background: #d8d8d8;
}

.variant-name {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #666;
}

/* Timer */

.offer-box {
  background: #ead9cc;
  padding: 18px;
  text-align: center;
  margin-bottom: 20px;
}

.offer-box p {
  margin-bottom: 12px;
  font-size: 12px;
}

.timer {
  display: flex;
  justify-content: center;
  gap: 20px;
}

.timer strong {
  display: block;
  font-size: 20px;
}

.timer span {
  font-size: 10px;
}

/* Accordion */

.accordion {
  border-top: 1px solid #ddd;
}

.accordion details {
  border-bottom: 1px solid #ddd;
}

.accordion summary {
  padding: 15px 0;
  cursor: pointer;
  list-style: none;
  font-size: 13px;
}

.accordion summary::-webkit-details-marker {
  display: none;
}

.accordion summary::after {
  content: "+";
  float: right;
}

.accordion details[open] summary::after {
  content: "-";
}

.content {
  padding-bottom: 15px;
  color: #666;
  font-size: 13px;
}

/* Features */

.features {
  margin: 20px 0;
}

.feature {
  font-size: 13px;
  color: #666;
  margin-bottom: 10px;
}

/* Size guide */

.size-guide {
  padding-bottom: 20px;
  border-bottom: 1px solid #ddd;
  font-size: 13px;
}

/* Buy row */

.buy-row {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.qty {
  width: 65px;
  height: 42px;
  border: 1px solid #ddd;
  border-radius: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
}

.qty button {
  border: none;
  background: transparent;
  cursor: pointer;
}

.qty input {
  width: 20px;
  border: none;
  text-align: center;
}

.qty input:focus {
  outline: none;
}

.atc-btn {
  flex: 1;
  border: none;
  border-radius: 30px;
  background: #000;
  color: #fff;
  height: 42px;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 1px;
  cursor: pointer;
}

/* Complete */

.complete {
  margin-top: 30px;
  border-top: 1px solid #ddd;
  padding-top: 20px;
}

.complete h3 {
  font-size: 13px;
  margin-bottom: 15px;
}

.complete-card {
  background: #f7f5f2;
  padding: 15px;
  display: flex;
  gap: 15px;
}

.complete-card img {
  width: 70px;
  height: 70px;
  object-fit: cover;
}

.complete-content p {
  font-size: 13px;
  margin-bottom: 5px;
}

.complete-content span {
  font-size: 13px;
}

.slider-dots {
  text-align: center;
  margin-top: 15px;
}

.slider-dots span {
  width: 6px;
  height: 6px;
  background: #bbb;
  border-radius: 50%;
  display: inline-block;
  margin: 0 3px;
}

.slider-dots .active {
  background: #000;
}

/* Help */

.help {
  border-top: 1px solid #ddd;
  margin-top: 25px;
  padding-top: 20px;
}

.help strong {
  font-size: 13px;
}

.help p {
  font-size: 12px;
  color: #666;
  margin-top: 8px;
}

/* Mobile */

@media (max-width: 768px) {
  .custom-product__grid {
    grid-template-columns: 1fr;
  }

  .custom-product__info {
    position: static;
  }

  .buy-row {
    flex-direction: column;
  }

  .qty {
    width: 100%;
    justify-content: center;
    gap: 20px;
  }
}
</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}