<section class="custom-product">

  <div class="custom-product__grid">

    <!-- LEFT IMAGES -->
    <div class="custom-product__media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1400 }}"
          class="main-image"
        >
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1400 }}"
          class="sub-image"
        >
      {% endif %}
    </div>

    <!-- RIGHT INFO -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">{{ section.settings.badge }}</div>
      {% endif %}

      <h1 class="title">{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
  <div class="inventory">
    <span class="dot"></span>
    {{ section.settings.inventory_text }}
  </div>
{% endif %}

      <!-- VARIANTS -->
      {% unless product.has_only_default_variant %}
        <div class="variants">
          {% for option in product.options_with_values %}
            <div class="option-group">
              <label>{{ option.name }}</label>

              <div class="swatches">
                {% for value in option.values %}
                  <button
                    class="swatch"
                    type="button"
                    data-value="{{ value }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- ACCORDION -->
      <div class="accordion">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>{{ block.settings.title }}</summary>
              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      <!-- FEATURES -->
      <div class="features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature">
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- SIZE GUIDE -->
      {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %}

      <!-- ADD TO CART -->
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button" class="qty-minus">-</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }} — {{ product.price | money }}
          </button>

        </div>
      {% endform %}

      <!-- COMPLETE LOOK -->
      {% if section.settings.complete_product != blank %}
        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete">
          <h3>{{ section.settings.complete_title }}</h3>

          <div class="complete-card">
            <img src="{{ cp.featured_image | image_url: width: 200 }}">
            <div>
              <p>{{ cp.title }}</p>
              <span>{{ cp.price | money }}</span>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- HELP -->
      {% if section.settings.help_text != blank %}
        <div class="help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>
  </div>
</section>
<style>
   .custom-product {
  background: #fff;
  color: #111;
}

.custom-product__grid {
  max-width: 1180px;
  margin: 0 auto;
  padding: 20px 30px;
  display: grid;
  grid-template-columns: 560px 320px;
  gap: 30px;
  justify-content: center;
}

/* IMAGE GALLERY */

.custom-product__media {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.product-image {
  width: 100%;
}

.gallery-image,
.main-image,
.sub-image {
  width: 100%;
  display: block;
  background: #f5f4f2;
}

/* PRODUCT INFO */

.custom-product__info {
  position: sticky;
  top: 20px;
  align-self: start;
}

/* BADGE */

.badge {
  display: inline-block;
  background: #7b6d61;
  color: #fff;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 4px 8px;
  margin-bottom: 12px;
}

/* TITLE */

.title {
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  line-height: 1.4;
  margin: 0 0 6px;
}

/* PRICE */

.price {
  font-size: 12px;
  color: #111;
  margin-bottom: 18px;
}

/* INVENTORY */

.inventory {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #666;
  padding-bottom: 18px;
  margin-bottom: 18px;
  border-bottom: 1px solid #ddd;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1px solid #d0a847;
}

/* OPTIONS */

.option-group {
  margin-bottom: 18px;
}

.option-group label {
  display: block;
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

/* SWATCHES */

.swatches {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.swatch {
  border: 1px solid #ddd;
  background: #fff;
  color: #111;
  font-size: 11px;
  padding: 7px 12px;
  cursor: pointer;
  transition: .2s;
}

.swatch:hover,
.swatch.active {
  border-color: #111;
}

/* ACCORDION */

.accordion {
  border-top: 1px solid #ddd;
  margin-top: 20px;
}

.accordion details {
  border-bottom: 1px solid #ddd;
}

.accordion summary {
  padding: 14px 0;
  cursor: pointer;
  list-style: none;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.accordion summary::-webkit-details-marker {
  display: none;
}

.accordion summary::after {
  content: "+";
  float: right;
  font-size: 14px;
}

.accordion details[open] summary::after {
  content: "−";
}

.content {
  padding-bottom: 15px;
  font-size: 12px;
  line-height: 1.6;
  color: #666;
}

/* FEATURES */

.features {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.feature {
  font-size: 11px;
  color: #666;
}

.feature::before {
  content: "✓ ";
}

/* SIZE GUIDE */

.size-guide {
  margin-top: 20px;
  font-size: 11px;
  padding-bottom: 18px;
  border-bottom: 1px solid #ddd;
}

/* BUY ROW */

.buy-row {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

/* QUANTITY */

.qty {
  width: 65px;
  height: 34px;
  border: 1px solid #ddd;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
}

.qty input {
  width: 20px;
  border: none;
  text-align: center;
  font-size: 11px;
  background: transparent;
}

.qty button {
  border: none;
  background: transparent;
  font-size: 14px;
  cursor: pointer;
}

/* ADD TO CART */

.atc-btn {
  flex: 1;
  height: 34px;
  border: none;
  border-radius: 20px;
  background: #111;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  transition: .3s;
}

.atc-btn:hover {
  background: #000;
}

/* COMPLETE LOOK */

.complete {
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #ddd;
}

.complete h3 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 12px;
}

.complete-card {
  display: flex;
  gap: 12px;
  background: #f5f4f2;
  padding: 12px;
}

.complete-card img {
  width: 55px;
  height: 55px;
  object-fit: cover;
}

.complete-card p {
  font-size: 11px;
  margin: 0 0 4px;
}

.complete-card span {
  font-size: 10px;
  color: #666;
}

/* HELP */

.help {
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #ddd;
  font-size: 11px;
  color: #666;
}

.help strong {
  display: block;
  color: #111;
  margin-bottom: 6px;
}

/* MOBILE */

@media (max-width: 991px) {

  .custom-product__grid {
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }

  .custom-product__info {
    position: static;
  }

  .buy-row {
    flex-direction: column;
  }

  .qty {
    width: 100%;
    justify-content: center;
    gap: 20px;
  }
}
</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}