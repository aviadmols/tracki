<section class="custom-product">

  <div class="custom-product__grid">

    <!-- LEFT IMAGES -->
    <div class="custom-product__media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1400 }}"
          class="main-image"
        >
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1400 }}"
          class="sub-image"
        >
      {% endif %}
    </div>

    <!-- RIGHT INFO -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">{{ section.settings.badge }}</div>
      {% endif %}

      <h1 class="title">{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
  <div class="inventory">
    <span class="dot"></span>
    {{ section.settings.inventory_text }}
  </div>
{% endif %}

      <!-- VARIANTS -->
      {% unless product.has_only_default_variant %}
        <div class="variants">
          {% for option in product.options_with_values %}
            <div class="option-group">
              <label>{{ option.name }}</label>

              <div class="swatches">
                {% for value in option.values %}
                  <button
                    class="swatch"
                    type="button"
                    data-value="{{ value }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- ACCORDION -->
      <div class="accordion">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>{{ block.settings.title }}</summary>
              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      <!-- FEATURES -->
      <div class="features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature">
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- SIZE GUIDE -->
      {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %}

      <!-- ADD TO CART -->
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button" class="qty-minus">-</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }} — {{ product.price | money }}
          </button>

        </div>
      {% endform %}

      <!-- COMPLETE LOOK -->
      {% if section.settings.complete_product != blank %}
        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete">
          <h3>{{ section.settings.complete_title }}</h3>

          <div class="complete-card">
            <img src="{{ cp.featured_image | image_url: width: 200 }}">
            <div>
              <p>{{ cp.title }}</p>
              <span>{{ cp.price | money }}</span>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- HELP -->
      {% if section.settings.help_text != blank %}
        <div class="help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>
  </div>
</section>
<style>
   /* PRODUCT INFO */
.custom-product__info {
    position: sticky;
    top: 20px;
}

/* PRE ORDER BADGE */
.badge {
    display: inline-block;
    background: #59524b;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 10px;
    border: none;
    text-transform: uppercase;
    margin-bottom: 12px;
}

/* TITLE */
.title {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 8px;
}

/* PRICE */
.price {
    font-size: 14px;
    color: #7b7b7b;
    margin-bottom: 20px;
}

/* INVENTORY */
.inventory {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #666;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 20px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d8895f;
}

/* OPTION LABEL */
.option-group {
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 20px;
}

.option-group label {
    display: block;
    font-size: 12px;
    margin-bottom: 10px;
    color: #555;
}

/* COLOR SWATCH */
.swatches {
    display: flex;
    gap: 10px;
}

.swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #d7d7d7;
    padding: 0;
    text-indent: -9999px;
    position: relative;
}

.swatch.active {
    border: 2px solid #b88b1c;
}

.swatch::after {
    content: "";
    width: 20px;
    height: 20px;
    background: #cba633;
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 3px;
}

/* ACCORDION */
.accordion details {
    border-bottom: 1px solid #e5e5e5;
    padding: 14px 0;
}

.accordion summary {
    font-size: 13px;
    cursor: pointer;
    list-style: none;
    position: relative;
}

.accordion summary::after {
    content: "+";
    position: absolute;
    right: 0;
}

.accordion details[open] summary::after {
    content: "-";
}

.accordion .content {
    padding-top: 10px;
    font-size: 13px;
    color: #666;
    line-height: 1.6;
}

/* FEATURES */
.features {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.feature {
    font-size: 13px;
    color: #555;
    margin-bottom: 10px;
}

/* SIZE GUIDE */
.size-guide {
    margin-top: 20px;
    font-size: 13px;
    margin-bottom: 20px;
}

/* BUY ROW */
.buy-row {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    align-items: center;
}

/* QUANTITY */
.qty {
    width: 100px;
    height: 48px;
    border: 1px solid #ccc;
    border-radius: 30px;
    padding: 0 15px;
}

.qty input {
    width: 30px;
    text-align: center;
    border: none;
    font-size: 14px;
}

.qty button {
    border: none;
    background: none;
    font-size: 18px;
}

/* ADD TO CART */
.atc-btn {
    flex: 1;
    height: 48px;
    border-radius: 30px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 12px;
    letter-spacing: .1em;
    font-weight: 600;
    text-transform: uppercase;
}

.atc-btn:hover {
    background: #222;
}

/* COMPLETE LOOK */
.complete {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
}

.complete h3 {
    font-size: 12px;
    margin-bottom: 15px;
    color: #666;
}

.complete-card {
    background: #f6f3ef;
    padding: 15px;
    display: flex;
    gap: 15px;
    align-items: center;
}

.complete-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
}

.complete-card p {
    font-size: 13px;
    margin: 0;
}

.complete-card span {
    font-size: 12px;
    color: #666;
}

/* HELP */
.help {
    border-top: 1px solid #e5e5e5;
    padding-top: 20px;
    margin-top: 30px;
    font-size: 13px;
    color: #666;
}
</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}