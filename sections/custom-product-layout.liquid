
<section class="custom-product">

  <div class="custom-product__grid">

    <!-- LEFT SIDE -->
    <div class="custom-product__media">

      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1600 }}"
          alt="{{ product.title }}"
          class="main-image">
      {% endif %}

      {% if product.images[1] %}
        <img
          src="{{ product.images[1] | image_url: width: 1600 }}"
          alt="{{ product.title }}"
          class="sub-image">
      {% endif %}

    </div>

    <!-- RIGHT SIDE -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">
          {{ section.settings.badge }}
        </div>
      {% endif %}

      <h1 class="title">
        {{ product.title }}
      </h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
        <div class="inventory">
          <span class="dot"></span>
          {{ section.settings.inventory_text }}
        </div>
      {% endif %}

      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="option-group">

            <div class="option-header">
              <span>{{ option.name }}</span>
              <span>{{ option.selected_value }}</span>
            </div>

            <div class="swatches">
              {% for value in option.values %}
                <button
                  type="button"
                  class="swatch">
                </button>
              {% endfor %}
            </div>

          </div>
        {% endfor %}
      {% endunless %}

      <div class="sale-box">

        <p>Our seasonal sale ends soon</p>

        <div class="timer">

          <div>
            <strong>07</strong>
            <span>Days</span>
          </div>

          <div>
            <strong>11</strong>
            <span>Hours</span>
          </div>

          <div>
            <strong>03</strong>
            <span>Minutes</span>
          </div>

          <div>
            <strong>32</strong>
            <span>Seconds</span>
          </div>

        </div>

      </div>

      <div class="accordion">

        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details>
              <summary>
                {{ block.settings.title }}
              </summary>

              <div class="content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}

      </div>

      <div class="features">

        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature">
              ✓ {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}

      </div>

      {% if section.settings.size_guide != blank %}
        <div class="size-guide">
          {{ section.settings.size_guide }}
        </div>
      {% endif %}

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">
            <button type="button">−</button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1">

            <button type="button">+</button>
          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }}
            —
            {{ product.price | money }}
          </button>

        </div>

      {% endform %}

      {% if section.settings.complete_product != blank %}

        {% assign cp = all_products[section.settings.complete_product] %}

        <div class="complete">

          <h3>
            {{ section.settings.complete_title }}
          </h3>

          <div class="complete-card">

            <img
              src="{{ cp.featured_image | image_url: width: 200 }}"
              alt="{{ cp.title }}">

            <div>
              <p>{{ cp.title }}</p>
              <span>{{ cp.price | money }}</span>
            </div>

          </div>

        </div>

      {% endif %}

      {% if section.settings.help_text != blank %}
        <div class="help">
          {{ section.settings.help_text }}
        </div>
      {% endif %}

    </div>

  </div>

</section>

<style>
   ```css
.custom-product {
    padding: 40px 0;
}

.custom-product__grid {
    max-width: 1400px;
    margin: auto;
    display: grid;
    grid-template-columns: 58% 42%;
    gap: 80px;
}

.custom-product__info {
    max-width: 500px;
}

.main-image,
.sub-image {
    width: 100%;
    display: block;
    margin-bottom: 20px;
}

.badge {
    display: inline-block;
    background: #5c564d;
    color: #fff;
    font-size: 11px;
    padding: 5px 12px;
    text-transform: uppercase;
    margin-bottom: 15px;
}

.title {
    font-size: 26px;
    line-height: 1.3;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.price {
    color: #777;
    margin-bottom: 20px;
}

.inventory {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 20px;
}

.dot {
    width: 8px;
    height: 8px;
    background: #d08c5c;
    border-radius: 50%;
}

.option-group {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.option-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}

.swatches {
    display: flex;
    gap: 12px;
}

.swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #d2ab47;
    background: #d2ab47;
}

.sale-box {
    background: #ead9ce;
    padding: 20px;
    margin: 25px 0;
    text-align: center;
}

.timer {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.timer strong {
    display: block;
    font-size: 22px;
}

.timer span {
    font-size: 11px;
}

.accordion details {
    border-bottom: 1px solid #e5e5e5;
    padding: 15px 0;
}

.accordion summary {
    cursor: pointer;
    list-style: none;
}

.content {
    padding-top: 10px;
}

.features {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.feature {
    margin-bottom: 10px;
}

.size-guide {
    padding: 20px 0;
}

.buy-row {
    display: flex;
    gap: 12px;
    margin-top: 25px;
}

.qty {
    width: 100px;
    height: 50px;
    border: 1px solid #ddd;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
}

.qty input {
    width: 30px;
    border: none;
    text-align: center;
}

.qty button {
    border: none;
    background: transparent;
}

.atc-btn {
    flex: 1;
    height: 50px;
    border-radius: 30px;
    border: none;
    background: #000;
    color: #fff;
    text-transform: uppercase;
}

.complete {
    margin-top: 30px;
    border-top: 1px solid #e5e5e5;
    padding-top: 20px;
}

.complete-card {
    display: flex;
    gap: 15px;
    background: #f4f1ed;
    padding: 15px;
}

.complete-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
}

.help {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
}

@media screen and (max-width: 768px) {

    .custom-product__grid {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 0 15px;
    }

    .buy-row {
        flex-direction: column;
    }

    .qty {
        width: 100%;
    }

    .timer {
        gap: 15px;
    }
}
```

</style>
<script>
    document.addEventListener("click", function (e) {

  // qty -
  if (e.target.classList.contains("qty-minus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = Math.max(1, parseInt(input.value) - 1);
  }

  // qty +
  if (e.target.classList.contains("qty-plus")) {
    const input = e.target.parentElement.querySelector("input");
    input.value = parseInt(input.value) + 1;
  }

});
</script>
{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Hurry! Low stock"
    },
    {
      "type": "text",
      "id": "size_guide",
      "label": "Size Guide",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete the look"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}