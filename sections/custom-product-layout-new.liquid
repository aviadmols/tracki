<div class="custom-product__info">

  {% if section.settings.badge != blank %}
    <div class="badge">
      {{ section.settings.badge }}
    </div>
  {% endif %}

  <h1 class="title">
    {{ product.title }}
  </h1>

  <div class="price">
    {{ product.price | money }}
  </div>

  {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
    <div class="inventory">
      <span class="dot"></span>
      {{ section.settings.inventory_text }}
    </div>
  {% endif %}

  <!-- VARIANTS -->
  {% unless product.has_only_default_variant %}
    {% for option in product.options_with_values %}

      <div class="option-group">

        <div class="option-head">
          <span>{{ option.name }}</span>
          <span class="selected-option">
            {{ option.selected_value }}
          </span>
        </div>

        <div class="swatches">
          {% for value in option.values %}
            <button
              type="button"
              class="swatch"
              title="{{ value }}">
            </button>
          {% endfor %}
        </div>

      </div>

    {% endfor %}
  {% endunless %}

  <!-- COUNTDOWN -->
  <div class="sale-box">

    <p>Our seasonal sale ends soon</p>

    <div class="timer">

      <div>
        <strong>07</strong>
        <span>Days</span>
      </div>

      <div>
        <strong>11</strong>
        <span>Hours</span>
      </div>

      <div>
        <strong>03</strong>
        <span>Minutes</span>
      </div>

      <div>
        <strong>32</strong>
        <span>Seconds</span>
      </div>

    </div>

  </div>

  <!-- ACCORDION -->
  <div class="accordion">

    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}

        <details>
          <summary>
            {{ block.settings.title }}
          </summary>

          <div class="content">
            {{ block.settings.content }}
          </div>
        </details>

      {% endif %}
    {% endfor %}

  </div>

  <!-- FEATURES -->
  <div class="features">

    {% for block in section.blocks %}
      {% if block.type == 'feature' %}

        <div class="feature">
          ✓ {{ block.settings.text }}
        </div>

      {% endif %}
    {% endfor %}

  </div>

  <!-- SIZE GUIDE -->
  {% if section.settings.size_guide != blank %}
    <div class="size-guide">
      {{ section.settings.size_guide }}
    </div>
  {% endif %}

  <!-- ADD TO CART -->
  {% form 'product', product %}

    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <div class="buy-row">

      <div class="qty">
        <button type="button" class="qty-minus">−</button>

        <input
          type="number"
          name="quantity"
          value="1"
          min="1"
        >

        <button type="button" class="qty-plus">+</button>
      </div>

      <button type="submit" class="atc-btn">
        {{ section.settings.button_text }}
        —
        {{ product.price | money }}
      </button>

    </div>

  {% endform %}

  <!-- COMPLETE LOOK -->
  {% if section.settings.complete_product != blank %}

    {% assign cp = all_products[section.settings.complete_product] %}

    <div class="complete">

      <h3>
        {{ section.settings.complete_title }}
      </h3>

      <div class="complete-card">

        <img
          src="{{ cp.featured_image | image_url: width: 200 }}"
          alt="{{ cp.title }}"
        >

        <div>
          <p>{{ cp.title }}</p>
          <span>{{ cp.price | money }}</span>
        </div>

      </div>

      <div class="slider-dots">
        <span class="active"></span>
        <span></span>
        <span></span>
      </div>

    </div>

  {% endif %}

  <!-- HELP -->
  {% if section.settings.help_text != blank %}
    <div class="help">
      {{ section.settings.help_text }}
    </div>
  {% endif %}

</div>

<style>
    .custom-product {
    background: #fff;
    color: #111;
}

.custom-product__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 40px 20px;
}

/* LEFT IMAGES */

.custom-product__media img {
    width: 100%;
    display: block;
}

.main-image {
    margin-bottom: 20px;
}

/* RIGHT COLUMN */

.custom-product__info {
    position: sticky;
    top: 20px;
}

/* BADGE */

.badge {
    display: inline-block;
    background: #5d564f;
    color: #fff;
    font-size: 11px;
    text-transform: uppercase;
    padding: 5px 12px;
    margin-bottom: 15px;
    letter-spacing: .05em;
}

/* TITLE */

.title {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 10px;
}

/* PRICE */

.price {
    font-size: 15px;
    color: #777;
    margin-bottom: 20px;
}

/* INVENTORY */

.inventory {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #666;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e5e5;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c48b62;
}

/* VARIANTS */

.option-group {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.option-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 13px;
}

.selected-option {
    color: #888;
}

.swatches {
    display: flex;
    gap: 12px;
}

.swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #d0a542;
    background: #d0a542;
    cursor: pointer;
    padding: 0;
}

.swatch:nth-child(2) {
    background: #d8d8d8;
    border-color: #d8d8d8;
}

/* COUNTDOWN */

.sale-box {
    background: #ecddd2;
    padding: 20px;
    margin: 20px 0;
    text-align: center;
}

.sale-box p {
    margin: 0 0 15px;
    font-size: 13px;
}

.timer {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.timer strong {
    display: block;
    font-size: 22px;
    font-weight: 500;
}

.timer span {
    font-size: 11px;
    color: #666;
}

/* ACCORDION */

.accordion details {
    border-bottom: 1px solid #e5e5e5;
    padding: 15px 0;
}

.accordion summary {
    cursor: pointer;
    position: relative;
    font-size: 13px;
    list-style: none;
}

.accordion summary::-webkit-details-marker {
    display: none;
}

.accordion summary::after {
    content: "+";
    position: absolute;
    right: 0;
}

.accordion details[open] summary::after {
    content: "-";
}

.content {
    padding-top: 12px;
    color: #666;
    line-height: 1.6;
    font-size: 13px;
}

/* FEATURES */

.features {
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
}

.feature {
    font-size: 13px;
    color: #555;
    margin-bottom: 12px;
}

/* SIZE GUIDE */

.size-guide {
    padding: 20px 0;
    font-size: 13px;
    border-bottom: 1px solid #e5e5e5;
}

/* BUY ROW */

.buy-row {
    display: flex;
    gap: 12px;
    margin-top: 25px;
}

/* QUANTITY */

.qty {
    width: 100px;
    height: 50px;
    border: 1px solid #d9d9d9;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
}

.qty button {
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
}

.qty input {
    width: 30px;
    border: none;
    text-align: center;
    background: transparent;
    font-size: 14px;
}

/* ADD TO CART */

.atc-btn {
    flex: 1;
    height: 50px;
    border-radius: 30px;
    border: none;
    background: #000;
    color: #fff;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: .08em;
    font-weight: 600;
    cursor: pointer;
    transition: .3s;
}

.atc-btn:hover {
    background: #222;
}

/* COMPLETE LOOK */

.complete {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
}

.complete h3 {
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 15px;
}

.complete-card {
    display: flex;
    align-items: center;
    gap: 15px;
    background: #f4f1ed;
    padding: 15px;
}

.complete-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
}

.complete-card p {
    margin: 0 0 5px;
    font-size: 13px;
}

.complete-card span {
    color: #777;
    font-size: 12px;
}

/* SLIDER DOTS */

.slider-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 15px;
}

.slider-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cfcfcf;
}

.slider-dots .active {
    background: #000;
}

/* HELP */

.help {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
    font-size: 13px;
    color: #666;
}

/* MOBILE */

@media (max-width: 768px) {

    .custom-product__grid {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 20px 15px;
    }

    .custom-product__info {
        position: static;
    }

    .buy-row {
        flex-direction: column;
    }

    .qty {
        width: 100%;
    }

    .timer {
        gap: 15px;
    }

    .timer strong {
        font-size: 18px;
    }

    .title {
        font-size: 20px;
    }
}
</style>

{% schema %}
{
  "name": "Custom Product",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "PRE ORDER"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Low stock available"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add To Cart Button",
      "default": "Add to Cart"
    },
    {
      "type": "richtext",
      "id": "size_guide",
      "label": "Size Guide"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help Text"
    },
    {
      "type": "text",
      "id": "complete_title",
      "label": "Complete Look Title",
      "default": "Complete The Look"
    },
    {
      "type": "product",
      "id": "complete_product",
      "label": "Complete Look Product"
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Countdown Heading",
      "default": "Our seasonal sale ends soon"
    },
    {
      "type": "text",
      "id": "days",
      "label": "Days",
      "default": "07"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "11"
    },
    {
      "type": "text",
      "id": "minutes",
      "label": "Minutes",
      "default": "03"
    },
    {
      "type": "text",
      "id": "seconds",
      "label": "Seconds",
      "default": "32"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Accordion Content"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Product",
      "blocks": [
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}