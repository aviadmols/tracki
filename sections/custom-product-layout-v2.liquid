<section class="custom-product">
  <div class="custom-product__grid">

    <!-- LEFT IMAGES -->
    <div class="custom-product__media">
      {% for image in product.images %}
        <div class="product-image">
          <img
            src="{{ image | image_url: width: 1200 }}"
            alt="{{ image.alt | escape }}"
            class="gallery-image">
        </div>
      {% endfor %}
    </div>

    <!-- RIGHT INFO -->
    <div class="custom-product__info">

      {% if section.settings.badge != blank %}
        <div class="badge">
          {{ section.settings.badge }}
        </div>
      {% endif %}

      <h1 class="title">
        {{ product.title }}
      </h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity < 10 %}
        <div class="inventory">
          <span class="dot"></span>
          {{ section.settings.inventory_text }}
        </div>
      {% endif %}

      <!-- VARIANTS -->

      {% unless product.has_only_default_variant %}

        {% for option in product.options_with_values %}

          <div class="option-group">

            <label>{{ option.name }}</label>

            <div class="swatches">

              {% for value in option.values %}
                <button
                  type="button"
                  class="swatch">
                  {{ value }}
                </button>
              {% endfor %}

            </div>

          </div>

        {% endfor %}

      {% endunless %}

      <!-- ACCORDION -->

      <div class="accordion">

        {% for block in section.blocks %}

          {% if block.type == 'accordion' %}

            <details>

              <summary>
                {{ block.settings.title }}
              </summary>

              <div class="content">
                {{ block.settings.content }}
              </div>

            </details>

          {% endif %}

        {% endfor %}

      </div>

      <!-- PRODUCT FORM -->

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="buy-row">

          <div class="qty">

            <button type="button" class="qty-minus">
              −
            </button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1">

            <button type="button" class="qty-plus">
              +
            </button>

          </div>

          <button type="submit" class="atc-btn">
            {{ section.settings.button_text }}
            —
            {{ product.price | money }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>
</section>

<style>
.custom-product {
  background: #fff;
}

.custom-product__grid {
  max-width: 1180px;
  margin: auto;
  padding: 20px;
  display: grid;
  grid-template-columns: 560px 330px;
  gap: 30px;
  justify-content: center;
}

.custom-product__media {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.gallery-image {
  width: 100%;
  display: block;
  background: #f5f4f2;
}

.custom-product__info {
  position: sticky;
  top: 20px;
  align-self: start;
}

.badge {
  display: inline-block;
  background: #7a6b5e;
  color: #fff;
  font-size: 9px;
  padding: 4px 8px;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.title {
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.price {
  font-size: 12px;
  margin-bottom: 15px;
}

.inventory {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 20px;
  border-bottom: 1px solid #ddd;
  font-size: 11px;
  color: #777;
}

.dot {
  width: 8px;
  height: 8px;
  border: 1px solid #d0a847;
  border-radius: 50%;
}

.option-group {
  margin: 20px 0;
}

.option-group label {
  display: block;
  font-size: 11px;
  margin-bottom: 10px;
  text-transform: uppercase;
}

.swatches {
  display: flex;
  gap: 8px;
}

.swatch {
  border: 1px solid #ddd;
  background: #fff;
  padding: 6px 12px;
  font-size: 11px;
  cursor: pointer;
}

.accordion {
  border-top: 1px solid #ddd;
}

.accordion details {
  border-bottom: 1px solid #ddd;
}

.accordion summary {
  padding: 14px 0;
  font-size: 11px;
  cursor: pointer;
  text-transform: uppercase;
  list-style: none;
}

.accordion summary::-webkit-details-marker {
  display: none;
}

.accordion summary::after {
  content: "+";
  float: right;
}

.accordion details[open] summary::after {
  content: "-";
}

.content {
  padding-bottom: 15px;
  font-size: 12px;
  color: #666;
}

.buy-row {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

.qty {
  width: 65px;
  height: 34px;
  border: 1px solid #ddd;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
}

.qty input {
  width: 20px;
  border: none;
  text-align: center;
  font-size: 11px;
}

.qty button {
  border: none;
  background: transparent;
  cursor: pointer;
}

.atc-btn {
  flex: 1;
  height: 34px;
  border: none;
  border-radius: 20px;
  background: #000;
  color: #fff;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
}

@media (max-width: 991px) {

  .custom-product__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .custom-product__info {
    position: static;
  }

  .buy-row {
    flex-direction: column;
  }

  .qty {
    width: 100%;
    justify-content: center;
    gap: 20px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const minus = document.querySelector(".qty-minus");
  const plus = document.querySelector(".qty-plus");
  const input = document.querySelector(".qty input");

  if (minus && plus && input) {

    minus.addEventListener("click", function () {
      if (parseInt(input.value) > 1) {
        input.value = parseInt(input.value) - 1;
      }
    });

    plus.addEventListener("click", function () {
      input.value = parseInt(input.value) + 1;
    });

  }

});
</script>

{% schema %}
{
  "name": "Custom Product Layout V2",
  "tag": "section",
  "class": "section-custom-product",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "PRE ORDER"
    },
    {
      "type": "text",
      "id": "inventory_text",
      "label": "Inventory Text",
      "default": "Low stock available"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Product Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your content here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Layout V2",
      "blocks": [
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}