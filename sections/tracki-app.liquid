<div class="tracki-section">
  <div class="tracki-wrapper">

    <!-- Heading -->
    <h2 class="tracki-heading">
      {{ section.settings.heading }}
    </h2>

    <!-- Phone -->
    <div class="phone">
      <img id="phoneImage"
        src="{{ section.blocks.first.settings.image | img_url: 'master' }}"
        alt="App screen">
    </div>

    <!-- Floating Icons -->
    <div class="icons">
      {% for block in section.blocks %}
        <button
          class="icon-btn {% if forloop.first %}active{% endif %}"
          data-img="{{ block.settings.image | img_url: 'master' }}"
          data-desc="{{ block.settings.description }}">

          <img src="{{ block.settings.default_icon | img_url: '100x' }}" alt="" class="default-icon">
          <img src="{{ block.settings.active_icon | img_url: '100x' }}" alt="" class="active-icon">
          <span>{{ block.settings.label }}</span>
        </button>
      {% endfor %}
    </div>

    <!-- Bottom Text -->
    <p class="tracki-desc">
      {{ section.blocks.first.settings.description }}
    </p>

  </div>
</div>

{% comment %} <script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector(".tracki-section");
  const buttons = section.querySelectorAll(".icon-btn");
  const phoneImage = section.querySelector("#phoneImage");
  const desc = section.querySelector(".tracki-desc");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      // Change image
      phoneImage.src = btn.dataset.img;

      // Change description
      desc.textContent = btn.dataset.desc;

      // Toggle active class
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
    });
  });
});
</script> {% endcomment %}
<style>
  .icons{
  position: relative;
  display: flex;
  background: #e9e9e9;
  border-radius: 60px;
  padding: 6px;
  overflow: hidden;
  gap: 0;
}

/* Sliding Background */
.slider{
  position: absolute;
  top: 6px;
  left: 6px;
  width: calc(25% - 4px); /* change according to number of buttons */
  height: calc(100% - 12px);
  background: #ff6b00;
  border-radius: 50px;
  transition: transform 0.45s cubic-bezier(0.77, 0, 0.175, 1);
  z-index: 1;
}

/* Buttons */
.icon-btn{
  flex: 1;
  position: relative;
  z-index: 2;
  border: none;
  background: transparent;
  padding: 14px 10px;
  cursor: pointer;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  color: #333;
  transition: color 0.3s ease;
}

.icon-btn span{
  margin-top: 6px;
  font-size: 14px;
  font-weight: 600;
}

/* Active Text */
.icon-btn.active{
  color: #fff;
}

/* Icons */
.default-icon{
  display: block;
}

.active-icon{
  display: none;
}

.icon-btn.active .default-icon{
  display: none;
}

.icon-btn.active .active-icon{
  display: block;
}

/* Image Animation */
#phoneImage{
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.fade-out{
  opacity: 0;
  transform: scale(0.95);
}

.fade-in{
  opacity: 1;
  transform: scale(1);
}
</style>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const section = document.querySelector(".tracki-section");
  const buttons = section.querySelectorAll(".icon-btn");
  const phoneImage = section.querySelector("#phoneImage");
  const desc = section.querySelector(".tracki-desc");
  const slider = section.querySelector(".slider");

  const totalButtons = buttons.length;

  /* Dynamic slider width */
  slider.style.width = `calc(${100 / totalButtons}% - 4px)`;

  buttons.forEach((btn, index) => {

    btn.addEventListener("click", () => {

      /* Active Button */
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      /* Move Slider */
      slider.style.transform = `translateX(${index * 100}%)`;

      /* Fade Out */
      phoneImage.classList.add("fade-out");

      setTimeout(() => {

        /* Change Image */
        phoneImage.src = btn.dataset.img;

        /* Change Description */
        desc.textContent = btn.dataset.desc;

        /* Fade In */
        phoneImage.classList.remove("fade-out");
        phoneImage.classList.add("fade-in");

        setTimeout(() => {
          phoneImage.classList.remove("fade-in");
        }, 500);

      }, 400);

    });

  });

});
</script>

{% schema %}
{
  "name": "Tracki Mobile Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tracki mobile application"
    }
  ],
  "blocks": [
    {
      "type": "screen",
      "name": "App Screen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Mobile Screen Image"
        },
        {
          "type": "image_picker",
          "id": "default_icon",
          "label": "Default Icon"
        },
        {
          "type": "image_picker",
          "id": "active_icon",
          "label": "Active Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Devices"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Bottom Description",
            "default": "Automatic real-time reports every 60 seconds & 5 seconds manual ping alerts"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tracki Mobile Section",
      "blocks": [
        { "type": "screen" },
        { "type": "screen" },
        { "type": "screen" },
        { "type": "screen" }
      ]
    }
  ]
}
{% endschema %}