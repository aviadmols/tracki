<style>
.withdrawal-page {
  background: #1f2329;
  color: #fff;
  padding: 60px 0;
}

.withdrawal-page h1 {
  font-size: 60px;
  margin-bottom: 40px;
}

.withdrawal-content {
  max-width: 900px;
  margin-bottom: 60px;
}

.withdrawal-content ul {
  padding-left: 20px;
}

.withdrawal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 20px;
}

.withdrawal-grid input {
  width: 100%;
  background: transparent;
  border: 1px solid #40464f;
  color: #fff;
  padding: 15px;
}

.upload-wrapper {
  margin: 25px 0;
}

.upload-wrapper input[type="file"] {
  width: 100%;
  padding: 15px;
  background: #7bc46a;
}

.withdraw-btn {
  background: #343b44;
  color: #fff;
  border: 0;
  padding: 18px 50px;
  text-transform: uppercase;
  cursor: pointer;
}

@media(max-width: 749px){
  .withdrawal-grid {
    grid-template-columns: 1fr;
  }
} 

.withdrawal-page{
  padding:80px 0;
}

.withdrawal-title{
  margin-bottom:40px;
}

.withdrawal-content{
  max-width:900px;
  margin-bottom:60px;
}

.withdrawal-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:20px;
}

.withdrawal-grid input,
.withdrawal-form-wrapper textarea{
  width:100%;
  padding:16px;
  border:1px solid rgba(var(--color-foreground),0.15);
  background:transparent;
}

.withdrawal-form-wrapper textarea{
  margin-bottom:24px;
}

.withdrawal-form-wrapper button{
  min-width:300px;
}

@media screen and (max-width:749px){

  .withdrawal-grid{
    grid-template-columns:1fr;
  }

  .withdrawal-form-wrapper button{
    width:100%;
  }

}

</style>
<div class="withdrawal-page color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <h1 class="withdrawal-title">{{ page.title }}</h1>

    <div class="withdrawal-content rte">
      {{ page.content }}
    </div>

    <div class="withdrawal-form-wrapper">

      {% form 'contact' %}

        {% if form.posted_successfully? %}
          <div class="form-status success">
            Request submitted successfully.
          </div>
        {% endif %}

        {{ form.errors | default_errors }}

        <h2>Withdrawal request form</h2>

        <div class="withdrawal-grid">

          <div>
            <input
              type="text"
              name="contact[Full Name]"
              placeholder="Full name *"
              required>
          </div>

          <div>
            <input
              type="text"
              name="contact[Country]"
              placeholder="Country *"
              required>
          </div>

          <div>
            <input
              type="text"
              name="contact[Tracker ID]"
              placeholder="Tracker ID *"
              required>
          </div>

          <div>
            <input
              type="email"
              name="contact[email]"
              placeholder="Email *"
              required>
          </div>

          <div>
            <input
              type="date"
              name="contact[Purchase Date]">
          </div>

          <div>
            <input
              type="tel"
              name="contact[Phone]"
              placeholder="Phone number">
          </div>

        </div>

        <textarea
          name="contact[Reason]"
          rows="5"
          placeholder="Reason for withdrawal"></textarea>

        <button type="submit" class="button button--primary">
          REQUEST THE WITHDRAWAL
        </button>

      {% endform %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Withdrawal Form Figma",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Withdrawal Form Figma"
    }
  ]
}
{% endschema %}