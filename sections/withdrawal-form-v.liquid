<style>
.withdrawal-page h1 {
  color: #FFF;
font-size: 50px;
font-style: normal;
font-weight: 700;
line-height: normal;
}

.withdrawal-content {
  color: var(--Text-Light, #F7F1E7);
text-align: justify;
font-size: 20px;
font-style: normal;
font-weight: 500;
line-height: normal;
}

{% comment %} .withdrawal-content ul {
  padding-left: 20px;
} {% endcomment %}

.withdrawal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 20px;
}

.withdrawal-grid input {
  width: 100%;
  background: transparent;
  border: 1px solid #40464f;
  color: #fff;
  padding: 15px;
}

.upload-wrapper {
    margin: 25px 0;
}

#invoice-upload {
    display: none;
}

.upload-btn {
    display: inline-block;
    padding: 15px 25px;
    background: #7bc46a;
    color: #000;
    cursor: pointer;
}

.file-preview {
    display: none;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #666;
    padding: 12px 16px;
    margin-top: 15px;
}

.file-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.file-name {
    color: #fff;
}

.remove-file {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
}

.withdraw-btn {
  background: #343b44;
  color: #fff;
  border: 0;
  padding: 18px 50px;
  text-transform: uppercase;
  cursor: pointer;
}

@media(max-width: 749px){
  .withdrawal-grid {
    grid-template-columns: 1fr;
  }
} 

.withdrawal-page{
  padding:80px 0;
}

.withdrawal-title{
  margin-bottom:40px;
}

.withdrawal-content{
  max-width:900px;
  margin-bottom:60px;
}

.withdrawal-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:20px;
}

.withdrawal-grid input,
.withdrawal-form-wrapper textarea{
  width:100%;
  padding:16px;
  border:1px solid rgba(var(--color-foreground),0.15);
  background:transparent;
}

.withdrawal-form-wrapper textarea{
  margin-bottom:24px;
}

.withdrawal-form-wrapper button{
  min-width:300px;
}
.upload-wrapper {
  position: relative;
  width: 100%;
}

/* Hide default file input */
.upload-wrapper input[type="file"] {
  display: none;
}

/* Custom button */
.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420px;
  height:45px;
  padding: 9px 130px;
  background: #76C773; /* green like your SS */
  color: #25282A;
  
  text-transform: uppercase;
  cursor: pointer;
  border: none;
  transition: 0.3s ease;
  font-size:14px;
  margin-top: -25px;
}

.upload-btn:hover {
  background: #76C773;
}
/* Disabled state */
.button--primary:disabled {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 420px;
  height: 50px;
  margin: 0 auto;

  background: #394045; /* dark gray */
  color: #25282A;

  border: none;
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: 2.1px;
  font-size: 14px;
  font-weight: 500;

  cursor: not-allowed;
}

/* Enabled state */
.button--primary:not(:disabled) {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 420px;
  height: 50px;
  margin: 0 auto;

  background: #76C773; /* dark gray */
  color: #25282A;

  border: none;
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: 2.1px;
  font-size: 14px;
  font-weight: 500;

  cursor: not-allowed;
}
.success-message {
  width: 420px;
  margin: 40px auto 0;
  text-align: center;
}

.success-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24px;
}

.success-icon svg {
  width: 32px;
  height: 32px;
}

.success-message p {
  color: var(--Green-light, #76C773);
text-align: center;
font-size: 28px;
font-style: normal;
font-weight: 500;
line-height: normal;
}
@media screen and (max-width:749px){

  .withdrawal-grid{
    grid-template-columns:1fr;
  }

  .withdrawal-form-wrapper button{
    width:100%;
  }

}

</style>
<div class="page-width page-width--inner section--padding">
<div class="withdrawal-page color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <h1 class="withdrawal-title">{{ page.title }}</h1>

    <div class="withdrawal-content rte">
      {{ page.content }}
    </div>

    <div class="withdrawal-form-wrapper">

      {% form 'contact' %}

  {% if form.posted_successfully? %}
