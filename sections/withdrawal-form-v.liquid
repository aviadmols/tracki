<style>
.withdrawal-page{
  padding:80px 0;
}

.withdrawal-title{
  margin-bottom:40px;
}

.withdrawal-content{
  max-width:900px;
  margin-bottom:60px;
}

.withdrawal-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:20px;
}

.withdrawal-grid input,
.withdrawal-form-wrapper textarea{
  width:100%;
  padding:16px;
  border:1px solid rgba(var(--color-foreground),0.15);
  background:transparent;
}

.withdrawal-form-wrapper textarea{
  margin-bottom:24px;
}

.withdrawal-form-wrapper button{
  min-width:300px;
}

@media screen and (max-width:749px){

  .withdrawal-grid{
    grid-template-columns:1fr;
  }

  .withdrawal-form-wrapper button{
    width:100%;
  }

}
</style>
<section class="withdrawal-page">
  <div class="page-width">

    <h1>Withdraw</h1>

    <div class="withdrawal-content">
      <p>You may request a refund within 14 days of your purchase.</p>

      <p>To begin the refund process, please provide below:</p>

      <ul>
        <li>Your tracker ID</li>
        <li>The email address associated with your account</li>
        <li>Your full name</li>
        <li>Your country</li>
        <li>Your phone number (optional)</li>
      </ul>

      <p>
        Once your request is submitted, you will receive an email with
        instructions on how to return your tracker.
      </p>

      <p>
        The tracker must be returned before your refund can be processed.
      </p>
    </div>

    <h2>Withdrawal request form</h2>

    {% form 'contact' %}

      <div class="withdrawal-grid">

        <div class="field">
          <input
            type="text"
            name="contact[Full Name]"
            placeholder="Full name *"
            required>
        </div>

        <div class="field">
          <input
            type="text"
            name="contact[Country]"
            placeholder="Country *"
            required>
        </div>

        <div class="field">
          <input
            type="text"
            name="contact[Tracker ID]"
            placeholder="Tracker ID *"
            required>
        </div>

        <div class="field">
          <input
            type="email"
            name="contact[email]"
            placeholder="Email *"
            required>
        </div>

        <div class="field">
          <input
            type="date"
            name="contact[Purchase Date]">
        </div>

        <div class="field">
          <input
            type="tel"
            name="contact[Phone Number]"
            placeholder="Phone number">
        </div>

      </div>

      <div class="field upload-wrapper">
        <label>Upload Invoice File</label>
        <input
          type="file"
          id="invoice-file">
      </div>

      <button type="submit" class="withdraw-btn">
        REQUEST THE WITHDRAW
      </button>

    {% endform %}

  </div>
</section>

{% schema %}
{
  "name": "Withdrawal Form Figma",
  "settings": [
    ],
  "blocks": [
  {
    "type": "@app"
  }
],
  "presets": [
    {
      "name": "Withdrawal Form Figma"
    }
  ]
}
{% endschema %}