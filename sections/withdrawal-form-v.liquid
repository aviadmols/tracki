            </svg>

        </button>


    </div>

</div>

  </div>

  <button type="submit" class="button--primary" disabled>
    REQUEST THE WITHDRAWAL
</button>

{% endform %}

    </div>

  </div>
</div>
</div>
<script>
  const submitBtn = document.querySelector('.button--primary');

function checkRequiredFields() {
    const requiredFields = document.querySelectorAll('[required]');

    const allFilled = [...requiredFields].every(field => {
        if (field.type === 'checkbox') {
            return field.checked;
        }
        return field.value.trim() !== '';
    });

    submitBtn.disabled = !allFilled;
}

document.querySelectorAll('[required]').forEach(field => {
    field.addEventListener('input', checkRequiredFields);
    field.addEventListener('change', checkRequiredFields);
});

checkRequiredFields();

const fileInput = document.getElementById('invoice-upload');
const filePreview = document.getElementById('filePreview');
const fileName = document.querySelector('.file-name');
const uploadBtn = document.querySelector('.upload-btn');
const removeBtn = document.getElementById('removeFile');

fileInput.addEventListener('change', function () {
    if (this.files.length) {
        fileName.textContent = this.files[0].name;

        uploadBtn.style.display = 'none';
        filePreview.style.display = 'flex';
    }
});

removeBtn.addEventListener('click', function () {
    fileInput.value = '';

    filePreview.style.display = 'none';
    uploadBtn.style.display = 'inline-block';
});
const invoiceUpload = document.getElementById('invoice-upload');
const fileName = document.querySelector('.file-name');
const preview = document.getElementById('filePreview');
const hiddenUrl = document.getElementById('invoice-download-link');


invoiceUpload.addEventListener('change', function(){

    const file = this.files[0];

    if(file){

        fileName.textContent = file.name;
        preview.style.display = "flex";


        /*
          IMPORTANT:
          Replace this with your upload URL.
          The server should return:
          {
             "url":"https://your-domain.com/file.pdf"
          }
        */

        let uploadData = new FormData();
        uploadData.append("file", file);


        fetch("YOUR_UPLOAD_API_URL", {
            method:"POST",
            body:uploadData
        })
        .then(response => response.json())
        .then(data => {

            hiddenUrl.value = data.url;

        });


    }

});



document.getElementById('removeFile').addEventListener('click',function(){

    invoiceUpload.value="";
    fileName.textContent="";
    hiddenUrl.value="";

});
</script>
