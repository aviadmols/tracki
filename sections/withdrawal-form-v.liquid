<style>
.withdrawal-page h1 {
  color: #FFF;
font-size: 50px;
font-style: normal;
font-weight: 700;
line-height: normal;
}

.withdrawal-content {
  color: var(--Text-Light, #F7F1E7);
text-align: justify;
font-size: 20px;
font-style: normal;
font-weight: 500;
line-height: normal;
}

{% comment %} .withdrawal-content ul {
  padding-left: 20px;
} {% endcomment %}

.withdrawal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 20px;
}

.withdrawal-grid input {
  width: 100%;
  background: transparent;
  border: 1px solid #40464f;
  color: #fff;
  padding: 15px;
}

.upload-wrapper {
  margin: 25px 0;
}

.upload-wrapper input[type="file"] {
  width: 100%;
  padding: 15px;
  background: #7bc46a;
}

.withdraw-btn {
  background: #343b44;
  color: #fff;
  border: 0;
  padding: 18px 50px;
  text-transform: uppercase;
  cursor: pointer;
}

@media(max-width: 749px){
  .withdrawal-grid {
    grid-template-columns: 1fr;
  }
} 

.withdrawal-page{
  padding:80px 0;
}

.withdrawal-title{
  margin-bottom:40px;
}

.withdrawal-content{
  max-width:900px;
  margin-bottom:60px;
}

.withdrawal-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-bottom:20px;
}

.withdrawal-grid input,
.withdrawal-form-wrapper textarea{
  width:100%;
  padding:16px;
  border:1px solid rgba(var(--color-foreground),0.15);
  background:transparent;
}

.withdrawal-form-wrapper textarea{
  margin-bottom:24px;
}

.withdrawal-form-wrapper button{
  min-width:300px;
}
.upload-wrapper {
  position: relative;
  width: 100%;
}

/* Hide default file input */
.upload-wrapper input[type="file"] {
  display: none;
}

/* Custom button */
.upload-btn {
  display: flex;
width: 420px;
height: 45px;
padding: 9px 130px;
justify-content: center;
align-items: center;
gap: 10px;
  color: var(--Text-Dark, #25282A);
font-size: 14px;
font-style: normal;
font-weight: 500;
line-height: normal;
letter-spacing: 2.1px;
text-transform: uppercase;
}

.upload-btn:hover {
  background: #6ab85c;
}
@media screen and (max-width:749px){

  .withdrawal-grid{
    grid-template-columns:1fr;
  }

  .withdrawal-form-wrapper button{
    width:100%;
  }

}

</style>
<div class="page-width page-width--inner section--padding">
<div class="withdrawal-page color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <h1 class="withdrawal-title">{{ page.title }}</h1>

    <div class="withdrawal-content rte">
      {{ page.content }}
    </div>

    <div class="withdrawal-form-wrapper">

      {% form 'contact' %}

  {% if form.posted_successfully? %}
    <div class="form-status success">
      Request submitted successfully.
    </div>
  {% endif %}

  {{ form.errors | default_errors }}

  <h2>Withdrawal request form</h2>

  <div class="withdrawal-grid">

    <!-- Purchase Date -->
    <div>
      <input
        type="date"
        name="contact[Purchase Date]"
        value="{{ 'now' | date: '%Y-%m-%d' }}">
    </div>

    <!-- Date of purchase * -->
    <div>
      <input
        type="text"
        name="contact[Date of purchase]"
        placeholder="Date of purchase *"
        required>
    </div>

   <!-- Order Number -->
    <div>
      <input
        type="text"
        name="contact[Order Number]"
        placeholder="Order number *"
        required>
    </div>

     <!-- Tracker ID -->
    <div>
      <input
        type="text"
        name="contact[Tracker ID]"
        placeholder="Tracker ID *"
        required>
    </div>

    <!-- Full Name -->
    <div>
      <input
        type="text"
        name="contact[Full Name]"
        placeholder="Full name *"
        required>
    </div>

    <!-- Email -->
    <div>
      <input
        type="email"
        name="contact[email]"
        placeholder="Email *"
        required>
    </div>

    <!-- Country -->
    <div>
      <input
        type="text"
        name="contact[Country]"
        placeholder="Country *"
        required>
    </div>

    <!-- Home Address -->
    <div>
      <input
        type="text"
        name="contact[Home Address]"
        placeholder="Home address *"
        required>
    </div>

    <!-- Phone -->
    <div>
      <input
        type="tel"
        name="contact[Phone]"
        placeholder="Phone number">
    </div>

    <!-- Upload Invoice -->
    <!-- Upload Invoice -->
<div class="upload-wrapper">
  <input
    type="file"
    id="invoice-upload"
    name="contact[Invoice]"
    accept=".jpg,.jpeg,.png,.pdf"
    required
  >

  <label for="invoice-upload" class="upload-btn">
    UPLOAD INVOICE FILE
  </label>
</div>

  </div>

  <button type="submit" class="button button--primary">
    REQUEST THE WITHDRAWAL
  </button>

{% endform %}

    </div>

  </div>
</div>
</div>
{% schema %}
{
  "name": "Withdrawal Form Figma",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Withdrawal Form Figma"
    }
  ]
}
{% endschema %}