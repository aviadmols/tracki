{% comment %} <script>
  const submitBtn = document.querySelector('.button--primary');

function checkRequiredFields() {
    const requiredFields = document.querySelectorAll('[required]');

    const allFilled = [...requiredFields].every(field => {
        if (field.type === 'checkbox') {
            return field.checked;
        }
        return field.value.trim() !== '';
    });

    submitBtn.disabled = !allFilled;
}

document.querySelectorAll('[required]').forEach(field => {
    field.addEventListener('input', checkRequiredFields);
    field.addEventListener('change', checkRequiredFields);
});

checkRequiredFields();

const fileInput = document.getElementById('invoice-upload');
const filePreview = document.getElementById('filePreview');
const fileName = document.querySelector('.file-name');
const uploadBtn = document.querySelector('.upload-btn');
const removeBtn = document.getElementById('removeFile');

fileInput.addEventListener('change', function () {
    if (this.files.length) {
        fileName.textContent = this.files[0].name;

        uploadBtn.style.display = 'none';
        filePreview.style.display = 'flex';
    }
});

removeBtn.addEventListener('click', function () {
    fileInput.value = '';

    filePreview.style.display = 'none';
    uploadBtn.style.display = 'inline-block';
});
document.addEventListener('DOMContentLoaded', function () {

    const submitBtn = document.querySelector('.button--primary');

    function checkRequiredFields() {

        const requiredFields = document.querySelectorAll('[required]');

        const allFilled = [...requiredFields].every(field => {

            if (field.type === 'checkbox') {
                return field.checked;
            }

            return field.value.trim() !== '';

        });

        submitBtn.disabled = !allFilled;

    }

    document.querySelectorAll('[required]').forEach(field => {

        field.addEventListener('input', checkRequiredFields);
        field.addEventListener('change', checkRequiredFields);

    });

    checkRequiredFields();


    const invoiceUpload = document.getElementById('invoice-upload');
    const hiddenUrl = document.getElementById('invoice-download-link');

    const invoiceFileName = document.querySelector('.file-name');
    const preview = document.getElementById('filePreview');

    const uploadBtn = document.querySelector('.upload-btn');
    const removeBtn = document.getElementById('removeFile');


    invoiceUpload.addEventListener('change', async function () {

        const file = this.files[0];

        console.log('==============================');
        console.log('FILE SELECTED');
        console.log('==============================');

        if (!file) {

            console.log('No file selected');
            return;

        }

        console.log('File Name:', file.name);
        console.log('File Size:', file.size);
        console.log('File Type:', file.type);

        invoiceFileName.textContent = file.name;

        uploadBtn.style.display = 'none';
        preview.style.display = 'flex';

        /*
         TEMP TEST
         Uncomment these lines to verify Shopify email receives the URL
        */

        hiddenUrl.value = 'https://test.com/sample.pdf';

        console.log('TEST PDF URL:', hiddenUrl.value);

        /*
         REAL UPLOAD CODE
         Replace YOUR_UPLOAD_API_URL with your actual API
        */

        try {

            console.log('Uploading file...');

            const uploadData = new FormData();
            uploadData.append('file', file);

            const response = await fetch('YOUR_UPLOAD_API_URL', {
                method: 'POST',
                body: uploadData
            });

            console.log('Response Object:', response);
            console.log('Response Status:', response.status);

            const responseText = await response.text();

            console.log('Raw Response:', responseText);

            try {

                const data = JSON.parse(responseText);

                console.log('Parsed Response:', data);

                if (data.url) {

                    hiddenUrl.value = data.url;

                    console.log('SUCCESS');
                    console.log('PDF URL:', data.url);
                    console.log('Hidden Field Value:', hiddenUrl.value);

                } else {

                    console.error('No URL returned from API');

                }

            } catch (jsonError) {

                console.error('JSON Parse Error');
                console.error(jsonError);

            }

        } catch (error) {

            console.error('UPLOAD FAILED');
            console.error(error);

        }

    });


    removeBtn.addEventListener('click', function () {

        invoiceUpload.value = '';

        invoiceFileName.textContent = '';

        hiddenUrl.value = '';

        preview.style.display = 'none';

        uploadBtn.style.display = 'inline-block';

        console.log('File Removed');

    });


    const form = document.querySelector('form');

    if (form) {

        form.addEventListener('submit', function () {

            console.log('==============================');
            console.log('FORM SUBMIT');
            console.log('==============================');

            console.log(
                'Invoice Download Link:',
                hiddenUrl.value
            );

        });

    }

});
</script> {% endcomment %}
