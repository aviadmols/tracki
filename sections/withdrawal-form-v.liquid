<div class="page-width page-width--inner section--padding">
<div class="withdrawal-page color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <h1 class="withdrawal-title">{{ page.title }}</h1>

    <div class="withdrawal-content rte">
      {{ page.content }}
    </div>

<div class="withdrawal-form-wrapper">
  <div class="page-width">
  <iframe
    src="https://guide.tracki.com/shopify/EU-Request-form/"
    width="100%"
    height="1200"
    frameborder="0"
    style="border:0;">
  </iframe>
</div>


<style>
  .withdrawal-form-wrapper .page-width {
    padding: 0;
}




.withdrawal-form-wrapper .page-width {
    padding: 0;
}




.withdrawal-form-wrapper .page-width h2 {
color: #FFFFFF;
font-size: 28px;
line-height: normal;
font-weight: 700;
letter-spacing: 0;
font-style: normal;
margin: 0 0 30px;
}



{% comment %} .withdrawal-content ul {
padding-left: 20px;
} {% endcomment %}

.withdrawal-grid {
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 20px 50px;
margin-bottom: 60px;
}

.withdrawal-grid input {
width: 100%;
background: transparent;
border: 1px solid #40464F;
color: #fff;
padding: 15px;
}

#invoice-upload {
display: none;
}

.upload-btn {
display: inline-block;
padding: 15px 25px;
background: #7BC46A;
color: #000;
cursor: pointer;
}

.file-preview {
display: none;
align-items: center;
justify-content: space-between;
border: none;
padding: 6px 0;
margin: auto 0;
}

.file-info {
display: flex;
align-items: center;
gap: 15px;
}



.file-name {
color: #fff;
font-size: 16px;
line-height: 1;
letter-spacing: 3%;
font-weight: 450;
font-style: normal;
}

.file-preview .remove-file , .file-icon{
min-width: 0;
padding: 0;
width: 32px;
height: 32px;
display: flex;
align-items: center;
justify-content: center;
}

.withdraw-btn {
background: #343B44;
color: #fff;
border: 0;
padding: 18px 50px;
text-transform: uppercase;
cursor: pointer;
}

@media(max-width: 749px){
.withdrawal-grid {
grid-template-columns: 1fr;
}
}

.withdrawal-page {
padding: 60px 0;
}



.withdrawal-content{
max-width:900px;
margin-bottom:60px;
}

.withdrawal-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 20px 50px;
margin-bottom: 60px;
}

.withdrawal-grid input, .withdrawal-form-wrapper textarea {
width: 100%;
border: 1px solid #394045;
background: transparent;
padding: 14px 20px;
color: #F7F1E7;
letter-spacing: 3%;
font-size: 13px;
font-weight: 450;
line-height: 1;
}
.withdrawal-grid input::placeholder, .withdrawal-form-wrapper textarea::placeholder {
color:#7E878D;
}

.withdrawal-grid *:focus-visible,
.withdrawal-grid input:focus-visible,
.withdrawal-form-wrapper textarea:focus-visible,
.withdrawal-form-wrapper *:focus-visible,
.withdrawal-grid input:focus,
.withdrawal-form-wrapper textarea:focus {
outline: none !important;
outline-offset: 0 !important;
box-shadow: none !important;
border-color: #F3F1F0 !important;
}

.withdrawal-grid input.bg_light_grey {
background: #394045;
}

.withdrawal-form-wrapper button{
min-width:300px;
}
.upload-wrapper {
position: relative;
width: 100%;
/* margin:25px 0 0; */
}

/* Hide default file input */
.upload-wrapper input[type="file"] {
display: none;
}

/* Custom button */
.upload-btn {
display: flex;
align-items: center;
justify-content: center;
width: 100%;
height: 45px;
padding: 9px 20px;
background: #76C773;
color: #25282A;
text-transform: uppercase;
cursor: pointer;
border: none;
transition: 0.3s ease;
font-size: 14px;
font-weight: 600;
letter-spacing: 15%;
}

.upload-btn:hover {
background: #76C773;
}
/* Disabled state */
.button--primary:disabled {
display: flex;
justify-content: center;
align-items: center;

width: 420px;
height: 50px;
margin: 0 auto;

background: #394045; /* dark gray */
color: #25282A;

border: none;
white-space: nowrap;
text-transform: uppercase;
letter-spacing: 2.1px;
font-size: 14px;
font-weight: 500;

cursor: not-allowed;
}

/* Enabled state */
.button--primary:not(:disabled) {
display: flex;
justify-content: center;
align-items: center;

width: 420px;
height: 50px;
margin: 0 auto;

background: #76C773; /* dark gray */
color: #25282A;

border: none;
white-space: nowrap;
text-transform: uppercase;
letter-spacing: 2.1px;
font-size: 14px;
font-weight: 500;

cursor: not-allowed;
}
.success-message {
width: 420px;
margin: 40px auto 0;
text-align: center;
}

.success-icon {
display: flex;
justify-content: center;
align-items: center;
margin-bottom: 24px;
}

.success-icon svg {
width: 32px;
height: 32px;
}

.success-message p {
color: var(--Green-light, #76C773);
text-align: center;
font-size: 28px;
font-style: normal;
font-weight: 500;
line-height: normal;
}
@media screen and (max-width:749px){

.withdrawal-grid{
grid-template-columns:1fr;
}

.withdrawal-form-wrapper button{
width:100%;
}
</style>




