<section class="luxury-product">

  <div class="luxury-product__wrapper">

    <!-- LEFT COLUMN -->
    <div class="luxury-product__gallery">

      {% for image in product.images %}
        <div class="gallery-card">
          {{
            image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              class: 'gallery-image',
              alt: image.alt
          }}
        </div>
      {% endfor %}

    </div>

    <!-- RIGHT COLUMN -->
    <div class="luxury-product__content">

      {% if section.settings.badge_text != blank %}
        <span class="product-badge">
          {{ section.settings.badge_text }}
        </span>
      {% endif %}

      <h1 class="product-title">
        {{ product.title }}
      </h1>

      <div class="product-price">
        {{ product.price | money }}
      </div>

      {% if product.available %}
        <div class="inventory-message">
          In Stock
        </div>
      {% else %}
        <div class="inventory-message soldout">
          Sold Out
        </div>
      {% endif %}

      <!-- VARIANTS -->

      {% unless product.has_only_default_variant %}

        {% for option in product.options_with_values %}

          <div class="variant-group">

            <label>{{ option.name }}</label>

            <div class="variant-values">

              {% for value in option.values %}
                <span class="variant-pill">
                  {{ value }}
                </span>
              {% endfor %}

            </div>

          </div>

        {% endfor %}

      {% endunless %}

      <!-- COUNTDOWN -->

      <div class="countdown-box">

        <div class="countdown-heading">
          {{ section.settings.countdown_heading }}
        </div>

        <div
          class="countdown"
          id="countdown-{{ section.id }}"
        >

          <div>
            <strong class="days">00</strong>
            <span>Days</span>
          </div>

          <div>
            <strong class="hours">00</strong>
            <span>Hours</span>
          </div>

          <div>
            <strong class="minutes">00</strong>
            <span>Minutes</span>
          </div>

          <div>
            <strong class="seconds">00</strong>
            <span>Seconds</span>
          </div>

        </div>

      </div>

      <!-- ACCORDION -->

      <div class="accordion-wrapper">

        <details open>
          <summary>Description</summary>

          <div class="accordion-content">
            {{ product.description }}
          </div>
        </details>

        <details>
          <summary>Product Details</summary>

          <div class="accordion-content">
            {{ section.settings.details }}
          </div>
        </details>

      </div>

      <!-- ICONS -->

      <div class="benefits">

        {% for block in section.blocks %}

          <div
            class="benefit-item"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.icon %}
              {{
                block.settings.icon
                | image_url: width: 60
                | image_tag
              }}
            {% endif %}

            <span>
              {{ block.settings.text }}
            </span>

          </div>

        {% endfor %}

      </div>

      <!-- PRODUCT FORM -->

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
        >

        <div class="purchase-wrapper">

          <div class="qty-box">

            <button
              type="button"
              class="qty-minus"
            >
              -
            </button>

            <input
              type="number"
              value="1"
              min="1"
              name="quantity"
              class="qty-input"
            >

            <button
              type="button"
              class="qty-plus"
            >
              +
            </button>

          </div>

          <button
            type="submit"
            class="add-to-cart"
          >
            Add To Cart · {{ product.price | money }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>

</section>

<style>
.luxury-product{
  background:#fff;
  padding:60px 20px;
}

.luxury-product__wrapper{
  max-width:1400px;
  margin:0 auto;
  display:grid;
  grid-template-columns:60% 40%;
  gap:50px;
  background:#fff;
}

.luxury-product__gallery{
  display:flex;
  flex-direction:column;
  gap:20px;
  background:#fff;
}

.gallery-card{
  background:#fff !important;
  min-height:700px;
  display:flex;
  justify-content:center;
  align-items:center;
}

.gallery-image{
  width:100%;
  max-height:650px;
  object-fit:contain;
  display:block;
  background:#fff;
}

.luxury-product__content{
  background:#fff;
}

.product-badge{
  background:#4f4035;
  color:#fff;
  padding:6px 12px;
  display:inline-block;
  font-size:12px;
  margin-bottom:15px;
}

.product-title{
  font-size:34px;
  margin:0 0 10px;
}

.product-price{
  font-size:24px;
  margin-bottom:15px;
}

.inventory-message{
  color:#2e7d32;
  margin-bottom:20px;
}

.soldout{
  color:#c62828;
}

.variant-group{
  margin-bottom:20px;
}

.variant-values{
  display:flex;
  gap:10px;
  margin-top:10px;
}

.variant-pill{
  border:1px solid #ddd;
  padding:8px 14px;
}

.countdown-box{
  background:#ead9cf;
  padding:20px;
  margin:25px 0;
}

.countdown{
  display:flex;
  gap:20px;
}

.countdown strong{
  display:block;
  font-size:24px;
}

details{
  border-top:1px solid #ddd;
  padding:15px 0;
}

summary{
  cursor:pointer;
  font-weight:600;
}

.benefits{
  margin-top:25px;
}

.benefit-item{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:12px;
}

.benefit-item img{
  width:20px;
}

.purchase-wrapper{
  display:flex;
  gap:15px;
  margin-top:30px;
}

.qty-box{
  display:flex;
  border:1px solid #ddd;
}

.qty-box button{
  width:40px;
  border:none;
  background:#fff;
  cursor:pointer;
}

.qty-input{
  width:60px;
  text-align:center;
  border:none;
}

.add-to-cart{
  flex:1;
  background:#000;
  color:#fff;
  border:none;
  cursor:pointer;
  padding:15px;
}

@media(max-width:768px){

  .luxury-product__wrapper{
    grid-template-columns:1fr;
  }

  .gallery-card{
    min-height:auto;
    padding:20px;
  }

}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const timer =
    document.getElementById(
      'countdown-{{ section.id }}'
    );

  const targetDate =
    new Date(
      '{{ section.settings.countdown_date }}'
    ).getTime();

  function updateCountdown(){

    const now = new Date().getTime();
    const distance = targetDate - now;

    if(distance <= 0) return;

    timer.querySelector('.days').innerHTML =
      Math.floor(distance / (1000*60*60*24));

    timer.querySelector('.hours').innerHTML =
      Math.floor((distance % (1000*60*60*24)) / (1000*60*60));

    timer.querySelector('.minutes').innerHTML =
      Math.floor((distance % (1000*60*60)) / (1000*60));

    timer.querySelector('.seconds').innerHTML =
      Math.floor((distance % (1000*60)) / 1000);
  }

  updateCountdown();
  setInterval(updateCountdown,1000);

  document.querySelectorAll('.qty-plus').forEach(btn => {

    btn.addEventListener('click', () => {

      const input =
        btn.parentElement.querySelector('.qty-input');

      input.value =
        parseInt(input.value) + 1;

    });

  });

  document.querySelectorAll('.qty-minus').forEach(btn => {

    btn.addEventListener('click', () => {

      const input =
        btn.parentElement.querySelector('.qty-input');

      if(parseInt(input.value) > 1){

        input.value =
          parseInt(input.value) - 1;

      }

    });

  });

});
</script>

{% schema %}
{
  "name": "Luxury Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "countdown_heading",
      "label": "Countdown Heading",
      "default": "Offer Ends Soon"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown Date",
      "default": "2025-12-31"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Product Details"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Showcase"
    }
  ]
}
{% endschema %}