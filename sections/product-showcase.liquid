<section class="luxury-product">

  <div class="luxury-product__wrapper">

    <!-- LEFT COLUMN (SLIDER) -->
    {% if product.images.size > 0 %}

    <div class="luxury-slider">

      <div class="luxury-slider__track" id="slider-{{ section.id }}">

        {% for image in product.images %}
          <div class="luxury-slide">

            {{
              image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                class: 'gallery-image',
                alt: image.alt
            }}

          </div>
        {% endfor %}

      </div>

      <button class="slider-btn prev" type="button">&#10094;</button>
      <button class="slider-btn next" type="button">&#10095;</button>

    </div>

    {% endif %}

    <!-- RIGHT COLUMN -->
    <div class="luxury-product__content">

      {% if section.settings.badge_text != blank %}
        <span class="product-badge">{{ section.settings.badge_text }}</span>
      {% endif %}

      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price">{{ product.price | money }}</div>

      <div class="inventory-message">
        {% if product.available %}In Stock{% else %}Sold Out{% endif %}
      </div>

      <!-- VARIANTS -->
      {% unless product.has_only_default_variant %}

        {% for option in product.options_with_values %}

          {% if option.values.size > 0 %}

            <div class="variant-group">

              <label>{{ option.name }}</label>

              <div class="variant-values">

                {% for value in option.values %}
                  {% if value != blank %}
                    <span class="variant-pill">{{ value }}</span>
                  {% endif %}
                {% endfor %}

              </div>

            </div>

          {% endif %}

        {% endfor %}

      {% endunless %}

      <!-- COUNTDOWN -->
      {% if section.settings.countdown_date != blank %}

      <div class="countdown-box">

        <div class="countdown-heading">
          {{ section.settings.countdown_heading }}
        </div>

        <div class="countdown" id="countdown-{{ section.id }}">

          <div><strong class="days">00</strong><span>Days</span></div>
          <div><strong class="hours">00</strong><span>Hours</span></div>
          <div><strong class="minutes">00</strong><span>Minutes</span></div>
          <div><strong class="seconds">00</strong><span>Seconds</span></div>

        </div>

      </div>

      {% endif %}

      <!-- ACCORDION -->
      <div class="accordion-wrapper">

        {% if product.description != blank %}
        <details open>
          <summary>Description</summary>
          <div class="accordion-content">
            {{ product.description | truncatewords: 34, '' }}
          </div>
        </details>
        {% endif %}

        {% if section.settings.details != blank %}
        <details>
          <summary>Product Details</summary>
          <div class="accordion-content">
            {{ section.settings.details }}
          </div>
        </details>
        {% endif %}

      </div>

      <!-- BENEFITS -->
      {% assign has_benefits = false %}
      {% for block in section.blocks %}
        {% if block.settings.text != blank or block.settings.icon != blank %}
          {% assign has_benefits = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_benefits %}

      <div class="benefits">

        {% for block in section.blocks %}

          {% if block.settings.text != blank or block.settings.icon != blank %}

            <div class="benefit-item" {{ block.shopify_attributes }}>

              {% if block.settings.icon %}
                {{
                  block.settings.icon
                  | image_url: width: 60
                  | image_tag
                }}
              {% endif %}

              {% if block.settings.text != blank %}
                <span>{{ block.settings.text }}</span>
              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>

      {% endif %}

      <!-- ADD TO CART -->
      {% form 'product', product %}

        <input type="hidden" name="id"
          value="{{ product.selected_or_first_available_variant.id }}">

        <div class="purchase-wrapper">

          <div class="qty-box">
            <button type="button" class="qty-minus">-</button>
            <input type="number" value="1" min="1"
              name="quantity" class="qty-input">
            <button type="button" class="qty-plus">+</button>
          </div>

          <button type="submit" class="add-to-cart">
            Add To Cart · {{ product.price | money }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>

</section>

<style>
.luxury-product{
  background:#fff;
  padding:60px 20px;
  color:#000; /* ✅ FIX: default text black */
}

.luxury-product *{
  color:#000; /* ✅ ensures all inherited text is visible */
}

/* WRAPPER */
.luxury-product__wrapper{
  max-width:1400px;
  margin:auto;
  display:grid;
  grid-template-columns:60% 40%;
  gap:50px;
}

/* SLIDER */
.luxury-slider{
  position:relative;
  overflow:hidden;
  background:#fff;
}

.luxury-slider__track{
  display:flex;
  transition:transform .5s ease;
}

.luxury-slide{
  min-width:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  padding:40px;
}

.gallery-image{
  width:100%;
  max-height:700px;
  object-fit:contain;
  background:#fff;
}

/* ARROWS */
.slider-btn{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:40px;
  height:40px;
  border:1px solid #ddd;
  background:#fff;
  cursor:pointer;
  z-index:10;
}

.slider-btn.prev{left:10px;}
.slider-btn.next{right:10px;}

/* CONTENT */
.product-badge{
  background:#4f4035;
  color:#fff !important; /* keep badge readable */
  padding:6px 12px;
  font-size:12px;
  display:inline-block;
  margin-bottom:15px;
}

.product-title{
  font-size:34px;
  margin:0 0 10px;
}

.product-price{
  font-size:24px;
  margin-bottom:15px;
}

/* INVENTORY */
.inventory-message{
  margin-bottom:20px;
}

/* VARIANTS */
.variant-group{
  margin-bottom:20px;
}

.variant-values{
  display:flex;
  gap:10px;
  margin-top:10px;
}

.variant-pill{
  border:1px solid #ddd;
  padding:8px 14px;
}

/* COUNTDOWN */
.countdown-box{
  background:#ead9cf;
  padding:20px;
  margin:25px 0;
}

.countdown{
  display:flex;
  gap:20px;
}

.countdown strong{
  font-size:24px;
  display:block;
}

/* ACCORDION */
details{
  border-top:1px solid #ddd;
  padding:15px 0;
}

summary{
  cursor:pointer;
  font-weight:600;
}

/* BENEFITS */
.benefits{
  margin-top:25px;
}

.benefit-item{
  display:flex;
  gap:10px;
  align-items:center;
  margin-bottom:12px;
}

.benefit-item img{
  width:20px;
}

/* ADD TO CART */
.purchase-wrapper{
  display:flex;
  gap:15px;
  margin-top:30px;
}

.qty-box{
  display:flex;
  border:1px solid #ddd;
}

.qty-box button{
  width:40px;
  border:none;
  background:#fff;
}

.qty-input{
  width:60px;
  text-align:center;
  border:none;
}

.add-to-cart{
  flex:1;
  background:#000;
  color:#fff !important;
  border:none;
  padding:15px;
  cursor:pointer;
}

/* MOBILE */
@media(max-width:768px){
  .luxury-product__wrapper{
    grid-template-columns:1fr;
  }

  .luxury-slide{
    padding:20px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

  /* SLIDER */
  const track = document.getElementById("slider-{{ section.id }}");

  if(track){

    let index = 0;
    const slides = track.children.length;

    const update = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
    };

    document.querySelector(".luxury-slider .next")?.addEventListener("click", () => {
      index = (index + 1) % slides;
      update();
    });

    document.querySelector(".luxury-slider .prev")?.addEventListener("click", () => {
      index = (index - 1 + slides) % slides;
      update();
    });

    /* SWIPE */
    let startX = 0;

    track.addEventListener("touchstart", e => {
      startX = e.touches[0].clientX;
    });

    track.addEventListener("touchend", e => {
      let endX = e.changedTouches[0].clientX;

      if(startX > endX + 50) index = (index + 1) % slides;
      if(startX < endX - 50) index = (index - 1 + slides) % slides;

      update();
    });

  }

  /* QTY */
  document.querySelectorAll('.qty-plus').forEach(btn=>{
    btn.addEventListener('click',()=>{
      btn.parentElement.querySelector('.qty-input').value++;
    });
  });

  document.querySelectorAll('.qty-minus').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const input = btn.parentElement.querySelector('.qty-input');
      if(input.value > 1) input.value--;
    });
  });

  /* COUNTDOWN */
  const timer = document.getElementById('countdown-{{ section.id }}');

  if(timer){

    const target = new Date('{{ section.settings.countdown_date }}').getTime();

    function tick(){
      const now = new Date().getTime();
      const diff = target - now;

      if(diff <= 0) return;

      timer.querySelector('.days').innerHTML = Math.floor(diff/86400000);
      timer.querySelector('.hours').innerHTML = Math.floor((diff%86400000)/3600000);
      timer.querySelector('.minutes').innerHTML = Math.floor((diff%3600000)/60000);
      timer.querySelector('.seconds').innerHTML = Math.floor((diff%60000)/1000);
    }

    tick();
    setInterval(tick,1000);

  }

});
</script>

{% schema %}
{
  "name": "Luxury Product Showcase",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text" },
    { "type": "text", "id": "countdown_heading", "label": "Countdown Heading" },
    { "type": "text", "id": "countdown_date", "label": "Countdown Date" },
    { "type": "richtext", "id": "details", "label": "Product Details" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "Luxury Product Showcase" }
  ]
}
{% endschema %}