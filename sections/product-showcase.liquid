{{ 'product-showcase.css' | asset_url | stylesheet_tag }}

{% assign product = section.settings.product %}

{% if product %}
<section class="product-showcase">

  <div class="product-showcase__wrapper">

    <!-- LEFT SIDE -->
    <div class="product-showcase__gallery">

      {% for image in product.images %}
        <div class="gallery-card">
          <img
            src="{{ image | image_url: width: 1400 }}"
            alt="{{ image.alt | escape }}"
            class="gallery-image"
            loading="lazy"
          >
        </div>
      {% endfor %}

    </div>

    <!-- RIGHT SIDE -->
    <div class="product-showcase__content">

      {% if section.settings.preorder_text != blank %}
        <span class="badge">
          {{ section.settings.preorder_text }}
        </span>
      {% endif %}

      <h1 class="product-title">
        {{ product.title }}
      </h1>

      <div class="product-price">
        {{ product.price | money }}
      </div>

      {% if product.inventory_quantity < 10 and product.inventory_quantity > 0 %}
        <div class="inventory-warning">
          Hurry! Low inventory
        </div>
      {% endif %}

      <!-- COLOR SWATCHES -->

      {% assign color_option = nil %}

      {% for option in product.options_with_values %}
        {% if option.name contains 'Color'
          or option.name contains 'Colour'
        %}
          {% assign color_option = option %}
        {% endif %}
      {% endfor %}

      {% if color_option %}
        <div class="variant-colors">

          <label>Color</label>

          <div class="swatches">

            {% for value in color_option.values %}
              <span
                class="swatch"
                title="{{ value }}"
                style="background-color: {{ value | downcase }};"
              ></span>
            {% endfor %}

          </div>

        </div>
      {% endif %}

      <!-- COUNTDOWN -->

      <div class="countdown-box">

        <div class="countdown-heading">
          {{ section.settings.countdown_heading }}
        </div>

        <div class="countdown" id="countdown-{{ section.id }}">
          <div>
            <strong class="days">00</strong>
            <span>Days</span>
          </div>

          <div>
            <strong class="hours">00</strong>
            <span>Hours</span>
          </div>

          <div>
            <strong class="minutes">00</strong>
            <span>Minutes</span>
          </div>

          <div>
            <strong class="seconds">00</strong>
            <span>Seconds</span>
          </div>
        </div>

      </div>

      <!-- ACCORDIONS -->

      <div class="accordion">

        <details>
          <summary>Description</summary>

          <div class="accordion-content">
            {{ product.description }}
          </div>
        </details>

        <details>
          <summary>Details</summary>

          <div class="accordion-content">
            {{ section.settings.details }}
          </div>
        </details>

      </div>

      <!-- BENEFITS -->

      <div class="benefits">

        {% for block in section.blocks %}
          <div class="benefit" {{ block.shopify_attributes }}>

            {% if block.settings.icon %}
              <img
                src="{{ block.settings.icon | image_url: width: 50 }}"
                alt=""
              >
            {% endif %}

            <span>{{ block.settings.text }}</span>

          </div>
        {% endfor %}

      </div>

      <!-- PRODUCT FORM -->

      {% form 'product', product %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
        >

        <div class="purchase-row">

          <div class="qty-selector">

            <button
              type="button"
              class="qty-minus"
            >
              −
            </button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              class="qty-input"
            >

            <button
              type="button"
              class="qty-plus"
            >
              +
            </button>

          </div>

          <button
            type="submit"
            class="add-to-cart"
          >
            {{ section.settings.button_text }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>

</section>
<style>
    .product-showcase{
  padding:60px 20px;
}

.product-showcase__wrapper{
  max-width:1400px;
  margin:auto;
  display:grid;
  grid-template-columns:60% 40%;
  gap:50px;
}

.product-showcase__gallery{
  display:flex;
  flex-direction:column;
  gap:20px;
}

.gallery-card{
  background:#fff;
  padding:40px;
}

.gallery-image{
  width:100%;
  display:block;
  object-fit:contain;
}

.product-showcase__content{
  padding:20px;
}

.badge{
  display:inline-block;
  background:#4f4035;
  color:#fff;
  padding:6px 12px;
  font-size:12px;
  margin-bottom:15px;
}

.product-title{
  font-size:32px;
  margin:0 0 10px;
}

.product-price{
  font-size:22px;
  margin-bottom:15px;
}

.inventory-warning{
  color:#c8903b;
  margin-bottom:25px;
}

.variant-colors{
  margin-bottom:25px;
}

.swatches{
  display:flex;
  gap:10px;
  margin-top:10px;
}

.swatch{
  width:28px;
  height:28px;
  border-radius:50%;
  border:1px solid #ddd;
}

.countdown-box{
  background:#ead9cf;
  padding:20px;
  margin-bottom:25px;
}

.countdown{
  display:flex;
  gap:20px;
}

.countdown strong{
  display:block;
  font-size:22px;
}

details{
  border-top:1px solid #ddd;
  padding:15px 0;
}

summary{
  cursor:pointer;
  font-weight:600;
}

.benefits{
  margin-top:25px;
}

.benefit{
  display:flex;
  gap:12px;
  align-items:center;
  margin-bottom:12px;
}

.benefit img{
  width:20px;
}

.purchase-row{
  display:flex;
  gap:15px;
  margin-top:30px;
}

.qty-selector{
  display:flex;
  border:1px solid #ddd;
}

.qty-selector button{
  width:40px;
  border:none;
  background:#fff;
  cursor:pointer;
}

.qty-input{
  width:50px;
  text-align:center;
  border:none;
}

.add-to-cart{
  flex:1;
  background:#000;
  color:#fff;
  border:none;
  padding:15px;
  cursor:pointer;
}

@media(max-width:768px){

  .product-showcase__wrapper{
    grid-template-columns:1fr;
  }

  .gallery-card{
    padding:20px;
  }
}
</style>
<script>
document.addEventListener("DOMContentLoaded", function(){

  const sectionId = "{{ section.id }}";

  const countdown =
    document.getElementById(
      "countdown-" + sectionId
    );

  if(countdown){

    const targetDate =
      new Date(
        "{{ section.settings.countdown_date }}"
      ).getTime();

    function updateTimer(){

      const now = new Date().getTime();
      const distance = targetDate - now;

      if(distance < 0) return;

      countdown.querySelector(".days").innerHTML =
        Math.floor(distance / (1000 * 60 * 60 * 24));

      countdown.querySelector(".hours").innerHTML =
        Math.floor(
          (distance % (1000 * 60 * 60 * 24))
          / (1000 * 60 * 60)
        );

      countdown.querySelector(".minutes").innerHTML =
        Math.floor(
          (distance % (1000 * 60 * 60))
          / (1000 * 60)
        );

      countdown.querySelector(".seconds").innerHTML =
        Math.floor(
          (distance % (1000 * 60))
          / 1000
        );
    }

    updateTimer();
    setInterval(updateTimer,1000);
  }

  document.querySelectorAll(".qty-plus")
  .forEach(btn => {

    btn.addEventListener("click", function(){

      const input =
        this.parentNode.querySelector(
          ".qty-input"
        );

      input.value =
        parseInt(input.value) + 1;

    });

  });

  document.querySelectorAll(".qty-minus")
  .forEach(btn => {

    btn.addEventListener("click", function(){

      const input =
        this.parentNode.querySelector(
          ".qty-input"
        );

      if(parseInt(input.value) > 1){

        input.value =
          parseInt(input.value) - 1;

      }

    });

  });

});
</script>

{% endif %}

{% schema %}
{
  "name": "Luxury Product Showcase",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "preorder_text",
      "label": "Badge",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "countdown_heading",
      "label": "Countdown Heading",
      "default": "Our seasonal sale ends soon"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown Date",
      "default": "2025-12-31"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Details"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "PRE-ORDER"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Showcase"
    }
  ]
}
{% endschema %}